<% content_for :title, t("corporate_action_imports.edit.Page title", application: t("caramelo")) %>

<section class="mx-auto max-w-3xl space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("corporate_action_imports.index.Eyebrow") %></p>
      <h1 class="ui-page-title"><%= t("corporate_action_imports.edit.Heading") %></h1>
      <p class="ui-page-intro"><%= t("corporate_action_imports.edit.Introduction") %></p>
    </div>
    <%= link_to t("actions.Cancel"), corporate_action_imports_path, class: "ui-button ui-button-secondary" %>
  </div>

  <div class="rounded-2xl border border-coffee/10 bg-paper p-5 shadow-sm sm:p-6">
    <p class="text-sm text-muted"><%= @import.source %> · <%= @import.source_reference %></p>
    <%
      provider_candidate = @import.normalized_candidate
      provider_kind = provider_candidate["kind"].presence || t("Not available")
      provider_event_on_value = provider_candidate["event_on"].presence
      provider_event_on = provider_event_on_value || t("Not available")
      provider_ratio = [ provider_candidate["ratio_numerator"], provider_candidate["ratio_denominator"] ].compact.join(":").presence || t("Not available")
      provider_amount = provider_candidate["amount_per_share"].presence || t("Not available")
      review_kind = @import.conflict? ? provider_candidate["kind"].presence || @import.kind : @import.kind
      review_event_on = @import.conflict? ? provider_candidate["event_on"].presence || @import.event_on : @import.event_on
      review_ratio_numerator = @import.conflict? ? provider_candidate["ratio_numerator"].presence || @import.ratio_numerator : @import.ratio_numerator
      review_ratio_denominator = @import.conflict? ? provider_candidate["ratio_denominator"].presence || @import.ratio_denominator : @import.ratio_denominator
      review_cash_action = review_kind.to_s.in?(%w[dividend jcp])
      review_quantity_action = review_kind.to_s.in?(%w[split reverse_split share_bonus])
      review_currency = @import.review_currency
      currency_subunit = review_currency ? Money::Currency.find(review_currency).subunit_to_unit : 100
      suggested_payment_date = @import.suggested_payment_date
      payment_date_suggested = @import.paid_on.blank? && suggested_payment_date.present?
      estimated_gross_amount_cents = @import.estimated_gross_amount_cents
      gross_amount_cents = @import.gross_amount_cents || estimated_gross_amount_cents
      gross_amount_value = gross_amount_cents && (gross_amount_cents.to_d / currency_subunit).to_s("F")
      kind_options = if review_cash_action
        %w[dividend jcp]
      elsif review_quantity_action
        %w[split reverse_split share_bonus]
      else
        CorporateActionImport.kinds.keys
      end
      kind_options -= [ "jcp" ] unless @import.instrument&.currency_brl?
    %>
    <% if @import.conflict? %>
      <aside class="mt-6 rounded-2xl border border-caramel/40 bg-caramel/10 p-4 text-sm text-coffee" role="alert" aria-labelledby="corporate-action-import-conflict-heading">
        <h2 id="corporate-action-import-conflict-heading" class="font-semibold"><%= t("corporate_action_imports.edit.Conflict heading") %></h2>
        <p class="mt-2 leading-6"><%= t("corporate_action_imports.edit.Conflict introduction") %></p>
        <dl class="mt-4 grid gap-3 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-muted"><%= t("corporate_action_imports.edit.Current value") %> · <%= t("corporate_action_imports.edit.Event type") %></dt>
            <dd class="mt-1"><%= @import.kind.to_s.humanize %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-muted"><%= t("corporate_action_imports.edit.Provider value") %> · <%= t("corporate_action_imports.edit.Provider event type") %></dt>
            <dd class="mt-1"><%= provider_kind.to_s.humanize %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-muted"><%= t("corporate_action_imports.edit.Current value") %> · <%= t("corporate_action_imports.edit.Effective date") %></dt>
            <dd class="mt-1"><%= @import.event_on || t("Not available") %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-muted"><%= t("corporate_action_imports.edit.Provider value") %> · <%= t("corporate_action_imports.edit.Provider event date") %></dt>
            <dd class="mt-1"><%= provider_event_on %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-muted"><%= t("corporate_action_imports.edit.Provider value") %> · <%= t("corporate_action_imports.edit.Provider ratio") %></dt>
            <dd class="mt-1"><%= provider_ratio %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-muted"><%= t("corporate_action_imports.edit.Provider value") %> · <%= t("corporate_action_imports.edit.Provider amount per share") %></dt>
            <dd class="mt-1"><%= provider_amount %></dd>
          </div>
        </dl>
        <details class="mt-4">
          <summary class="cursor-pointer font-semibold"><%= t("corporate_action_imports.edit.Provider payload") %></summary>
          <pre class="mt-3 max-h-64 overflow-auto rounded-xl bg-paper/70 p-3 text-xs"><%= JSON.pretty_generate(@import.raw_payload_hash) %></pre>
        </details>
      </aside>
    <% end %>
    <%= form_with model: @import, url: corporate_action_import_path(@import), method: :patch, class: "mt-6 space-y-6" do |form| %>
      <% if flash[:alert] %><div class="ui-form-errors" role="alert"><%= flash[:alert] %></div><% end %>
      <% if @import.conflict? %>
        <label class="flex items-start gap-3 rounded-xl border border-coffee/10 bg-oat-2/60 p-4 text-sm leading-6 text-coffee">
          <%= form.check_box :accept_provider_update, required: true, class: "mt-1 h-5 w-5 rounded border-coffee/30 text-caramel focus:ring-caramel" %>
          <span><%= t("corporate_action_imports.edit.Acknowledge provider update") %></span>
        </label>
      <% end %>
      <div>
        <%= form.label :kind, t("corporate_action_imports.edit.Event type"), class: "block text-sm font-semibold text-coffee" %>
        <%= form.select :kind, kind_options.map { |kind| [t("corporate_actions.kinds.#{kind}"), kind] }, { selected: review_kind }, class: "ui-field" %>
      </div>
      <% if @institutions.size > 1 || @import.warning_list.include?("multiple_institutions") %>
        <div>
          <%= form.label :institution_id, t("corporate_action_imports.edit.Institution"), class: "block text-sm font-semibold text-coffee" %>
          <%= form.select :institution_id, options_from_collection_for_select(@institutions, :id, :name, @import.institution_id), { include_blank: t("corporate_action_imports.edit.Select institution") }, class: "ui-field", required: true %>
          <p class="mt-2 text-sm leading-6 text-muted"><%= t("corporate_action_imports.edit.Institution help") %></p>
        </div>
      <% elsif @import.institution %>
        <%= form.hidden_field :institution_id, value: @import.institution_id %>
      <% end %>
      <% if review_cash_action %>
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :paid_on, t("corporate_action_imports.edit.Payment date"), class: "block text-sm font-semibold text-coffee" %>
            <%= form.date_field :paid_on, value: suggested_payment_date, class: "ui-field", required: true, aria: { describedby: ("corporate-action-import-payment-date-help" if payment_date_suggested) } %>
            <% if payment_date_suggested %><p id="corporate-action-import-payment-date-help" class="mt-2 text-sm leading-6 text-muted"><%= t("corporate_action_imports.edit.Payment date help") %></p><% end %>
          </div>
          <div><%= form.label :ex_date, t("corporate_action_imports.edit.Ex-date"), class: "block text-sm font-semibold text-coffee" %><%= form.date_field :ex_date, value: (@import.conflict? ? provider_event_on_value || @import.ex_date : @import.ex_date), class: "ui-field" %></div>
          <div>
            <%= form.label :gross_amount, t("corporate_action_imports.edit.Gross amount"), class: "block text-sm font-semibold text-coffee" %>
            <%= form.text_field :gross_amount, value: gross_amount_value, inputmode: "decimal", class: "ui-field", required: true, aria: { describedby: ("corporate-action-import-gross-amount-help" if estimated_gross_amount_cents) } %>
            <% if estimated_gross_amount_cents %><p id="corporate-action-import-gross-amount-help" class="mt-2 text-sm leading-6 text-muted"><%= t("corporate_action_imports.edit.Gross amount estimate help") %></p><% end %>
          </div>
          <div><%= form.label :withholding_tax, t("corporate_action_imports.edit.Withholding tax"), class: "block text-sm font-semibold text-coffee" %><%= form.text_field :withholding_tax, value: @import.withholding_tax_cents && (@import.withholding_tax_cents.to_d / currency_subunit), inputmode: "decimal", class: "ui-field" %></div>
        </div>
        <p class="text-sm leading-6 text-muted"><%= t("corporate_action_imports.edit.Amount help", currency: review_currency || t("Not available")) %></p>
      <% else %>
        <div class="grid gap-6 sm:grid-cols-3">
          <div><%= form.label :effective_on, t("corporate_action_imports.edit.Effective date"), class: "block text-sm font-semibold text-coffee" %><%= form.date_field :effective_on, value: review_event_on, class: "ui-field", required: true %></div>
          <div><%= form.label :ratio_numerator, t("corporate_action_imports.edit.New units"), class: "block text-sm font-semibold text-coffee" %><%= form.number_field :ratio_numerator, value: review_ratio_numerator, class: "ui-field", min: 1, step: 1, required: true %></div>
          <div><%= form.label :ratio_denominator, t("corporate_action_imports.edit.Old units"), class: "block text-sm font-semibold text-coffee" %><%= form.number_field :ratio_denominator, value: review_ratio_denominator, class: "ui-field", min: 1, step: 1, required: true %></div>
        </div>
      <% end %>
      <div class="flex flex-wrap gap-3"><%= form.button t("corporate_action_imports.actions.Save review"), class: "ui-button ui-button-primary" %><%= link_to t("actions.Cancel"), corporate_action_imports_path, class: "ui-button ui-button-secondary" %></div>
    <% end %>
  </div>
</section>
