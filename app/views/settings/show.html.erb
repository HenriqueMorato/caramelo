<% content_for :title, t(".Page title", application: t("caramelo")) %>

<section class="mx-auto max-w-2xl space-y-8">
  <div class="ui-page-header-copy">
    <p class="ui-eyebrow"><%= t("Portfolio") %></p>
    <h1 class="ui-page-title"><%= t("Settings") %></h1>
    <p class="ui-page-intro"><%= t(".Introduction") %></p>
  </div>

  <section class="ui-card p-6 sm:p-8" aria-labelledby="appearance-heading">
    <div class="mb-5">
      <h2 id="appearance-heading" class="text-lg font-semibold text-coffee"><%= t("appearance.Appearance") %></h2>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t("appearance.Description") %></p>
    </div>
    <%= render "layouts/appearance_options" %>
  </section>

  <section class="ui-card p-6 sm:p-8" aria-labelledby="navigation-heading">
    <div class="mb-5">
      <h2 id="navigation-heading" class="text-lg font-semibold text-coffee"><%= t(".Navigation heading") %></h2>
      <p id="navigation-help" class="mt-2 text-sm leading-6 text-muted"><%= t(".Navigation help") %></p>
    </div>
    <div
      data-controller="navigation-preference"
      data-navigation-preference-storage-key-value="caramelo.navigation.collapsed"
    >
      <fieldset class="grid gap-3 sm:grid-cols-2" aria-describedby="navigation-help">
        <legend class="sr-only"><%= t(".Navigation state") %></legend>
        <label class="flex min-h-16 cursor-pointer items-center gap-3 rounded-xl border border-coffee/15 bg-oat px-4 py-3 transition-colors hover:border-caramel/60 focus-within:ring-2 focus-within:ring-caramel">
          <%= radio_button_tag "navigation_default", "open", true,
            id: "navigation-default-open", class: "peer sr-only",
            data: { navigation_preference_target: "option", action: "change->navigation-preference#change" } %>
          <span class="flex size-5 shrink-0 items-center justify-center rounded-full border border-coffee/25 bg-oat-2 peer-checked:border-caramel peer-checked:bg-caramel/15" aria-hidden="true"></span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-coffee"><%= t(".Navigation open") %></span>
            <span class="mt-1 block text-xs leading-5 text-muted"><%= t(".Navigation open help") %></span>
          </span>
        </label>
        <label class="flex min-h-16 cursor-pointer items-center gap-3 rounded-xl border border-coffee/15 bg-oat px-4 py-3 transition-colors hover:border-caramel/60 focus-within:ring-2 focus-within:ring-caramel">
          <%= radio_button_tag "navigation_default", "collapsed", false,
            id: "navigation-default-collapsed", class: "peer sr-only",
            data: { navigation_preference_target: "option", action: "change->navigation-preference#change" } %>
          <span class="flex size-5 shrink-0 items-center justify-center rounded-full border border-coffee/25 bg-oat-2 peer-checked:border-caramel peer-checked:bg-caramel/15" aria-hidden="true"></span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-coffee"><%= t(".Navigation collapsed") %></span>
            <span class="mt-1 block text-xs leading-5 text-muted"><%= t(".Navigation collapsed help") %></span>
          </span>
        </label>
      </fieldset>
    </div>
  </section>

  <div class="rounded-2xl border border-coffee/10 bg-oat-2 p-6 shadow-sm sm:p-8">
    <%= form_with model: @owner, url: settings_path, method: :patch, class: "space-y-6",
      data: { controller: "settings-form", settings_form_discard_value: t(".Discard changes"),
        settings_form_original_currency_value: @owner.reporting_currency_in_database,
        action: "turbo:submit-start->settings-form#submit turbo:submit-end->settings-form#submitted turbo:before-visit@window->settings-form#confirmNavigation beforeunload@window->settings-form#beforeUnload" } do |form| %>
      <div data-controller="currency-picker" data-action="click@window->currency-picker#outside">
        <%= form.label :reporting_currency, class: "block text-sm font-semibold text-coffee",
          data: { currency_picker_target: "label" } %>
        <p id="reporting-currency-help" class="mt-2 text-sm leading-6 text-muted"><%= t(".Currency help") %></p>
        <%= form.select :reporting_currency, reporting_currency_options, {},
          class: "mt-3 block min-h-11 w-full rounded-xl border border-coffee/20 bg-oat px-4 py-3 text-base text-coffee focus-visible:ring-2 focus-visible:ring-caramel",
          aria: { describedby: "reporting-currency-help reporting-currency-error", invalid: @owner.errors.any? },
          data: { settings_form_target: "currency", currency_picker_target: "select" },
          autofocus: @owner.errors.any? %>
        <%= render "currency_picker", owner: @owner %>
        <p id="reporting-currency-error" class="mt-2 text-sm text-guava" role="alert">
          <%= @owner.errors.full_messages_for(:reporting_currency).to_sentence %>
        </p>
      </div>

      <p class="text-sm leading-6 text-muted"><%= t(".Preparation help") %></p>
      <%= form.button class: "ui-button ui-button-primary min-h-11 group", type: :submit do %>
        <span class="hidden size-4 animate-spin rounded-full border-2 border-current border-r-transparent motion-reduce:animate-none group-disabled:inline-block" aria-hidden="true"></span>
        <%= t(".Save preferences") %>
      <% end %>
    <% end %>
  </div>
</section>
