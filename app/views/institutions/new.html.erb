<% content_for :title, "New institution · #{t("application.name")}" %>

<section class="mx-auto max-w-2xl space-y-8">
  <div class="space-y-3">
    <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700">Trade settings</p>
    <h1 class="text-4xl font-bold tracking-tight text-slate-950">Add institution</h1>
    <p class="text-lg leading-8 text-slate-600">Add a bank, broker, or custodian to use with future trades.</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "form", institution: @institution %>
  </div>
</section>
