    <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700"><%= t("Trade settings") %></p>
    <h1 class="text-4xl font-bold tracking-tight text-slate-950"><%= t("actions.Add", model: Institution.model_name.human.downcase) %></h1>
