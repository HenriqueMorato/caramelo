<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-3xl space-y-3">
      <p class="ui-eyebrow"><%= t("Trade settings") %></p>
      <h1 class="ui-page-title"><%= t("Institutions") %></h1>
      <p class="ui-page-intro"><%= t(".Introduction") %></p>
    </div>

    <%= link_to t("actions.Add", model: Institution.model_name.human.downcase), new_institution_path, class: "ui-button ui-button-primary w-fit" %>
  </div>

  <% if @institutions.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @institutions.each do |institution| %>
        <article class="ui-card ui-card-interactive p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-slate-950"><%= link_to institution.name, institution, class: "hover:text-emerald-700" %></h2>
              <% if institution.notes.present? %>
                <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600"><%= institution.notes %></p>
              <% end %>
            </div>

            <% if institution.active? %>
              <span class="ui-badge bg-emerald-100 text-emerald-800"><%= t("statuses.Active") %></span>
            <% else %>
              <span class="ui-badge bg-slate-100 text-slate-600"><%= t("statuses.Inactive") %></span>
            <% end %>
          </div>

          <%= link_to t("actions.View details"), institution, class: "mt-5 inline-flex text-sm font-semibold text-emerald-700 hover:text-emerald-900" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="ui-empty-state">
      <p class="font-medium text-slate-900"><%= t(".No institutions yet") %></p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= t(".Empty state") %></p>
    </div>
  <% end %>
</section>
