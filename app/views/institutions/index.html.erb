<% content_for :title, t(".Page title", application: t("caramelo")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Trade settings") %></p>
      <h1 class="ui-page-title"><%= t("Institutions") %></h1>
      <p class="ui-page-intro"><%= t(".Introduction") %></p>
    </div>

    <%= link_to t("actions.Add", model: Institution.model_name.human.downcase), new_institution_path, class: "ui-button ui-button-primary w-fit" %>
  </div>

  <% if @institutions.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @institutions.each do |institution| %>
        <article class="ui-card ui-card-interactive p-6">
          <div class="flex min-w-0 items-start justify-between gap-4">
            <div class="min-w-0">
              <h2 class="truncate text-lg font-semibold text-coffee"><%= link_to institution.name, institution, class: "hover:text-caramel-deep" %></h2>
              <% if institution.notes.present? %>
                <p class="mt-2 line-clamp-2 text-sm leading-6 text-muted"><%= institution.notes %></p>
              <% end %>
            </div>

            <% if institution.active? %>
              <span class="ui-badge ui-badge-active"><%= t("statuses.Active") %></span>
            <% else %>
              <span class="ui-badge ui-badge-inactive"><%= t("statuses.Inactive") %></span>
            <% end %>
          </div>

          <%= link_to t("actions.View details"), institution, class: "mt-5 inline-flex text-sm font-semibold text-caramel-deep hover:text-coffee" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="ui-empty-state">
      <p class="font-medium text-coffee"><%= t(".No institutions yet") %></p>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty state") %></p>
    </div>
  <% end %>
</section>
