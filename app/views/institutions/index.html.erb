<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700"><%= t("Trade settings") %></p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl"><%= t("Institutions") %></h1>
      <p class="text-lg leading-8 text-slate-600"><%= t(".Introduction") %></p>
    </div>

    <%= link_to t("actions.Add", model: Institution.model_name.human.downcase), new_institution_path, class: "inline-flex w-fit items-center rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
  </div>

  <% if @institutions.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @institutions.each do |institution| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-slate-950"><%= link_to institution.name, institution, class: "hover:text-emerald-700" %></h2>
              <% if institution.notes.present? %>
                <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600"><%= institution.notes %></p>
              <% end %>
            </div>

            <% if institution.active? %>
              <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800"><%= t("statuses.Active") %></span>
            <% else %>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600"><%= t("statuses.Inactive") %></span>
            <% end %>
          </div>

          <%= link_to t("actions.View details"), institution, class: "mt-5 inline-flex text-sm font-semibold text-emerald-700 hover:text-emerald-900" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="font-medium text-slate-900"><%= t(".No institutions yet") %></p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= t(".Empty state") %></p>
    </div>
  <% end %>
</section>
