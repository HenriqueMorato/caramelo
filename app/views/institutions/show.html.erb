<% content_for :title, t(".Page title", institution: @institution.name, application: t("LocalFolio")) %>

<section class="mx-auto max-w-3xl space-y-8">
  <div>
    <%= link_to t("All institutions"), institutions_path, class: "text-sm font-semibold text-caramel-deep hover:text-coffee" %>
  </div>

  <div class="rounded-2xl border border-coffee/10 bg-oat-2 p-6 shadow-sm sm:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-caramel-deep"><%= Institution.model_name.human %></p>
        <h1 class="text-4xl font-bold tracking-tight text-coffee"><%= @institution.name %></h1>
      </div>

      <% if @institution.active? %>
        <span class="ui-badge ui-badge-active w-fit"><%= t("statuses.Active") %></span>
      <% else %>
        <span class="ui-badge ui-badge-inactive w-fit"><%= t("statuses.Inactive") %></span>
      <% end %>
    </div>

    <div class="mt-8 border-t border-coffee/10 pt-6">
      <h2 class="text-sm font-semibold text-coffee"><%= Institution.human_attribute_name(:notes) %></h2>
      <% if @institution.notes.present? %>
        <p class="mt-2 whitespace-pre-wrap leading-7 text-muted"><%= @institution.notes %></p>
      <% else %>
        <p class="mt-2 text-muted"><%= t(".No notes added") %></p>
      <% end %>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= link_to t("actions.Edit model", model: Institution.model_name.human.downcase), edit_institution_path(@institution), class: "ui-button ui-button-primary" %>
    <%= button_to t("actions.Delete"), @institution, method: :delete, class: "ui-button ui-button-danger", data: { turbo_confirm: t("confirmations.Delete record", record: @institution.name) } %>
  </div>
</section>
