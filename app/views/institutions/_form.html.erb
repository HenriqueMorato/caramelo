<%# locals: (institution:) %>

<%= form_with(model: institution, class: "space-y-6") do |form| %>
  <% if institution.errors.any? %>
    <div class="ui-form-errors" role="alert">
      <p class="font-semibold"><%= t("forms.Could not save", count: institution.errors.count, model: Institution.model_name.human.downcase) %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% institution.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-semibold text-coffee" %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "organization", class: [ "ui-field", { "ui-field-invalid": institution.errors[:name].any? } ] %>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-semibold text-coffee" %>
    <p class="mt-1 text-sm text-muted"><%= t(".Notes help") %></p>
    <%= form.text_area :notes, rows: 5, class: [ "ui-field", { "ui-field-invalid": institution.errors[:notes].any? } ] %>
  </div>

  <div class="flex items-start gap-3 rounded-xl border border-coffee/10 bg-oat p-4">
    <%= form.check_box :active, class: "mt-0.5 size-5 rounded border-coffee/20 text-caramel-deep focus:ring-caramel" %>
    <div>
      <%= form.label :active, class: "block text-sm font-semibold text-coffee" %>
      <p class="mt-1 text-sm leading-6 text-muted"><%= t(".Inactive institutions") %></p>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit class: "ui-button ui-button-primary cursor-pointer" %>
    <%= link_to t("actions.Cancel"), institution.persisted? ? institution_path(institution) : institutions_path, class: "ui-button ui-button-secondary" %>
  </div>
<% end %>
