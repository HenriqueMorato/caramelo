<%# locals: (institution:) %>

<%= form_with(model: institution, class: "space-y-6") do |form| %>
  <% if institution.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-900" role="alert">
      <p class="font-semibold"><%= t("forms.Could not save", count: institution.errors.count, model: Institution.model_name.human.downcase) %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% institution.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-semibold text-slate-900" %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "organization", class: [ "mt-2 block w-full rounded-xl border bg-white px-4 py-3 text-slate-950 shadow-sm focus:outline-none focus:ring-2", { "border-slate-300 focus:border-emerald-600 focus:ring-emerald-200": institution.errors[:name].none?, "border-red-400 focus:border-red-600 focus:ring-red-200": institution.errors[:name].any? } ] %>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-semibold text-slate-900" %>
    <p class="mt-1 text-sm text-slate-500"><%= t(".Notes help") %></p>
    <%= form.text_area :notes, rows: 5, class: [ "mt-2 block w-full rounded-xl border bg-white px-4 py-3 text-slate-950 shadow-sm focus:outline-none focus:ring-2", { "border-slate-300 focus:border-emerald-600 focus:ring-emerald-200": institution.errors[:notes].none?, "border-red-400 focus:border-red-600 focus:ring-red-200": institution.errors[:notes].any? } ] %>
  </div>

  <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
    <%= form.check_box :active, class: "mt-0.5 size-5 rounded border-slate-300 text-emerald-700 focus:ring-emerald-600" %>
    <div>
      <%= form.label :active, class: "block text-sm font-semibold text-slate-900" %>
      <p class="mt-1 text-sm leading-6 text-slate-600"><%= t(".Inactive institutions") %></p>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit class: "cursor-pointer rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
    <%= link_to t("actions.Cancel"), institution.persisted? ? institution_path(institution) : institutions_path, class: "rounded-xl px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
  </div>
<% end %>
