<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Market data") %></p>
      <h1 class="ui-page-title"><%= t(".Heading") %></h1>
      <p class="ui-page-intro"><%= t(".Intro") %></p>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-3">
      <p class="text-sm text-muted"><%= t(".Checked at", time: l(@report.checked_at, format: :short)) %></p>
      <% refresh_title = @market_price_refresh_available ? nil : t(".Refresh throttled") %>
      <span class="group relative inline-flex">
        <%= button_to t("Refresh prices"), current_market_price_refresh_path, disabled: !@market_price_refresh_available, class: "ui-button ui-button-primary disabled:cursor-not-allowed disabled:opacity-50", form_class: "inline-flex", aria: { describedby: ("refresh-throttle-tooltip" if refresh_title) }, data: { turbo_submits_with: t("Refreshing") } %>
        <% if refresh_title %>
          <span id="refresh-throttle-tooltip" role="tooltip" class="pointer-events-none absolute right-0 top-full z-10 mt-2 w-72 rounded-lg bg-coffee px-3 py-2 text-left text-xs leading-5 text-oat opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"><%= refresh_title %></span>
        <% end %>
      </span>
    </div>
  </div>

  <nav class="flex flex-wrap items-center gap-3" aria-label="<%= t(".Filter label") %>">
    <span class="text-sm font-semibold text-muted"><%= t(".Filter label") %></span>
    <div class="inline-flex max-w-full overflow-x-auto rounded-md bg-white/50 p-1" role="group">
      <% [["all", t(".Filter all")], ["attention", t(".Filter attention")], ["healthy", t(".Filter healthy")]].each do |value, label| %>
        <%= link_to label, market_data_health_path(status: value),
          class: [
            "grouping-option",
            ("rounded-md border border-caramel-deep bg-caramel-deep text-white" if @status_filter == value)
          ].compact.join(" "),
          aria: { current: (@status_filter == value ? "page" : nil) } %>
      <% end %>
    </div>
  </nav>

  <div class="rounded-2xl border border-coffee/10 bg-oat-2 p-6 shadow-sm" role="status">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <p class="font-semibold <%= @report.healthy? ? "text-leaf" : "text-coffee" %>">
        <%= @health.healthy? ? t(".Healthy") : t(".Issues found", count: @health.issue_count) %>
      </p>
      <p class="text-sm text-muted"><%= t(".Entry count", count: @entries.size) %></p>
    </div>
    <p class="mt-2 text-sm text-muted"><%= @report.healthy? ? t(".Healthy explanation") : t(".Recovery explanation") %></p>

    <div class="mt-5 overflow-x-auto">
      <table class="w-full text-left" aria-label="<%= t(".Issue list") %>">
        <thead class="border-b border-coffee/10 text-xs font-semibold uppercase tracking-wide text-muted">
          <tr>
            <th scope="col" class="pb-3 pr-4"><%= t(".Source") %></th>
            <th scope="col" class="pb-3 pr-4"><%= t(".Status") %></th>
            <th scope="col" class="pb-3 pr-4"><%= t(".Details") %></th>
            <th scope="col" class="pb-3 text-right"><span class="sr-only"><%= t(".Actions") %></span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-coffee/10">
      <% @entries.each do |entry| %>
        <tr>
          <th scope="row" class="max-w-[12rem] break-words py-4 pr-4 align-top font-semibold text-coffee"><%= entry.label %></th>
          <td class="whitespace-nowrap py-4 pr-4 align-top text-xs font-semibold uppercase tracking-wide <%= @health.status_class(entry) %>">
            <span aria-hidden="true"><%= @health.status_icon(entry) %></span>
            <span><%= @health.status_label(entry) %></span>
          </td>
          <td class="break-words py-4 pr-4 align-top text-sm text-muted"><%= entry.description %></td>
          <td class="whitespace-nowrap py-4 align-top text-right">
            <div class="flex justify-end gap-2">
              <% if entry.actionable? %>
                <% range_params = entry.missing_range ? { from: entry.missing_range.begin.iso8601, to: entry.missing_range.end.iso8601 } : {} %>
                <%= button_to t(".Retry"), market_data_recoveries_path,
              params: { target: {
                kind: entry.target.kind,
                record_id: entry.target.record_id,
                base_currency: entry.target.base_currency,
                quote_currency: entry.target.quote_currency,
                provider: entry.target.provider
                }.merge(range_params) }, class: "ui-button ui-button-secondary shrink-0", form_class: "shrink-0" %>
              <% end %>
              <% if entry.quote_reset_needed? && (preview = @health.reset_preview_for(entry)) %>
                <details class="relative">
                  <summary class="ui-button ui-button-secondary cursor-pointer list-none"><%= t(".Reset quote") %></summary>
                  <div class="absolute right-0 z-10 mt-2 w-72 rounded-lg border border-coffee/10 bg-oat p-3 text-left shadow-lg">
                    <p class="text-sm font-semibold text-coffee"><%= t(".Reset quote preview heading") %></p>
                    <p class="mt-1 text-xs leading-5 text-muted"><%= t(".Reset quote preview copy", from: l(preview.range.begin, format: :short), to: l(preview.range.end, format: :short)) %></p>
                    <p class="mt-2 text-xs text-muted"><%= t(".Reset quote preview expires", time: l(preview.expires_at, format: :short)) %></p>
                    <%= button_to t(".Confirm reset quote"), market_data_recovery_path(entry.target.record_id), method: :delete,
                  params: { target: {
                    kind: entry.target.kind,
                    record_id: entry.target.record_id,
                    provider: entry.target.provider
                      }, preview_token: preview.token }, class: "ui-button ui-button-primary mt-3 w-full", form_class: "w-full" %>
                  </div>
                </details>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= render "backups", backup: @backup %>
</section>
