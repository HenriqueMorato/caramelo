<%# locals: (ignored_count:) %>

<section id="corporate-action-import-review" aria-labelledby="corporate-action-import-review-title"
  class="rounded-2xl border border-caramel/25 bg-caramel/5 p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="ui-eyebrow"><%= t("market_data_health.import_review.Eyebrow") %></p>
      <h2 id="corporate-action-import-review-title" class="mt-1 text-lg font-semibold text-coffee"><%= t("market_data_health.import_review.Heading") %></h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-muted"><%= t("market_data_health.import_review.Intro", count: ignored_count) %></p>
    </div>
    <%= link_to t("market_data_health.import_review.Review ignored"), corporate_action_imports_path(status: "ignored"), class: "ui-button ui-button-secondary shrink-0" %>
