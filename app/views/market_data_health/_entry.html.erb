<%# locals: (entry:, health:) %>

<tr id="<%= entry.dom_id %>">
  <th scope="row" class="max-w-[12rem] break-words py-4 pr-4 align-top font-semibold text-coffee"><%= entry.label %></th>
  <td class="whitespace-nowrap py-4 pr-4 align-top text-xs font-semibold uppercase tracking-wide <%= health.status_class(entry) %>">
    <span><%= health.status_label(entry) %></span>
  </td>
  <td class="break-words py-4 pr-4 align-top text-sm text-muted"><%= entry.description %></td>
  <td class="whitespace-nowrap py-4 align-top text-right">
    <div class="flex justify-end gap-2">
      <% if entry.actionable? %>
        <% range_params = entry.missing_range ? { from: entry.missing_range.begin.iso8601, to: entry.missing_range.end.iso8601 } : {} %>
        <%= button_to t("market_data_health.show.Retry"), market_data_recoveries_path,
          params: { target: {
            kind: entry.target.kind,
            record_id: entry.target.record_id,
            base_currency: entry.target.base_currency,
            quote_currency: entry.target.quote_currency,
            provider: entry.target.provider
          }.merge(range_params) }, class: "ui-button ui-button-secondary shrink-0", form_class: "shrink-0" %>
      <% end %>
      <% if entry.quote_reset_needed? && (preview = health.reset_preview_for(entry)) %>
        <details class="relative">
          <summary class="ui-button ui-button-secondary cursor-pointer list-none"><%= t("market_data_health.show.Reset quote") %></summary>
          <div class="absolute right-0 z-10 mt-2 w-72 rounded-lg border border-coffee/10 bg-oat p-3 text-left shadow-lg">
            <p class="text-sm font-semibold text-coffee"><%= t("market_data_health.show.Reset quote preview heading") %></p>
            <p class="mt-1 text-xs leading-5 text-muted"><%= t("market_data_health.show.Reset quote preview copy", from: l(preview.range.begin, format: :short), to: l(preview.range.end, format: :short)) %></p>
            <p class="mt-2 text-xs text-muted"><%= t("market_data_health.show.Reset quote preview expires", time: l(preview.expires_at, format: :short)) %></p>
            <%= button_to t("market_data_health.show.Confirm reset quote"), market_data_recovery_path(entry.target.record_id), method: :delete,
              params: { target: {
                kind: entry.target.kind,
                record_id: entry.target.record_id,
                provider: entry.target.provider
              }, preview_token: preview.token }, class: "ui-button ui-button-primary mt-3 w-full", form_class: "w-full" %>
          </div>
        </details>
      <% end %>
    </div>
  </td>
</tr>
