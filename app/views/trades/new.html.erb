<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="mx-auto max-w-3xl space-y-8">
  <div>
    <%= link_to t("Back"), @context_instrument || transactions_path, class: "text-sm font-semibold text-caramel-deep hover:text-coffee" %>
  </div>

  <div class="ui-page-header-copy">
    <p class="ui-eyebrow"><%= t("Portfolio activity") %></p>
    <h1 class="ui-page-title"><%= t("actions.Add", model: Trade.model_name.human.downcase) %></h1>
    <p class="ui-page-intro"><%= t(".Introduction") %></p>
  </div>

  <div class="rounded-2xl border border-coffee/10 bg-oat-2 p-6 shadow-sm sm:p-8">
    <%= render "form",
               trade: @trade,
               context_instrument: @context_instrument,
               instruments: @instruments,
               institutions: @institutions,
               last_institution_id_by_instrument: @last_institution_id_by_instrument %>
  </div>
</section>
