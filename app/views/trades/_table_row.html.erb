<%# locals: (trade:) %>

<tr id="<%= dom_id(trade) %>" class="align-middle">
  <td class="max-w-64 px-4 py-3">
    <div class="flex min-w-0 items-center gap-3">
      <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-caramel/15 font-mono text-[0.625rem] font-semibold text-caramel-deep" aria-hidden="true">
        <%= trade.instrument.ticker.first(4) %>
      </span>
      <span class="min-w-0">
        <%= link_to trade.instrument.name, trade.instrument, class: "block truncate font-semibold text-coffee hover:text-caramel-deep" %>
        <span class="block truncate text-xs text-muted">
          <%= [ trade.instrument.ticker, trade.instrument.exchange, trade.currency, trade.institution&.name ].compact.join(" · ") %>
        </span>
        <% if trade.notes.present? %>
          <span class="block truncate text-xs text-muted"><%= trade.notes %></span>
        <% end %>
      </span>
    </div>
  </td>
  <td class="whitespace-nowrap px-4 py-3 text-muted"><%= l trade.traded_on, format: :long %></td>
  <td class="px-4 py-3 text-center">
    <span class="<%= class_names("ui-badge uppercase tracking-wide", "ui-badge-buy": trade.buy?, "ui-badge-sell": trade.sell?) %>">
      <%= trade.buy? ? t("Buy") : t("Sell") %>
    </span>
  </td>
  <td class="whitespace-nowrap px-4 py-3 text-center font-mono tabular-nums text-coffee"><%= format_quantity trade.quantity %></td>
  <td class="whitespace-nowrap px-4 py-3 text-center font-mono tabular-nums text-coffee">
    <%= format_unit_price trade %>
  </td>
  <td class="whitespace-nowrap px-4 py-3 text-center font-mono tabular-nums text-muted"><%= trade.fees.format %></td>
  <td class="whitespace-nowrap px-4 py-3 text-center font-mono font-semibold tabular-nums text-coffee"><%= trade.total.format %></td>
  <td class="px-4 py-3">
    <div class="flex items-center justify-end gap-1">
      <%= link_to t("actions.Edit"), edit_trade_path(trade), class: "flex min-h-11 items-center rounded-lg px-2 text-xs font-semibold text-caramel-deep hover:bg-caramel/10 hover:text-coffee sm:min-h-8" %>
      <%= button_to t("actions.Delete"), trade_path(trade), method: :delete, class: "min-h-11 rounded-lg px-2 text-xs font-semibold text-guava hover:bg-danger-surface hover:text-danger-text sm:min-h-8", data: { turbo_confirm: t("confirmations.Delete trade") } %>
    </div>
  </td>
</tr>
