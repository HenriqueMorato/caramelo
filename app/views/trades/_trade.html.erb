<article id="<%= dom_id(trade) %>" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <span class="<%= class_names("rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide", "bg-emerald-100 text-emerald-800": trade.buy?, "bg-red-100 text-red-800": trade.sell?) %>"><%= trade.side %></span>
        <span class="text-sm text-slate-500"><%= l trade.traded_on, format: :long %></span>
      </div>

      <h2 class="font-mono text-xl font-bold text-slate-950">
        <%= link_to "#{trade.instrument.ticker} · #{trade.instrument.exchange}", trade.instrument, class: "hover:text-emerald-700" %>
      </h2>
      <p class="text-sm text-slate-600"><%= trade.instrument.name %></p>
    </div>

    <div class="shrink-0 text-right">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total</p>
      <p class="mt-1 font-mono text-lg font-semibold text-slate-950"><%= trade.total.format %></p>
      <p class="mt-1 text-xs text-slate-500"><%= format_quantity trade.quantity %> × <%= format_unit_price trade %></p>
      <div class="mt-3 flex items-center justify-end gap-1">
        <%= link_to "Edit", edit_trade_path(trade), class: "rounded-lg px-2 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-50 hover:text-emerald-900" %>
        <%= button_to "Delete", trade_path(trade), method: :delete, class: "rounded-lg px-2 py-1 text-xs font-semibold text-red-700 hover:bg-red-50 hover:text-red-900", data: { turbo_confirm: "Delete this trade?" } %>
      </div>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 border-t border-slate-100 pt-4 text-sm text-slate-600">
    <span>Fees: <%= trade.fees.format %></span>
    <span>Currency: <%= trade.currency %></span>
    <span>Institution: <%= trade.institution&.name || "None" %></span>
  </div>

  <% if trade.notes.present? %>
    <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-slate-600"><%= trade.notes %></p>
  <% end %>

</article>
