<% content_for :title, "Edit trade · #{t("application.name")}" %>

<section class="mx-auto max-w-3xl space-y-8">
  <div>
    <%= link_to "← Transactions", transactions_path, class: "text-sm font-semibold text-emerald-700 hover:text-emerald-900" %>
  </div>

  <div class="space-y-3">
    <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700">Portfolio activity</p>
    <h1 class="text-4xl font-bold tracking-tight text-slate-950">Edit trade</h1>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "form", trade: @trade %>
  </div>
</section>
