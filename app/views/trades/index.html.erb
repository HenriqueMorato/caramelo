<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Portfolio activity") %></p>
      <h1 class="ui-page-title"><%= t(".Heading") %></h1>
      <p class="ui-page-intro"><%= t(".Introduction") %></p>
    </div>

    <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_trade_path, class: "ui-button ui-button-primary w-fit" %>
  </div>

  <% if @has_trades %>
    <div>
      <nav class="flex rounded-t-xl border border-coffee/10 bg-paper px-4 py-3" aria-label="<%= t(".Trade filters") %>">
        <div class="inline-flex rounded-md bg-paper/50 p-1">
          <% [ [ t(".All trades"), nil ], [ t(".Buys only"), "buy" ], [ t(".Sells only"), "sell" ] ].each do |label, side| %>
            <%= link_to label,
                        transactions_path(side:),
                        class: "trade-filter-option",
                        aria: { current: ("page" if @side == side) } %>
          <% end %>
        </div>
      </nav>

      <div class="overflow-x-auto rounded-b-xl border border-t-0 border-coffee/10 bg-oat-2">
        <table class="ui-data-table min-w-[58rem] table-fixed text-sm">
          <colgroup>
            <col class="w-[25%]">
            <col class="w-[14%]">
            <col class="w-[9%]">
            <col class="w-[9%]">
            <col class="w-[13%]">
            <col class="w-[9%]">
            <col class="w-[11%]">
            <col class="w-[10%]">
          </colgroup>
          <thead>
            <tr class="text-xs uppercase tracking-[0.08em] text-muted">
              <th scope="col" class="px-4 py-3 font-semibold"><%= t(".Trade") %></th>
              <th scope="col" class="px-4 py-3 font-semibold"><%= Trade.human_attribute_name(:traded_on) %></th>
              <th scope="col" class="px-4 py-3 text-center font-semibold"><%= Trade.human_attribute_name(:side) %></th>
              <th scope="col" class="px-4 py-3 text-center font-semibold"><%= Trade.human_attribute_name(:quantity) %></th>
              <th scope="col" class="px-4 py-3 text-center font-semibold"><%= Trade.human_attribute_name(:unit_price) %></th>
              <th scope="col" class="px-4 py-3 text-center font-semibold"><%= Trade.human_attribute_name(:fees) %></th>
              <th scope="col" class="px-4 py-3 text-center font-semibold"><%= t("Total") %></th>
              <th scope="col" class="px-4 py-3"><span class="sr-only"><%= t(".Actions") %></span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-coffee/10">
            <% if @trades.any? %>
              <%= render partial: "table_row", collection: @trades, as: :trade %>
            <% else %>
              <tr>
                <td colspan="8" class="px-4 py-8 text-center text-sm text-muted"><%= t(".No matching trades") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-coffee/20 bg-oat-2 p-8 text-center">
      <p class="font-medium text-coffee"><%= t(".No trades yet") %></p>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty state") %></p>
    </div>
  <% end %>
</section>
