<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wider text-caramel-deep"><%= t("Portfolio activity") %></p>
      <h1 class="text-4xl font-bold tracking-tight text-coffee sm:text-5xl"><%= t("Transactions") %></h1>
      <p class="text-lg leading-8 text-muted"><%= t(".Introduction") %></p>
    </div>

    <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_trade_path, class: "inline-flex w-fit items-center rounded-xl bg-caramel-deep px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-coffee" %>
  </div>

  <% if @trades.any? %>
    <div class="space-y-4">
      <%= render @trades %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-coffee/20 bg-oat-2 p-8 text-center">
      <p class="font-medium text-coffee"><%= t(".No trades yet") %></p>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty state") %></p>
    </div>
  <% end %>
</section>
