<%# locals: (trade:, context_instrument:, instruments:, institutions:, last_institution_id_by_instrument:, return_to: nil) %>

<%= form_with model: trade,
              url: trade.persisted? ? trade_path(trade) : (context_instrument ? instrument_trades_path(context_instrument) : trades_path),
              class: "space-y-6",
              data: {
                controller: "trade-form",
                trade_form_reporting_currency_value: trade.user.reporting_currency
              } do |form| %>
  <%= hidden_field_tag :return_to, return_to if return_to.present? %>

  <% if trade.errors.any? %>
    <div class="ui-form-errors" role="alert">
      <p class="font-semibold"><%= t("forms.Could not save", count: trade.errors.count, model: Trade.model_name.human.downcase) %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% trade.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="text-sm text-muted"><span class="font-semibold text-guava">*</span> <%= t("forms.Required fields") %></p>

  <% if context_instrument %>
    <%= form.hidden_field :instrument_id, value: context_instrument.id %>
    <div class="rounded-xl border border-coffee/10 bg-oat p-4">
      <p class="text-sm font-semibold text-coffee"><%= t("forms.Required attribute", attribute: Trade.human_attribute_name(:instrument)) %></p>
      <p class="mt-1 font-mono text-lg font-bold"><%= context_instrument.ticker %> · <%= context_instrument.exchange %></p>
      <p class="mt-1 text-sm text-muted"><%= context_instrument.name %></p>
    </div>
  <% else %>
    <div>
      <%= form.label :instrument_id, t("forms.Required attribute", attribute: Trade.human_attribute_name(:instrument)), class: "block text-sm font-semibold text-coffee" %>
      <% instrument_options = instruments.map { |instrument| [ "#{instrument.ticker} · #{instrument.exchange} — #{instrument.name}", instrument.id, { data: { currency: instrument.currency, subunit: Money::Currency.find(instrument.currency).subunit_to_unit, last_institution_id: last_institution_id_by_instrument[instrument.id] } } ] } %>
      <%= form.select :instrument_id,
                      options_for_select(instrument_options, trade.instrument_id),
                      { include_blank: t("forms.Select an instrument") },
                      required: true,
                      autofocus: true,
                      class: [ "ui-field", { "ui-field-invalid": trade.errors[:instrument].any? } ],
                      data: { trade_form_target: "instrument", action: "change->trade-form#syncCurrency" } %>
    </div>
  <% end %>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :side, t("forms.Required attribute", attribute: Trade.human_attribute_name(:side)), class: "block text-sm font-semibold text-coffee" %>
      <%= form.select :side, [ [ t("Buy"), "buy" ], [ t("Sell"), "sell" ] ], {}, required: true, class: "mt-2 block w-full rounded-xl border border-coffee/20 bg-oat-2 px-4 py-3 text-coffee shadow-sm focus:border-caramel focus:outline-none focus:ring-2 focus:ring-caramel/20" %>
    </div>

    <div>
      <%= form.label :traded_on, t("forms.Required attribute", attribute: Trade.human_attribute_name(:traded_on)), class: "block text-sm font-semibold text-coffee" %>
      <%= form.date_field :traded_on, required: true, class: "mt-2 block w-full rounded-xl border border-coffee/20 bg-oat-2 px-4 py-3 text-coffee shadow-sm focus:border-caramel focus:outline-none focus:ring-2 focus:ring-caramel/20" %>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :quantity, t("forms.Required attribute", attribute: Trade.human_attribute_name(:quantity)), class: "block text-sm font-semibold text-coffee" %>
      <%= form.number_field :quantity, required: true, min: 0, step: "any", inputmode: "decimal", class: "mt-2 block w-full rounded-xl border border-coffee/20 bg-oat-2 px-4 py-3 text-coffee shadow-sm focus:border-caramel focus:outline-none focus:ring-2 focus:ring-caramel/20" %>
    </div>

    <div>
      <%= form.label :currency, class: "block text-sm font-semibold text-coffee" %>
      <%= form.text_field :currency, disabled: true, value: trade.currency || context_instrument&.currency, class: "mt-2 block w-full rounded-xl border border-coffee/10 bg-coffee/5 px-4 py-3 font-mono text-coffee/80", data: { trade_form_target: "currency" } %>
      <p class="mt-1 text-xs text-muted"><%= t(".Derived currency") %></p>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <% currency = trade.currency || context_instrument&.currency %>
    <% money_step = currency ? 1.0 / Money::Currency.find(currency).subunit_to_unit : 0.01 %>
    <div>
      <%= form.label :unit_price, t("forms.Required attribute", attribute: Trade.human_attribute_name(:unit_price)), class: "block text-sm font-semibold text-coffee" %>
      <%= form.number_field :unit_price, value: trade.unit_price && format_unit_price_input(trade.unit_price), required: true, min: 0, step: "0.00000001", placeholder: "0.00", inputmode: "decimal", class: "mt-2 block w-full rounded-xl border border-coffee/20 bg-oat-2 px-4 py-3 text-coffee shadow-sm focus:border-caramel focus:outline-none focus:ring-2 focus:ring-caramel/20" %>
    </div>

    <div>
      <%= form.label :fees, Trade.human_attribute_name(:fees), class: "block text-sm font-semibold text-coffee" %>
      <%= form.number_field :fees, value: trade.fees&.to_d, min: 0, step: money_step, inputmode: "decimal", class: "mt-2 block w-full rounded-xl border border-coffee/20 bg-oat-2 px-4 py-3 text-coffee shadow-sm focus:border-caramel focus:outline-none focus:ring-2 focus:ring-caramel/20", data: { trade_form_target: "fees" } %>
    </div>
  </div>

  <% settlement_hidden = currency.blank? || currency == trade.user.reporting_currency %>
  <%= tag.div data: { trade_form_target: "settlement" }, hidden: settlement_hidden do %>
    <%= form.label :settlement_exchange_rate,
                   t(".Settlement exchange rate optional"),
                   class: "block text-sm font-semibold text-coffee" %>
    <%= form.number_field :settlement_exchange_rate,
                          min: 0,
                          step: "0.000000000001",
                          inputmode: "decimal",
                          class: "mt-2 block w-full rounded-xl border border-coffee/20 bg-oat-2 px-4 py-3 text-base text-coffee shadow-sm focus:border-caramel focus:outline-none focus:ring-2 focus:ring-caramel/20",
                          data: { trade_form_target: "settlementRate" } %>
    <p class="mt-1 text-xs text-muted">
      <span data-trade-form-target="settlementDirection">1 <%= currency %> = … <%= trade.user.reporting_currency %></span>
      <span aria-hidden="true"> · </span>
      <%= t(".Settlement exchange rate help") %>
    </p>
  <% end %>

  <div>
    <%= form.label :institution_id, t(".Institution optional"), class: "block text-sm font-semibold text-coffee" %>
    <%= form.collection_select :institution_id, institutions, :id, :name, { include_blank: t("forms.No institution") }, class: "mt-2 block w-full rounded-xl border border-coffee/20 bg-oat-2 px-4 py-3 text-coffee shadow-sm focus:border-caramel focus:outline-none focus:ring-2 focus:ring-caramel/20", data: { trade_form_target: "institution" } %>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-semibold text-coffee" %>
    <%= form.text_area :notes, rows: 4, class: "mt-2 block w-full rounded-xl border border-coffee/20 bg-oat-2 px-4 py-3 text-coffee shadow-sm focus:border-caramel focus:outline-none focus:ring-2 focus:ring-caramel/20" %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit class: "ui-button ui-button-primary cursor-pointer" %>
    <%= link_to t("actions.Cancel"), return_to || context_instrument || transactions_path, class: "ui-button ui-button-secondary" %>
  </div>
<% end %>
