<%= form_with model: trade,
              url: trade.persisted? ? trade_path(trade) : (@context_instrument ? instrument_trades_path(@context_instrument) : trades_path),
              class: "space-y-6",
              data: { controller: "trade-form" } do |form| %>
  <% if trade.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-900" role="alert">
      <p class="font-semibold"><%= pluralize(trade.errors.count, "error") %> prevented this trade from being saved:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% trade.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="text-sm text-slate-500"><span class="font-semibold text-red-700">*</span> Required fields</p>

  <% if @context_instrument %>
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">Instrument *</p>
      <p class="mt-1 font-mono text-lg font-bold"><%= @context_instrument.ticker %> · <%= @context_instrument.exchange %></p>
      <p class="mt-1 text-sm text-slate-600"><%= @context_instrument.name %></p>
    </div>
  <% else %>
    <div>
      <%= form.label :instrument_id, "Instrument *", class: "block text-sm font-semibold text-slate-900" %>
      <% instrument_options = @instruments.map { |instrument| [ "#{instrument.ticker} · #{instrument.exchange} — #{instrument.name}", instrument.id, { data: { currency: instrument.currency, subunit: Money::Currency.find(instrument.currency).subunit_to_unit } } ] } %>
      <%= form.select :instrument_id,
                      options_for_select(instrument_options, trade.instrument_id),
                      { include_blank: "Select an instrument" },
                      required: true,
                      autofocus: true,
                      class: [ "mt-2 block w-full rounded-xl border bg-white px-4 py-3 text-slate-950 shadow-sm focus:outline-none focus:ring-2", { "border-slate-300 focus:border-emerald-600 focus:ring-emerald-200": trade.errors[:instrument].none?, "border-red-400 focus:border-red-600 focus:ring-red-200": trade.errors[:instrument].any? } ],
                      data: { trade_form_target: "instrument", action: "change->trade-form#syncCurrency" } %>
    </div>
  <% end %>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :side, "Side *", class: "block text-sm font-semibold text-slate-900" %>
      <%= form.select :side, Trade.sides.keys.map { |side| [ side.titleize, side ] }, {}, required: true, class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
    </div>

    <div>
      <%= form.label :traded_on, "Trade date *", class: "block text-sm font-semibold text-slate-900" %>
      <%= form.date_field :traded_on, required: true, class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :quantity, "Quantity *", class: "block text-sm font-semibold text-slate-900" %>
      <%= form.number_field :quantity, required: true, min: 0, step: "any", inputmode: "decimal", class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
    </div>

    <div>
      <%= form.label :currency, class: "block text-sm font-semibold text-slate-900" %>
      <%= form.text_field :currency, disabled: true, value: trade.currency || @context_instrument&.currency, class: "mt-2 block w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 font-mono text-slate-700", data: { trade_form_target: "currency" } %>
      <p class="mt-1 text-xs text-slate-500">Derived from the selected instrument.</p>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <% currency = trade.currency || @context_instrument&.currency %>
    <% money_step = currency ? 1.0 / Money::Currency.find(currency).subunit_to_unit : 0.01 %>
    <div>
      <%= form.label :unit_price, "Unit price *", class: "block text-sm font-semibold text-slate-900" %>
      <%= form.number_field :unit_price, value: trade.unit_price && format_unit_price_input(trade.unit_price), required: true, min: 0, step: "0.00000001", placeholder: "0.00", inputmode: "decimal", class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
    </div>

    <div>
      <%= form.label :fees, class: "block text-sm font-semibold text-slate-900" %>
      <%= form.number_field :fees, value: trade.fees&.to_d, min: 0, step: money_step, inputmode: "decimal", class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-200", data: { trade_form_target: "fees" } %>
    </div>
  </div>

  <div>
    <%= form.label :institution_id, "Institution (optional)", class: "block text-sm font-semibold text-slate-900" %>
    <%= form.collection_select :institution_id, @institutions, :id, :name, { include_blank: "No institution" }, class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-semibold text-slate-900" %>
    <%= form.text_area :notes, rows: 4, class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 shadow-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit class: "cursor-pointer rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
    <%= link_to "Cancel", @context_instrument || transactions_path, class: "rounded-xl px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
  </div>
<% end %>
