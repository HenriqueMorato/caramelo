<div class="mx-auto w-full max-w-lg">
  <% if alert = flash[:alert] %>
    <p class="ui-form-errors mb-5" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="mb-5 rounded-xl border border-leaf/30 bg-leaf/10 p-4 font-medium text-leaf" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="ui-page-title"><%= t(".Sign in") %></h1>

  <%= form_with url: session_url, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", spellcheck: false, placeholder: t(".Email placeholder"), value: params[:email_address], class: "ui-field" %>
    </div>

    <div class="my-5">
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: t(".Password placeholder"), maxlength: 72, class: "ui-field" %>
    </div>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= form.submit t(".Sign in"), class: "ui-button ui-button-primary min-h-11 w-full cursor-pointer sm:w-auto" %>
      </div>

      <div class="mt-4 text-sm text-muted sm:mt-0">
        <%= link_to t(".Forgot password?"), new_password_path, class: "text-caramel-deep underline hover:text-coffee hover:no-underline" %>
      </div>
    </div>
  <% end %>
</div>
