<%# locals: (dashboard:, series: nil, series_presenter: nil) %>

<section aria-labelledby="long-view-heading" class="space-y-5">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted"><%= t("dashboard.index.Portfolio activity") %></p>
      <h2 id="long-view-heading" class="mt-2 font-display text-2xl font-semibold tracking-tight text-coffee"><%= t("dashboard.index.The long view") %></h2>
    </div>
    <%= link_to t("dashboard.index.View performance"), performance_path, class: "text-sm font-bold text-caramel-deep hover:text-caramel" %>
  </div>

  <div class="grid gap-5 xl:grid-cols-[minmax(0,1.25fr)_minmax(18rem,0.75fr)]">
    <%= render "dashboard/performance_history", series:, series_presenter: %>
    <%= render "dashboard/portfolio_data", dashboard: dashboard %>
  </div>
</section>
