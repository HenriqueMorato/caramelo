<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="max-w-3xl space-y-3">
    <p class="ui-eyebrow"><%= t(".Single-user workspace") %></p>
    <h1 class="ui-page-title"><%= t("Dashboard") %></h1>
    <p class="ui-page-intro">
      <%= t(".Portfolio introduction") %>
    </p>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <article class="ui-card ui-card-interactive p-6">
      <h2 class="text-lg font-semibold text-slate-950"><%= t(".Portfolio overview") %></h2>
      <p class="mt-2 leading-7 text-slate-600">
        <%= t(".Portfolio overview description") %>
      </p>
    </article>

    <article class="ui-card ui-card-interactive p-6">
      <h2 class="text-lg font-semibold text-slate-950"><%= t(".Recent activity") %></h2>
      <p class="mt-2 leading-7 text-slate-600">
        <%= t(".Recent activity description") %>
      </p>
    </article>
  </div>
</section>
