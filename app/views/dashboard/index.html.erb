<% content_for :title, "Dashboard · #{t("application.name")}" %>

<section class="space-y-8">
  <div class="max-w-3xl space-y-3">
    <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700">Single-user workspace</p>
    <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Dashboard</h1>
    <p class="text-lg leading-8 text-slate-600">
      Your portfolio overview will live here, bringing holdings, balances, performance, and recent activity together.
    </p>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950">Portfolio overview</h2>
      <p class="mt-2 leading-7 text-slate-600">
        Holdings, balances, and BRL-denominated performance will appear here in a future milestone.
      </p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950">Recent activity</h2>
      <p class="mt-2 leading-7 text-slate-600">
        Your latest portfolio transactions will be summarized here after transaction tracking is implemented.
      </p>
    </article>
  </div>
</section>
