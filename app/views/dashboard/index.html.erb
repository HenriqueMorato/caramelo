<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-10">
  <header class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">
        <%= l Date.current, format: :long %>
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold leading-none tracking-tight text-coffee sm:text-5xl">
        <%= t(".Portfolio overview") %>
      </h1>
      <p class="mt-3 text-sm text-muted"><%= t(".Portfolio introduction") %></p>
    </div>
    <%= link_to t(".Add transaction"), new_trade_path, class: "ui-button bg-caramel text-oat shadow-sm hover:bg-caramel-deep focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel" %>
  </header>

  <% if @dashboard.market_value_available? %>
    <div class="grid gap-5 xl:grid-cols-[minmax(0,1.45fr)_minmax(19rem,0.8fr)]">
      <%= render "dashboard/hero", dashboard: @dashboard %>
      <%= render "dashboard/snapshot", dashboard: @dashboard %>
    </div>
  <% else %>
    <%= render "dashboard/portfolio_state", dashboard: @dashboard %>
  <% end %>

  <%= render "dashboard/long_view", dashboard: @dashboard if @dashboard.market_value_available? %>
</section>
