<%# locals: (dashboard:) %>

<article class="relative min-h-[20rem] overflow-hidden rounded-[1.75rem] bg-coffee p-7 text-oat shadow-[0_18px_50px_rgba(108,64,35,0.16)] sm:p-9">
  <div class="relative z-10 flex h-full flex-col">
    <div class="flex items-start justify-between gap-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-oat/60"><%= t("dashboard.index.Total portfolio value") %></p>
        <p class="mt-6 font-mono text-5xl font-semibold tracking-[-0.07em] tabular-nums sm:text-6xl"><%= dashboard.market_value.format %></p>
        <% day_change = dashboard.day_change %>
        <% if day_change %>
          <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold <%= day_change.negative? ? "text-guava" : "text-[#91c399]" %>">
            <span aria-hidden="true"><%= day_change.positive? ? "↑" : day_change.negative? ? "↓" : "→" %></span>
            <span><%= "+" if day_change.positive? %><%= day_change.format %></span>
            <span><%= "+" if dashboard.day_change_ratio&.positive? %><%= number_to_percentage(dashboard.day_change_ratio.to_f * 100, precision: 2) if dashboard.day_change_ratio %></span>
            <span class="font-normal text-oat/60"><%= t("dashboard.index.Today") %></span>
          </p>
        <% end %>
      </div>
      <span class="flex size-16 rotate-3 items-center justify-center rounded-[1.4rem] bg-caramel text-4xl shadow-[inset_0_-6px_0_rgba(59,28,16,0.18)]" aria-hidden="true">🐕</span>
    </div>

    <% if dashboard.last_market_data_at %>
      <div class="mt-auto flex flex-col gap-4 border-t border-oat/15 pt-5 sm:flex-row sm:items-end sm:justify-between sm:gap-6">
        <div>
          <p class="font-display text-lg leading-tight text-oat"><%= t("dashboard.index.A little green around the edges") %></p>
          <p class="mt-1 text-sm text-oat/60"><%= t("dashboard.index.That's a good sign") %></p>
        </div>
        <p class="flex items-center gap-2 text-xs font-semibold text-[#91c399]">
          <span class="size-2 rounded-full bg-[#91c399] shadow-[0_0_0_3px_rgba(86,128,93,0.14)]" aria-hidden="true"></span>
          <%= t("dashboard.index.Market data updated", time: time_ago_in_words(dashboard.last_market_data_at)) %>
        </p>
      </div>
    <% end %>
  </div>
</article>
