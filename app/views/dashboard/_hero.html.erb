<%# locals: (dashboard:) %>

<article class="relative min-h-[20rem] overflow-hidden rounded-[1.75rem] bg-hero p-7 text-hero-text shadow-[0_18px_50px_rgba(108,64,35,0.16)] sm:p-9">
  <div class="relative z-10 flex h-full flex-col">
    <div class="flex items-start justify-between gap-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-hero-text/60"><%= t("dashboard.index.Total portfolio value") %></p>
        <p class="mt-6 font-mono text-5xl font-semibold tracking-[-0.07em] tabular-nums sm:text-6xl"><%= display_money(dashboard.market_value) %></p>
        <% if dashboard.day_change %>
          <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold <%= dashboard.day_change_color_class %>">
            <span aria-hidden="true"><%= dashboard.day_change_arrow %></span>
            <span><%= display_money(dashboard.day_change_amount_label) %></span>
            <span><%= dashboard.day_change_ratio_label %></span>
            <span class="font-normal text-hero-text/60"><%= t("dashboard.index.Today") %></span>
          </p>
        <% end %>
      </div>
      <span class="flex size-16 rotate-3 items-center justify-center rounded-[1.4rem] bg-caramel text-4xl shadow-[inset_0_-6px_0_rgba(59,28,16,0.18)]" aria-hidden="true">🐕</span>
    </div>

    <div class="mt-auto border-t border-oat/15 pt-5">
      <p class="font-display text-lg leading-tight text-hero-text"><%= t("dashboard.index.A little green around the edges") %></p>
      <p class="mt-1 text-sm text-hero-text/60"><%= t("dashboard.index.That's a good sign") %></p>
    </div>
  </div>
</article>
