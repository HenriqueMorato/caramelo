<%# locals: (dashboard:) %>

<article class="rounded-[1.25rem] border border-coffee/10 bg-oat-2 p-6 sm:p-7" id="holdings">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted"><%= t("dashboard.index.Your little pack") %></p>
      <h3 class="mt-2 font-display text-2xl font-semibold tracking-tight text-coffee"><%= t("dashboard.index.Holdings") %></h3>
    </div>
    <%= link_to t("dashboard.index.View all holdings"), positions_path, class: "text-sm font-bold text-caramel-deep hover:text-caramel" %>
  </div>

  <% if dashboard.open_positions.any? %>
    <div class="mt-6 space-y-4">
      <% dashboard.top_positions.each do |position| %>
        <%= link_to position.instrument, class: "-mx-2 flex items-center gap-3 rounded-xl p-2 transition-colors hover:bg-caramel/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel" do %>
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-caramel/15 font-mono text-xs font-semibold text-caramel-deep" translate="no"><%= position.instrument.ticker.first(4) %></span>
          <span class="min-w-0 flex-1">
            <strong class="block truncate text-sm text-coffee" translate="no"><%= position.instrument.name %></strong>
            <span class="mt-1 block text-xs text-muted" translate="no"><%= position.instrument.ticker %> · <%= position.instrument.currency %></span>
          </span>
          <span class="shrink-0 text-right font-mono text-sm font-semibold tabular-nums"><%= position.valuation.market_value&.format || t("Not available") %></span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-5 text-sm text-muted"><%= t("dashboard.index.No open positions") %></p>
  <% end %>

  <div class="mt-7 border-t border-coffee/10 pt-5" id="activity">
    <div class="flex items-center justify-between gap-4">
      <h4 class="text-sm font-semibold text-coffee"><%= t("dashboard.index.Recent activity") %></h4>
      <%= link_to t("dashboard.index.View all trades"), transactions_path, class: "text-xs font-bold text-caramel-deep hover:text-caramel" %>
    </div>
    <% if dashboard.recent_trades.any? %>
      <div class="mt-2 divide-y divide-coffee/10">
        <% dashboard.recent_trades.each do |trade| %>
          <article id="<%= dom_id(trade) %>" class="flex items-center gap-3 py-3">
            <span class="size-2 shrink-0 rounded-full <%= dashboard.trade_side_color_class(trade) %>" aria-hidden="true"></span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-xs font-semibold text-coffee"><%= dashboard.trade_side_label(trade) %> · <span translate="no"><%= trade.instrument.ticker %></span></p>
              <p class="mt-1 text-[0.7rem] text-muted"><%= l trade.traded_on, format: :short %> · <%= format_quantity trade.quantity %> <%= t("units") %></p>
            </div>
            <span class="shrink-0 font-mono text-xs font-semibold tabular-nums"><%= trade.total.format %></span>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-xs text-muted"><%= t("dashboard.index.No recent activity") %></p>
    <% end %>
  </div>
</article>
