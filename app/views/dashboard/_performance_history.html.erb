<%# locals: (series:, series_presenter:) %>

<article class="flex h-full flex-col rounded-[1.25rem] border border-coffee/10 bg-oat-2 p-5 sm:p-6">
  <% if series&.displayable? %>
    <% currency = series.observations.find { |observation| observation.market_value&.currency }&.market_value&.currency&.iso_code || User.owner.reporting_currency %>
    <% chart_data = series_presenter.chart_data(
      benchmarks: [], currency:, include_money_values: !money_values_hidden?
    ) %>
  <% end %>

  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="ui-eyebrow"><%= t("Performance") %></p>
      <p class="mt-2 text-sm text-muted"><%= series_presenter&.date_range_label || t("dashboard.index.Performance history coming soon") %></p>
    </div>
    <%= link_to t("dashboard.index.View performance"), performance_path, class: "shrink-0 text-sm font-bold text-caramel-deep hover:text-caramel" %>
  </div>

  <% if series&.displayable? %>
    <div class="relative mt-5 flex min-h-[16rem] flex-1" data-controller="performance-chart" data-action="appearance:change@window->performance-chart#refreshTheme" data-performance-chart-default-mode-value="<%= money_values_hidden? ? "performance" : "value" %>" data-performance-chart-return-only-value="<%= money_values_hidden? %>" data-performance-chart-data-value="<%= json_escape(chart_data.to_json) %>">
      <div class="relative min-h-0 flex-1">
        <canvas data-performance-chart-target="canvas" role="img" aria-label="<%= t("dashboard.index.Performance chart description") %>"></canvas>
      </div>
    </div>
  <% else %>
    <div class="mt-5 flex min-h-48 items-center justify-center rounded-xl border border-dashed border-coffee/15 bg-oat px-6 text-center text-sm text-muted">
      <%= t("dashboard.index.Performance history coming soon") %>
    </div>
  <% end %>
</article>
