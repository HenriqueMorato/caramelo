<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-3xl space-y-3">
      <p class="ui-eyebrow"><%= t("Portfolio catalog") %></p>
      <h1 class="ui-page-title"><%= t("Instruments") %></h1>
      <p class="ui-page-intro"><%= t(".Introduction") %></p>
    </div>

    <%= link_to t("actions.Add", model: Instrument.model_name.human.downcase), new_instrument_path, class: "ui-button ui-button-primary w-fit" %>
  </div>

  <% if @instruments.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @instruments.each do |instrument| %>
        <article class="ui-card ui-card-interactive p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="font-mono text-xl font-bold text-slate-950"><%= link_to instrument.ticker, instrument, class: "hover:text-emerald-700" %></h2>
              <p class="mt-2 text-sm leading-6 text-slate-600"><%= instrument.name %></p>
            </div>

            <span class="rounded-full bg-slate-100 px-3 py-1 font-mono text-xs font-semibold text-slate-700"><%= instrument.exchange %> · <%= instrument.currency %></span>
          </div>

          <%= link_to t("actions.View details"), instrument, class: "mt-5 inline-flex text-sm font-semibold text-emerald-700 hover:text-emerald-900" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="ui-empty-state">
      <p class="font-medium text-slate-900"><%= t(".No instruments yet") %></p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= t(".Empty state") %></p>
    </div>
  <% end %>
</section>
