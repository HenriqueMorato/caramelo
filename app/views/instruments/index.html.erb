<% content_for :title, t(".Page title", application: t("caramelo")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Portfolio catalog") %></p>
      <h1 class="ui-page-title"><%= t("Instruments") %></h1>
      <p class="ui-page-intro"><%= t(".Introduction") %></p>
    </div>

    <%= link_to t("actions.Add", model: Instrument.model_name.human.downcase), new_instrument_path, class: "ui-button ui-button-primary w-fit" %>
  </div>

  <% if @instruments.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @instruments.each do |instrument| %>
        <article id="<%= dom_id(instrument) %>" class="ui-card ui-card-interactive flex h-full flex-col p-6">
          <div class="flex flex-1 items-start justify-between gap-4">
            <div>
              <h2 class="font-mono text-xl font-bold text-coffee"><%= link_to instrument.ticker, instrument, class: "hover:text-caramel-deep" %></h2>
              <p class="mt-2 text-sm leading-6 text-muted"><%= instrument.name %></p>
            </div>

            <span class="rounded-full bg-coffee/5 px-3 py-1 font-mono text-xs font-semibold text-coffee/80"><%= instrument.exchange %> · <%= instrument.currency %></span>
          </div>

          <div class="mt-4 border-t border-coffee/10 pt-1">
            <%= render "actions",
              instrument:,
              delete_blocked: @traded_instrument_ids.include?(instrument.id),
              include_view: true %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="ui-empty-state">
      <p class="font-medium text-coffee"><%= t(".No instruments yet") %></p>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty state") %></p>
    </div>
  <% end %>
</section>
