<% content_for :title, "Instruments · #{t("application.name")}" %>

<section class="space-y-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700">Portfolio catalog</p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Instruments</h1>
      <p class="text-lg leading-8 text-slate-600">Manage the stocks, funds, and other instruments used by your trades.</p>
    </div>

    <%= link_to "Add instrument", new_instrument_path, class: "inline-flex w-fit items-center rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
  </div>

  <% if @instruments.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @instruments.each do |instrument| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="font-mono text-xl font-bold text-slate-950"><%= link_to instrument.ticker, instrument, class: "hover:text-emerald-700" %></h2>
              <p class="mt-2 text-sm leading-6 text-slate-600"><%= instrument.name %></p>
            </div>

            <span class="rounded-full bg-slate-100 px-3 py-1 font-mono text-xs font-semibold text-slate-700"><%= instrument.exchange %> · <%= instrument.currency %></span>
          </div>

          <%= link_to "View details", instrument, class: "mt-5 inline-flex text-sm font-semibold text-emerald-700 hover:text-emerald-900" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="font-medium text-slate-900">No instruments yet</p>
      <p class="mt-2 text-sm leading-6 text-slate-600">Add an instrument now so it is ready for your first trade.</p>
    </div>
  <% end %>
</section>
