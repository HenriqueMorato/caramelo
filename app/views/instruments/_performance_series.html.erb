<%# locals: (name:, instrument:, history_mode:, selected_period:, currency:, series:, presenter:) %>

<% if series.pending? %>
  <div class="mt-5 rounded-xl border border-warning-border bg-warning-surface px-4 py-3 text-sm text-warning-text" role="status" aria-live="polite">
    <p class="font-semibold"><%= t("instruments.show.Instrument history is building") %></p>
    <p class="mt-1"><%= t("instruments.show.Instrument history is building explanation") %></p>
  </div>
<% elsif series.partial? %>
  <div class="mt-5 rounded-xl border border-warning-border bg-warning-surface px-4 py-3 text-sm text-warning-text" role="status">
    <p class="font-semibold"><%= t("instruments.show.Instrument history is partially available") %></p>
    <p class="mt-1"><%= t("instruments.show.Instrument history is partially available explanation", count: series.missing_dates.length) %></p>
  </div>
<% elsif series.stale? %>
  <div class="mt-5 rounded-xl border border-caramel/30 bg-caramel/10 px-4 py-3 text-sm text-coffee" role="status">
    <p class="font-semibold"><%= t("instruments.show.Instrument history may be out of date") %></p>
    <p class="mt-1"><%= t("instruments.show.Instrument history may be out of date explanation") %></p>
  </div>
<% elsif series.failed? %>
  <div class="mt-5 rounded-xl border border-danger-border bg-danger-surface px-4 py-3 text-sm text-danger-text" role="alert">
    <p class="font-semibold"><%= t("instruments.show.Instrument history update failed") %></p>
    <p class="mt-1"><%= t("instruments.show.Instrument history update failed explanation") %></p>
    <%= link_to t("performances.show.Try again"),
      instrument_path(instrument, history: history_mode, period: selected_period, currency_view: name),
      class: "ui-button ui-button-secondary mt-3" %>
  </div>
<% elsif series.missing? %>
  <div class="mt-5 rounded-xl border border-warning-border bg-warning-surface px-4 py-3 text-sm text-warning-text" role="status">
    <p class="font-semibold"><%= t("instruments.show.Instrument history unavailable") %></p>
    <p class="mt-1"><%= t("instruments.show.Instrument history unavailable explanation") %></p>
  </div>
<% elsif series.empty? %>
  <div class="mt-5 flex min-h-56 flex-1 items-center justify-center rounded-xl border border-dashed border-coffee/15 px-6 text-center text-sm text-muted" role="status">
    <%= t("instruments.show.Closed throughout period") %>
  </div>
<% end %>

<% if series.stale_values? && !series.stale? %>
  <p class="mt-2 text-sm text-muted" role="status"><%= t("performances.show.Stale values remain visible") %></p>
<% end %>

<% if series.displayable? %>
  <% chart_data = presenter.instrument_chart_data(currency:) %>
  <div class="relative mt-4"
       data-controller="performance-chart"
       data-action="popstate@window->performance-chart#restoreMode appearance:change@window->performance-chart#refreshTheme currency-view:changed@window->performance-chart#refreshVisibility"
       data-performance-chart-default-mode-value="performance"
       data-performance-chart-return-only-value="true"
       data-performance-chart-data-value="<%= json_escape(chart_data.to_json) %>">
    <div class="relative h-48 sm:h-56">
      <canvas data-performance-chart-target="canvas" role="img" aria-label="<%= t("instruments.show.Instrument history chart description", instrument: instrument.ticker, currency:) %>"></canvas>
    </div>
  </div>

  <div class="relative mt-3 border-t border-coffee/10 pt-3">
    <details class="text-sm">
      <summary class="cursor-pointer pr-44 font-semibold leading-6 text-coffee"><%= t("performances.show.View exact values") %></summary>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr>
              <th scope="col" class="py-2 pr-4 font-semibold"><%= t("instruments.show.Date") %></th>
              <th scope="col" class="py-2 pr-4 text-right font-semibold"><%= t("instruments.show.Position value") %></th>
              <th scope="col" class="py-2 pr-4 text-right font-semibold"><%= t("instruments.show.Cost basis") %></th>
              <th scope="col" class="py-2 pr-4 text-right font-semibold"><%= t("instruments.show.return_methodologies.modified_dietz.label") %></th>
              <th scope="col" class="py-2 text-right font-semibold"><%= t("instruments.show.return_methodologies.gain_on_cost.label") %></th>
            </tr>
          </thead>
          <tbody>
            <% series.observations.each do |observation| %>
              <tr class="border-t border-coffee/10">
                <td class="py-2 pr-4"><%= l(observation.date, format: :short) %></td>
                <td class="py-2 pr-4 text-right font-mono tabular-nums"><%= value_or_not_available(observation.market_value&.format) %></td>
                <td class="py-2 pr-4 text-right font-mono tabular-nums"><%= value_or_not_available(observation.invested_value&.format) %></td>
                <td class="py-2 pr-4 text-right font-mono tabular-nums"><%= value_or_not_available(observation.return_ratio && number_to_percentage(observation.return_ratio * 100, precision: 2)) %></td>
                <td class="py-2 text-right font-mono tabular-nums"><%= value_or_not_available(observation.gain_on_cost_ratio && number_to_percentage(observation.gain_on_cost_ratio * 100, precision: 2)) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>

    <%= link_to t("instruments.show.How returns are calculated"), performance_methodology_path,
      class: "absolute right-0 top-3 inline-flex leading-6 text-right text-xs font-semibold text-caramel-deep underline decoration-caramel/40 underline-offset-4 hover:text-coffee" %>
  </div>
<% elsif series.pending? %>
  <div class="mt-4 h-48 rounded-xl bg-coffee/5 motion-safe:animate-pulse sm:h-56" aria-hidden="true"></div>
<% end %>
