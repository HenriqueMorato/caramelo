<% content_for :title, "#{@instrument.ticker} · #{t("application.name")}" %>

<section class="mx-auto max-w-4xl space-y-8">
  <div>
    <%= link_to "← All instruments", instruments_path, class: "text-sm font-semibold text-emerald-700 hover:text-emerald-900" %>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700">Instrument</p>
        <h1 class="font-mono text-4xl font-bold tracking-tight text-slate-950"><%= @instrument.ticker %></h1>
        <p class="text-lg text-slate-600"><%= @instrument.name %></p>
      </div>

      <span class="w-fit rounded-full bg-slate-100 px-3 py-1 font-mono text-xs font-semibold text-slate-700"><%= @instrument.exchange %> · <%= @instrument.currency %></span>
    </div>
  </div>

  <div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-950">Trade history</h2>
        <p class="mt-1 text-sm text-slate-600">Purchases and sales recorded for this instrument.</p>
      </div>
      <%= link_to "Add trade", new_instrument_trade_path(@instrument), class: "rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
    </div>

    <% if @trades.any? %>
      <div class="space-y-4">
        <%= render @trades %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
        <p class="font-medium text-slate-900">No trades for this instrument</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Add a purchase or sale to begin its history.</p>
      </div>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= link_to "Edit instrument", edit_instrument_path(@instrument), class: "rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
    <%= button_to "Delete", @instrument, method: :delete, class: "rounded-xl px-5 py-3 text-sm font-semibold text-red-700 hover:bg-red-50", data: { turbo_confirm: "Delete #{@instrument.ticker}?" } %>
  </div>
</section>
