<% content_for :title, t(".Page title", instrument: @instrument.ticker, application: t("caramelo")) %>

<section class="mx-auto max-w-6xl space-y-8">
  <%= link_to t("All instruments"), instruments_path, class: "inline-flex min-h-11 items-center text-sm font-semibold text-caramel-deep hover:text-coffee" %>

  <header class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="flex min-w-0 items-center gap-4">
      <span class="flex size-16 shrink-0 items-center justify-center rounded-[1.1rem] bg-caramel/15 font-mono text-sm font-semibold text-caramel-deep" aria-hidden="true">
        <%= @header_presenter.ticker_mark %>
      </span>
      <div class="min-w-0">
        <h1 class="font-mono text-3xl font-semibold tracking-tight text-coffee sm:text-4xl"><%= @instrument.ticker %></h1>
        <p class="mt-1 truncate text-sm text-muted"><%= @instrument.name %> · <%= @header_presenter.asset_type_label %> · <%= @instrument.currency %></p>
      </div>
    </div>

    <div class="sm:text-right">
      <p class="font-mono text-2xl font-semibold tracking-tight tabular-nums text-coffee"><%= display_money(@header_presenter.price_label, fallback: t("Price unavailable")) %></p>
      <% if @header_presenter.day_change_label %>
        <p class="mt-1 flex items-center gap-2 text-xs font-semibold sm:justify-end <%= @header_presenter.day_change_color_class %>">
          <span aria-hidden="true"><%= @header_presenter.day_change_arrow %></span>
          <span><%= display_money(@header_presenter.day_change_label) %></span>
          <span><%= @header_presenter.day_change_ratio_label %></span>
          <span class="font-normal text-muted"><%= @header_presenter.day_change_period_label %></span>
        </p>
      <% end %>
      <div class="mt-2 sm:flex sm:justify-end">
        <%= render "actions", instrument: @instrument, delete_blocked: @instrument_has_activity %>
      </div>
    </div>
  </header>

  <div class="grid gap-5 lg:grid-cols-[minmax(0,1.3fr)_minmax(20rem,0.7fr)]"
       data-controller="currency-view" data-action="popstate@window->currency-view#restore">
    <%= render "performance",
      instrument: @instrument,
      position: @position,
      position_error: @position_error,
      trades: @trades,
      history_mode: @history_mode,
      selected_period: @selected_period,
      period_selection: @period_selection,
      history_performance_views: @history_performance_views,
      price_history_presenter: @price_history_presenter,
      currency_view: @currency_view %>

    <%= render "position_summary",
      instrument: @instrument,
      position: @position,
      position_error: @position_error,
      valuation: @valuation,
      market_price: @market_price,
      presenters: @performance_presenters,
      native_currency: @instrument.currency,
      reporting_currency: @reporting_currency,
      currency_view: @currency_view %>
  </div>

  <section aria-labelledby="income-history-heading" class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 id="income-history-heading" class="text-lg font-semibold text-coffee"><%= t(".Income history") %></h2>
        <p class="mt-1 text-sm text-muted"><%= t(".Income history description") %></p>
      </div>
      <%= link_to t("corporate_actions.actions.Add income"), new_instrument_corporate_action_path(@instrument), class: "ui-button ui-button-secondary" %>
    </div>

    <% if @corporate_actions.any? %>
      <div class="overflow-x-auto rounded-xl border border-coffee/10 bg-oat-2">
        <table class="ui-data-table min-w-[34rem] text-sm">
          <thead>
            <tr class="text-xs uppercase tracking-[0.08em] text-muted">
              <th scope="col" class="px-4 py-3 font-semibold"><%= CorporateAction.human_attribute_name(:kind) %></th>
              <th scope="col" class="px-4 py-3 font-semibold"><%= CorporateAction.human_attribute_name(:paid_on) %></th>
              <th scope="col" class="px-4 py-3 text-right font-semibold"><%= CorporateAction.human_attribute_name(:net_amount) %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-coffee/10">
            <% @corporate_actions.each do |corporate_action| %>
              <tr>
                <td class="px-4 py-3 font-semibold text-coffee"><%= link_to t("corporate_actions.kinds.#{corporate_action.kind}"), corporate_action, class: "hover:text-caramel-deep" %></td>
                <td class="whitespace-nowrap px-4 py-3 text-muted"><%= l corporate_action.paid_on, format: :long %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right font-mono font-semibold tabular-nums text-coffee"><%= display_money(corporate_action.net_amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-coffee/20 bg-oat-2 p-6 text-center">
        <p class="text-sm font-medium text-coffee"><%= t(".No income") %></p>
      </div>
    <% end %>
  </section>

  <section aria-labelledby="trade-history-heading" class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 id="trade-history-heading" class="text-lg font-semibold text-coffee"><%= t(".Trade history") %></h2>
        <p class="mt-1 text-sm text-muted"><%= t(".Trade history description") %></p>
      </div>
      <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_instrument_trade_path(@instrument), class: "ui-button ui-button-primary" %>
    </div>

    <% if @trades.any? %>
      <div class="space-y-2">
        <%= render @trades %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-coffee/20 bg-oat-2 p-8 text-center">
        <p class="font-medium text-coffee"><%= t(".No trades") %></p>
        <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty history") %></p>
      </div>
    <% end %>
  </section>

</section>
