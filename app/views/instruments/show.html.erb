<% content_for :title, t(".Page title", instrument: @instrument.ticker, application: t("LocalFolio")) %>

<section class="mx-auto max-w-4xl space-y-8">
  <div>
    <%= link_to t("All instruments"), instruments_path, class: "text-sm font-semibold text-caramel-deep hover:text-coffee" %>
  </div>

  <div class="rounded-2xl border border-coffee/10 bg-oat-2 p-6 shadow-sm sm:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="ui-page-header-copy">
        <p class="ui-eyebrow"><%= Instrument.model_name.human %></p>
        <h1 class="font-mono ui-page-title"><%= @instrument.ticker %></h1>
        <p class="ui-page-intro"><%= @instrument.name %></p>
      </div>

      <span class="w-fit rounded-full bg-coffee/5 px-3 py-1 font-mono text-xs font-semibold text-coffee/80"><%= @instrument.exchange %> · <%= @instrument.currency %></span>
    </div>
  </div>

  <section aria-labelledby="position-summary-heading" class="rounded-2xl border bg-oat-2 p-5 shadow-sm sm:p-6 <%= @position_error ? "border-danger-border" : "border-coffee/10" %>">
    <div class="flex flex-wrap items-center gap-2">
      <h2 id="position-summary-heading" class="text-lg font-semibold text-coffee"><%= t(".Current position") %></h2>
      <% if @position_error %>
        <span class="ui-badge ui-badge-attention"><%= t("Needs attention") %></span>
      <% elsif @position.first_trade_date.nil? %>
        <span class="ui-badge ui-badge-closed"><%= t(".No trades status") %></span>
      <% elsif @position.closed? %>
        <span class="ui-badge ui-badge-closed"><%= t("Closed") %></span>
      <% else %>
        <span class="ui-badge ui-badge-open"><%= t("Open") %></span>
      <% end %>
    </div>

    <div class="mt-5">
      <% if @position_error %>
        <div class="rounded-xl bg-danger-surface px-4 py-3 text-sm text-danger-text" role="alert">
          <p class="font-semibold"><%= t(".Position could not be calculated") %></p>
          <p class="mt-1"><%= t(".Sales exceed purchases", date: l(@position_error.trade.traded_on, format: :long)) %></p>
        </div>
        <div class="mt-4">
          <%= render "current_market_prices/current_market_price", market_price: @market_price, refreshing: false %>
        </div>
      <% elsif @position.first_trade_date.nil? %>
        <div class="flex flex-col items-start gap-3 rounded-xl bg-oat px-4 py-3 ring-1 ring-inset ring-coffee/5 sm:flex-row sm:items-center">
          <p class="text-sm text-muted"><%= t(".No position yet") %></p>
          <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_instrument_trade_path(@instrument), class: "shrink-0 text-sm font-semibold text-caramel-deep hover:text-coffee" %>
        </div>
        <div class="mt-4">
          <%= render "current_market_prices/current_market_price", market_price: @market_price, refreshing: false %>
        </div>
      <% else %>
        <%= render "positions/metrics", position: @position, instrument: @instrument, valuation: @valuation, market_price: @market_price %>
      <% end %>

    </div>
  </section>

  <% if @performance_presenters %>
    <%= render "performance",
      presenters: @performance_presenters,
      native_currency: @instrument.currency,
      reporting_currency: @reporting_currency,
      currency_view: @currency_view %>
  <% end %>

  <section aria-labelledby="trade-history-heading" class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 id="trade-history-heading" class="text-lg font-semibold text-coffee"><%= t(".Trade history") %></h2>
        <p class="mt-1 text-sm text-muted"><%= t(".Trade history description") %></p>
      </div>
      <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_instrument_trade_path(@instrument), class: "ui-button ui-button-primary" %>
    </div>

    <% if @trades.any? %>
      <div class="space-y-4">
        <%= render @trades %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-coffee/20 bg-oat-2 p-8 text-center">
        <p class="font-medium text-coffee"><%= t(".No trades") %></p>
        <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty history") %></p>
      </div>
    <% end %>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= link_to t("actions.Edit model", model: Instrument.model_name.human.downcase), edit_instrument_path(@instrument), class: "ui-button ui-button-primary" %>
    <% if @instrument.trades.exists? %>
      <% delete_tooltip_id = dom_id(@instrument, :delete_tooltip) %>
      <span class="group relative inline-flex" tabindex="0" aria-describedby="<%= delete_tooltip_id %>">
        <button type="button" disabled class="ui-button cursor-not-allowed text-muted/70"><%= t("actions.Delete") %></button>
        <span id="<%= delete_tooltip_id %>" role="tooltip" class="pointer-events-none invisible absolute bottom-full left-1/2 z-10 mb-2 w-max max-w-64 -translate-x-1/2 rounded-lg bg-hero px-3 py-2 text-center text-xs font-medium text-hero-text opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 group-focus:visible group-focus:opacity-100">
          <%= t(".Delete blocked") %>
        </span>
      </span>
    <% else %>
      <%= button_to t("actions.Delete"), @instrument, method: :delete, class: "ui-button ui-button-danger", data: { turbo_confirm: t("confirmations.Delete record", record: @instrument.ticker) } %>
    <% end %>
  </div>
</section>
