<% content_for :title, t(".Page title", instrument: @instrument.ticker, application: t("LocalFolio")) %>

<section class="mx-auto max-w-4xl space-y-8">
  <div>
    <%= link_to t("All instruments"), instruments_path, class: "text-sm font-semibold text-emerald-700 hover:text-emerald-900" %>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700"><%= Instrument.model_name.human %></p>
        <h1 class="font-mono text-4xl font-bold tracking-tight text-slate-950"><%= @instrument.ticker %></h1>
        <p class="text-lg text-slate-600"><%= @instrument.name %></p>
      </div>

      <span class="w-fit rounded-full bg-slate-100 px-3 py-1 font-mono text-xs font-semibold text-slate-700"><%= @instrument.exchange %> · <%= @instrument.currency %></span>
    </div>
  </div>

  <section aria-labelledby="position-summary-heading" class="rounded-2xl border bg-white p-5 shadow-sm sm:p-6 <%= @position_error ? "border-red-300" : "border-slate-200" %>">
    <div class="flex flex-wrap items-center gap-2">
      <h2 id="position-summary-heading" class="text-lg font-semibold text-slate-950"><%= t(".Current position") %></h2>
      <% if @position_error %>
        <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-800"><%= t("Needs attention") %></span>
      <% elsif @position.first_trade_date.nil? %>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"><%= t(".No trades status") %></span>
      <% elsif @position.closed? %>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"><%= t("Closed") %></span>
      <% else %>
        <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800"><%= t("Open") %></span>
      <% end %>
    </div>

    <div class="mt-5">
      <% if @position_error %>
        <div class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">
          <p class="font-semibold"><%= t(".Position could not be calculated") %></p>
          <p class="mt-1"><%= t(".Sales exceed purchases", date: l(@position_error.trade.traded_on, format: :long)) %></p>
        </div>
      <% elsif @position.first_trade_date.nil? %>
        <div class="flex flex-col items-start gap-3 rounded-xl bg-slate-50 px-4 py-3 ring-1 ring-inset ring-slate-100 sm:flex-row sm:items-center">
          <p class="text-sm text-slate-600"><%= t(".No position yet") %></p>
          <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_instrument_trade_path(@instrument), class: "shrink-0 text-sm font-semibold text-emerald-700 hover:text-emerald-900" %>
        </div>
      <% else %>
        <%= render "positions/metrics", position: @position, instrument: @instrument %>
      <% end %>

      <div class="mt-3">
        <%= render "current_market_prices/current_market_price", market_price: @market_price, refreshing: false %>
      </div>
    </div>
  </section>

  <div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-950"><%= t(".Trade history") %></h2>
        <p class="mt-1 text-sm text-slate-600"><%= t(".Trade history description") %></p>
      </div>
      <% if @trades.any? %>
        <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_instrument_trade_path(@instrument), class: "rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
      <% end %>
    </div>

    <% if @trades.any? %>
      <div class="space-y-4">
        <%= render @trades %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
        <p class="font-medium text-slate-900"><%= t(".No trades") %></p>
        <p class="mt-2 text-sm leading-6 text-slate-600"><%= t(".Empty history") %></p>
      </div>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= link_to t("actions.Edit model", model: Instrument.model_name.human.downcase), edit_instrument_path(@instrument), class: "rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
    <% if @instrument.trades.exists? %>
      <% delete_tooltip_id = dom_id(@instrument, :delete_tooltip) %>
      <span class="group relative inline-flex" tabindex="0" aria-describedby="<%= delete_tooltip_id %>">
        <button type="button" disabled class="cursor-not-allowed rounded-xl px-5 py-3 text-sm font-semibold text-slate-400"><%= t("actions.Delete") %></button>
        <span id="<%= delete_tooltip_id %>" role="tooltip" class="pointer-events-none invisible absolute bottom-full left-1/2 z-10 mb-2 w-max max-w-64 -translate-x-1/2 rounded-lg bg-slate-950 px-3 py-2 text-center text-xs font-medium text-white opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 group-focus:visible group-focus:opacity-100">
          <%= t(".Delete blocked") %>
        </span>
      </span>
    <% else %>
      <%= button_to t("actions.Delete"), @instrument, method: :delete, class: "rounded-xl px-5 py-3 text-sm font-semibold text-red-700 hover:bg-red-50", data: { turbo_confirm: t("confirmations.Delete record", record: @instrument.ticker) } %>
    <% end %>
  </div>
</section>
