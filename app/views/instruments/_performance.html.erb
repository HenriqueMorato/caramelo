<%# locals: (price_history_presenter:) %>

<section aria-labelledby="instrument-performance-heading" class="ui-panel flex h-full flex-col p-5 sm:p-6">
  <div class="flex items-baseline justify-between gap-3">
    <div>
      <h2 id="instrument-performance-heading" class="font-display text-xl font-semibold tracking-tight text-coffee"><%= t("instruments.show.Price history") %></h2>
      <p class="mt-1 text-sm text-muted"><%= t("instruments.show.Price history description", instrument: price_history_presenter.currency) %></p>
    </div>
    <span class="text-xs text-muted"><%= t("instruments.show.Six months") %></span>
  </div>

  <% if price_history_presenter.available? %>
    <div class="mt-4 min-h-72 flex-1" data-controller="instrument-price-chart" data-action="appearance:change@window->instrument-price-chart#refreshTheme" data-instrument-price-chart-data-value="<%= json_escape(price_history_presenter.chart_data.to_json) %>">
      <canvas data-instrument-price-chart-target="canvas" role="img" aria-label="<%= t("instruments.show.Price history description", instrument: price_history_presenter.currency) %>"></canvas>
    </div>
    <details class="mt-4 text-sm">
      <summary class="cursor-pointer font-semibold text-coffee"><%= t("instruments.show.View exact prices") %></summary>
      <div class="mt-3 max-h-72 overflow-auto">
        <table class="w-full text-left">
          <thead>
            <tr>
              <th scope="col" class="py-2 pr-4 font-semibold"><%= t("instruments.show.Date") %></th>
              <th scope="col" class="py-2 text-right font-semibold"><%= t("instruments.show.Closing price") %></th>
            </tr>
          </thead>
          <tbody>
            <% price_history_presenter.rows.each do |row| %>
              <tr class="border-t border-coffee/10">
                <td class="py-2 pr-4"><%= row.date %></td>
                <td class="py-2 text-right font-mono tabular-nums"><%= row.price %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  <% else %>
    <div class="mt-5 flex min-h-72 flex-1 items-center justify-center rounded-xl border border-dashed border-coffee/15 text-center text-sm text-muted">
      <%= t("instruments.show.Price history unavailable") %>
    </div>
  <% end %>
</section>
