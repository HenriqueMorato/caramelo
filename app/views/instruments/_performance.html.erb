<%# locals: (presenters:, native_currency:, reporting_currency:, currency_view:) %>

<section aria-labelledby="instrument-performance-heading"
         class="ui-panel p-5 sm:p-6"
         data-controller="currency-view"
         data-action="popstate@window->currency-view#restore">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <div>
      <h2 id="instrument-performance-heading" class="text-lg font-semibold text-coffee"><%= t("Performance") %></h2>
      <p class="mt-1 text-sm text-muted"><%= t("instruments.show.Performance description") %></p>
    </div>
    <% if presenters[:reporting] %>
      <div class="currency-view-options" role="group" aria-label="<%= t("instruments.show.Currency view") %>">
        <button type="button" class="currency-view-option"
                data-currency-view-target="button" data-currency-view-name-param="native"
                data-action="currency-view#select" aria-pressed="<%= currency_view == :native %>">
          <%= t("instruments.show.Instrument currency", currency: native_currency) %>
        </button>
        <button type="button" class="currency-view-option"
                data-currency-view-target="button" data-currency-view-name-param="reporting"
                data-action="currency-view#select" aria-pressed="<%= currency_view == :reporting %>">
          <%= t("instruments.show.My currency", currency: reporting_currency) %>
        </button>
      </div>
    <% end %>
  </div>

  <% presenters.each do |name, presenter| %>
    <%= tag.div data: { currency_view_target: "panel", currency_view_name: name }, hidden: name != currency_view do %>
      <%= render "performance_metrics", presenter: %>
    <% end %>
  <% end %>
</section>
