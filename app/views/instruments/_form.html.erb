<%# locals: (instrument:) %>

<%= form_with(model: instrument, class: "space-y-6") do |form| %>
  <% if instrument.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-900" role="alert">
      <p class="font-semibold"><%= t("forms.Could not save", count: instrument.errors.count, model: Instrument.model_name.human.downcase) %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% instrument.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :ticker, class: "block text-sm font-semibold text-coffee" %>
    <p class="mt-1 text-sm text-muted"><%= t(".Ticker help") %></p>
    <%= form.text_field :ticker, required: true, autofocus: true, autocapitalize: "characters", spellcheck: false, class: [ "mt-2 block w-full rounded-xl border bg-oat-2 px-4 py-3 font-mono uppercase text-coffee shadow-sm focus:outline-none focus:ring-2", { "border-coffee/20 focus:border-caramel focus:ring-caramel/20": instrument.errors[:ticker].none?, "border-red-400 focus:border-red-600 focus:ring-red-200": instrument.errors[:ticker].any? } ] %>
  </div>

  <div>
    <%= form.label :name, class: "block text-sm font-semibold text-coffee" %>
    <%= form.text_field :name, required: true, autocomplete: "off", class: [ "mt-2 block w-full rounded-xl border bg-oat-2 px-4 py-3 text-coffee shadow-sm focus:outline-none focus:ring-2", { "border-coffee/20 focus:border-caramel focus:ring-caramel/20": instrument.errors[:name].none?, "border-red-400 focus:border-red-600 focus:ring-red-200": instrument.errors[:name].any? } ] %>
  </div>

  <div>
    <%= form.label :exchange, class: "block text-sm font-semibold text-coffee" %>
    <p class="mt-1 text-sm text-muted"><%= t(".Exchange help") %></p>
    <%= form.text_field :exchange, required: true, maxlength: 4, autocapitalize: "characters", spellcheck: false, class: [ "mt-2 block w-full rounded-xl border bg-oat-2 px-4 py-3 font-mono uppercase text-coffee shadow-sm focus:outline-none focus:ring-2 sm:max-w-32", { "border-coffee/20 focus:border-caramel focus:ring-caramel/20": instrument.errors[:exchange].none?, "border-red-400 focus:border-red-600 focus:ring-red-200": instrument.errors[:exchange].any? } ] %>
  </div>

  <div>
    <%= form.label :currency, class: "block text-sm font-semibold text-coffee" %>
    <p class="mt-1 text-sm text-muted"><%= t(".Currency help") %></p>
    <%= form.text_field :currency, required: true, maxlength: 3, autocapitalize: "characters", spellcheck: false, class: [ "mt-2 block w-full rounded-xl border bg-oat-2 px-4 py-3 font-mono uppercase text-coffee shadow-sm focus:outline-none focus:ring-2 sm:max-w-32", { "border-coffee/20 focus:border-caramel focus:ring-caramel/20": instrument.errors[:currency].none?, "border-red-400 focus:border-red-600 focus:ring-red-200": instrument.errors[:currency].any? } ] %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit class: "cursor-pointer rounded-xl bg-caramel-deep px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-coffee" %>
    <%= link_to t("actions.Cancel"), instrument.persisted? ? instrument_path(instrument) : instruments_path, class: "rounded-xl px-4 py-3 text-sm font-semibold text-coffee/80 hover:bg-coffee/5" %>
  </div>
<% end %>
