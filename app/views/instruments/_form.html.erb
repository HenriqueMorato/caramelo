<%# locals: (instrument:) %>

<%= form_with(model: instrument, class: "space-y-6") do |form| %>
  <% if instrument.errors.any? %>
    <div class="ui-form-errors" role="alert">
      <p class="font-semibold"><%= t("forms.Could not save", count: instrument.errors.count, model: Instrument.model_name.human.downcase) %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% instrument.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :ticker, class: "block text-sm font-semibold text-coffee" %>
    <p class="mt-1 text-sm text-muted"><%= t(".Ticker help") %></p>
    <%= form.text_field :ticker, required: true, autofocus: true, autocapitalize: "characters", spellcheck: false, class: [ "ui-field font-mono uppercase", { "ui-field-invalid": instrument.errors[:ticker].any? } ] %>
  </div>

  <div>
    <%= form.label :name, class: "block text-sm font-semibold text-coffee" %>
    <%= form.text_field :name, required: true, autocomplete: "off", class: [ "ui-field", { "ui-field-invalid": instrument.errors[:name].any? } ] %>
  </div>

  <div>
    <%= form.label :exchange, class: "block text-sm font-semibold text-coffee" %>
    <p class="mt-1 text-sm text-muted"><%= t(".Exchange help") %></p>
    <%= form.text_field :exchange, required: true, maxlength: 4, autocapitalize: "characters", spellcheck: false, class: [ "ui-field font-mono uppercase sm:max-w-32", { "ui-field-invalid": instrument.errors[:exchange].any? } ] %>
  </div>

  <div>
    <%= form.label :currency, class: "block text-sm font-semibold text-coffee" %>
    <p class="mt-1 text-sm text-muted"><%= t(".Currency help") %></p>
    <%= form.text_field :currency, required: true, maxlength: 3, autocapitalize: "characters", spellcheck: false, class: [ "ui-field font-mono uppercase sm:max-w-32", { "ui-field-invalid": instrument.errors[:currency].any? } ] %>
  </div>

  <div>
    <%= form.label :asset_type, class: "block text-sm font-semibold text-coffee" %>
    <p class="mt-1 text-sm text-muted"><%= t(".Asset type help") %></p>
    <%= form.custom_select(:asset_type, Instrument.asset_types.keys.map { |type| [ t("instrument_types.#{type}"), type ] }, {}, required: true, class: "mt-2 block w-full rounded-xl border border-coffee/20 bg-oat-2 px-4 py-3 text-coffee shadow-sm focus:border-caramel focus:outline-none focus:ring-2 focus:ring-caramel/20") %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit class: "ui-button ui-button-primary cursor-pointer" %>
    <%= link_to t("actions.Cancel"), instrument.persisted? ? instrument_path(instrument) : instruments_path, class: "ui-button ui-button-secondary" %>
  </div>
<% end %>
