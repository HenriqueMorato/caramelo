<!DOCTYPE html>
<html
  data-controller="appearance"
  data-action="click@window->appearance#closeMenus keydown.esc@window->appearance#closeMenus storage@window->appearance#storedPreferenceChanged turbo:load@window->appearance#refreshControls"
  data-appearance="system"
  data-theme="light"
>
  <head>
    <title><%= content_for(:title) || t("LocalFolio") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("LocalFolio") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f6efe4">
    <%= render "layouts/appearance_bootstrap" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-oat text-coffee antialiased">
    <a
      href="#main-content"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:left-4 focus-visible:top-4 focus-visible:z-50 focus-visible:rounded-lg focus-visible:bg-hero focus-visible:px-4 focus-visible:py-3 focus-visible:text-sm focus-visible:font-semibold focus-visible:text-hero-text"
    >
      <%= t("Skip to content") %>
    </a>
    <%= render "layouts/notifications" %>
    <%= render "layouts/toast_stack" %>
    <div class="min-h-screen font-sans md:flex">
      <%= render "layouts/navigation" %>

      <div class="min-w-0 flex-1">
        <main
          id="main-content"
          class="mx-auto w-full max-w-[1480px] px-4 py-6 sm:px-6 sm:py-8 md:px-8 lg:px-10 xl:px-12 lg:py-10"
        >
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
