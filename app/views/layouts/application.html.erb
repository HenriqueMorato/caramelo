<!DOCTYPE html>
<html
  lang="en"
  data-controller="appearance money-visibility"
  data-action="click@window->appearance#closeMenus keydown.esc@window->appearance#closeMenus storage@window->appearance#storedPreferenceChanged turbo:load@window->appearance#refreshControls"
  data-appearance="system"
  data-theme="light"
>
  <head>
    <title><%= content_for(:title) || t("caramelo") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Money visibility is session-backed; never restore a stale, visible-money Turbo snapshot. %>
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("caramelo") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f6efe4">
    <%= render "layouts/appearance_bootstrap" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-oat text-coffee antialiased">
    <a
      href="#main-content"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:left-4 focus-visible:top-4 focus-visible:z-50 focus-visible:rounded-lg focus-visible:bg-hero focus-visible:px-4 focus-visible:py-3 focus-visible:text-sm focus-visible:font-semibold focus-visible:text-hero-text"
    >
      <%= t("Skip to content") %>
    </a>
    <%= render "layouts/notifications" %>
    <%= render "layouts/toast_stack" %>
    <div class="min-h-screen font-sans md:flex">
      <%= render "layouts/navigation" %>

      <div class="min-w-0 flex-1 flex flex-col">
        <main
          id="main-content"
          class="mx-auto w-full max-w-[1480px] flex-1 px-4 py-6 sm:px-6 sm:py-8 md:px-8 lg:px-10 xl:px-12 lg:py-10"
        >
          <%= yield %>
        </main>

        <footer
          class="mx-auto flex w-full max-w-[1480px] flex-wrap items-center justify-center gap-x-2 gap-y-1 px-4 py-0 text-xs text-muted sm:px-6 md:justify-end md:px-8 lg:px-10 xl:px-12"
          aria-label="<%= t("Project support") %>"
        >
          <span><%= t("Made with care") %></span>
          <span aria-hidden="true">·</span>
          <%= link_to "https://ko-fi.com/henriquemorato",
            target: "_blank",
            rel: "noopener noreferrer",
            class: "inline-flex min-h-11 items-center rounded-md font-semibold text-caramel-deep underline decoration-caramel/30 underline-offset-4 transition-colors hover:text-coffee hover:decoration-caramel focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel focus-visible:ring-offset-2 md:min-h-0" do %>
            <%= t("Support caramelo") %>
            <span aria-hidden="true" class="ml-1">↗</span>
            <span class="sr-only">(<%= t("Opens in a new tab") %>)</span>
          <% end %>
        </footer>
      </div>
    </div>
  </body>
</html>
