<%# locals: () %>

<aside class="hidden w-52 shrink-0 flex-col border-r border-coffee/10 bg-oat px-4 py-6 md:flex lg:w-56 lg:px-5 lg:py-7">
  <%= link_to root_path, class: "flex items-center gap-2 px-2", translate: "no" do %>
    <%= image_tag "caramelo-logo.svg", class: "size-10", alt: "", aria: { hidden: true } %>
    <span class="font-display text-2xl font-semibold tracking-tight text-coffee">caramelo</span>
  <% end %>

  <nav aria-label="<%= t("Primary navigation") %>" class="mt-8 flex-1 lg:mt-12">
    <div class="flex min-h-8 items-center justify-between pl-3 pr-1">
      <p class="text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted"><%= t("Portfolio") %></p>
      <%= render "layouts/money_visibility" %>
    </div>
    <div class="mt-4 space-y-1">
      <% [[t("Dashboard"), root_path, "⌂"], [t("Positions"), positions_path, "◒"], [t("Transactions"), transactions_path, "↔"], [t("Performance"), performance_path, "↗"]].each do |label, path, icon| %>
        <% active = current_page?(path) || (path == transactions_path && %w[transactions trades corporate_actions].include?(controller_name)) %>
        <%= link_to path, class: class_names("group flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel", "bg-caramel/15 font-bold text-caramel-deep": active, "text-muted hover:bg-caramel/10 hover:text-coffee": !active), aria: { current: ("page" if active) } do %>
          <span class="flex size-8 items-center justify-center text-lg <%= active ? "text-caramel-deep" : "text-coffee/70" %>" aria-hidden="true"><%= icon %></span>
          <span translate="no"><%= label %></span>
        <% end %>
      <% end %>
    </div>
    <p class="mt-10 px-3 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted"><%= t("Manage") %></p>
    <div class="mt-4 space-y-1">
      <% [[t("Institutions"), institutions_path, "¤"], [t("Instruments"), instruments_path, "◉"], [t("Data health"), market_data_health_path, "♥"], [t("Settings"), settings_path, "⚙"]].each do |label, path, icon| %>
        <% active = current_page?(path) %>
        <%= link_to path, class: class_names("group flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel", "bg-caramel/15 font-bold text-caramel-deep": active, "text-muted hover:bg-caramel/10 hover:text-coffee": !active), aria: { current: ("page" if active) } do %>
          <span class="flex size-8 items-center justify-center text-lg text-coffee/70" aria-hidden="true"><%= icon %></span>
          <span translate="no"><%= label %></span>
        <% end %>
      <% end %>
    </div>
  </nav>

  <details class="group relative mb-3" data-appearance-target="menu">
    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between rounded-xl px-3 text-sm font-semibold text-muted transition-colors hover:bg-caramel/10 hover:text-coffee focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel [&::-webkit-details-marker]:hidden">
      <span><%= t("appearance.Appearance") %></span>
      <span
        class="text-xs font-medium text-caramel-deep"
        data-appearance-target="label"
        data-light="<%= t("appearance.Light") %>"
        data-dark="<%= t("appearance.Dark") %>"
        data-system="<%= t("appearance.System") %>"
      ><%= t("appearance.System") %></span>
    </summary>
    <div class="absolute bottom-full left-0 z-40 mb-2 w-full rounded-xl border border-coffee/10 bg-paper p-2 shadow-lg">
      <%= render "layouts/appearance_options", compact: true %>
    </div>
  </details>

  <div class="relative overflow-hidden rounded-2xl bg-caramel/15 p-4">
    <p class="relative z-10 font-display text-lg leading-tight text-coffee"><span class="block"><%= t("Small steps") %></span><span class="block"><%= t("Long walks") %></span></p>
    <p class="relative z-10 mt-3 text-xs leading-5 text-caramel-deep/80"><%= t("Your portfolio is out for a stroll") %></p>
    <span class="absolute -bottom-8 -right-7 size-[90px] rounded-full bg-paper/30" aria-hidden="true"></span>
  </div>
</aside>

<header class="border-b border-coffee/10 bg-oat/95 md:hidden">
  <div class="flex items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <%= link_to root_path, class: "flex items-center gap-2", translate: "no" do %>
      <%= image_tag "caramelo-logo.svg", class: "size-8", alt: "", aria: { hidden: true } %>
      <span class="font-display text-2xl font-semibold text-coffee">caramelo</span>
    <% end %>
    <div class="flex items-center gap-2">
      <details class="relative">
      <summary class="ui-button ui-button-secondary min-h-11 cursor-pointer list-none px-3 [&::-webkit-details-marker]:hidden">Menu</summary>
      <nav aria-label="<%= t("Primary navigation") %>" class="absolute right-0 top-full z-[55] mt-2 w-56 rounded-2xl border border-coffee/10 bg-oat-2 p-2 shadow-lg">
        <div class="mb-1 flex min-h-11 items-center justify-between pl-3">
          <p class="text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted"><%= t("Portfolio") %></p>
          <%= render "layouts/money_visibility", mobile: true %>
        </div>
        <% [[t("Dashboard"), root_path], [t("Positions"), positions_path], [t("Transactions"), transactions_path], [t("Performance"), performance_path]].each do |label, path| %>
          <% active = current_page?(path) || (path == transactions_path && %w[transactions trades corporate_actions].include?(controller_name)) %>
          <%= link_to label, path, class: class_names("flex min-h-11 items-center rounded-xl px-3 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel", "bg-caramel/15 font-bold text-caramel-deep": active, "text-muted hover:bg-caramel/10 hover:text-coffee": !active), aria: { current: ("page" if active) } %>
        <% end %>
        <p class="mb-1 mt-3 border-t border-coffee/10 px-3 pt-3 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted"><%= t("Manage") %></p>
        <% [[t("Institutions"), institutions_path], [t("Instruments"), instruments_path], [t("Data health"), market_data_health_path], [t("Settings"), settings_path]].each do |label, path| %>
          <% active = current_page?(path) %>
          <%= link_to label, path, class: class_names("flex min-h-11 items-center rounded-xl px-3 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel", "bg-caramel/15 font-bold text-caramel-deep": active, "text-muted hover:bg-caramel/10 hover:text-coffee": !active), aria: { current: ("page" if active) } %>
        <% end %>
        <div class="mt-2 border-t border-coffee/10 px-1 pt-3">
          <p class="mb-2 px-2 text-xs font-semibold text-muted"><%= t("appearance.Appearance") %></p>
          <%= render "layouts/appearance_options", compact: true %>
        </div>
      </nav>
      </details>
    </div>
  </div>
</header>
