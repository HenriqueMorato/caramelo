<%# locals: () %>

<% if notice %>
  <p class="mb-6 rounded-xl border border-leaf/30 bg-leaf/10 px-4 py-3 text-sm font-medium text-coffee" role="status"><%= notice %></p>
<% end %>
<% if alert %>
  <p class="mb-6 rounded-xl border border-guava/30 bg-guava/10 px-4 py-3 text-sm font-medium text-coffee" role="alert"><%= alert %></p>
<% end %>
