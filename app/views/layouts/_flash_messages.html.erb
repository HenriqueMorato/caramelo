<%# locals: () %>

<div id="flash-messages" class="contents" aria-live="polite">
  <% if notice %>
    <p data-controller="notification" data-notification-duration-value="3000" class="pointer-events-auto relative flex items-start gap-3 overflow-hidden rounded-2xl border border-leaf/25 bg-oat-2/95 px-4 py-3 text-sm font-medium text-coffee shadow-[0_12px_30px_-14px_rgb(46_33_28_/_0.45)] backdrop-blur-sm motion-safe:animate-[toast-in_180ms_cubic-bezier(0.23,1,0.32,1)]" role="status">
      <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-leaf/15 text-xs text-leaf" aria-hidden="true">✓</span>
      <span class="leading-5"><%= notice %></span>
      <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left bg-leaf motion-safe:animate-[toast-progress_3s_linear_forwards]" aria-hidden="true"></span>
    </p>
  <% end %>
  <% if alert %>
    <p data-controller="notification" data-notification-duration-value="3000" class="pointer-events-auto relative flex items-start gap-3 overflow-hidden rounded-2xl border border-guava/25 bg-oat-2/95 px-4 py-3 text-sm font-medium text-coffee shadow-[0_12px_30px_-14px_rgb(46_33_28_/_0.45)] backdrop-blur-sm motion-safe:animate-[toast-in_180ms_cubic-bezier(0.23,1,0.32,1)]" role="alert">
      <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-guava/15 text-xs text-guava" aria-hidden="true">!</span>
      <span class="leading-5"><%= alert %></span>
      <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left bg-guava motion-safe:animate-[toast-progress_3s_linear_forwards]" aria-hidden="true"></span>
    </p>
  <% end %>
</div>
