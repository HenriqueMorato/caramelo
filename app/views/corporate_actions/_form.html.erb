<%# locals: (corporate_action:, context_instrument:, instruments:, institutions_by_instrument:, return_to: nil) %>

<% currency = corporate_action.currency || context_instrument&.currency %>
<% subunit = currency ? Money::Currency.find(currency).subunit_to_unit : 100 %>
<% money_step = 1.0 / subunit %>
<% institution_options = institutions_by_instrument.transform_keys(&:to_s).transform_values { |items| items.map { |institution| { id: institution.id, name: institution.name } } } %>
<% selected_instrument_id = context_instrument&.id || corporate_action.instrument_id %>
<% available_institutions = institutions_by_instrument.fetch(selected_instrument_id, []) %>
<% single_institution = available_institutions.one? ? available_institutions.first : nil %>

<%= form_with model: corporate_action,
              url: corporate_action.persisted? ? corporate_action_path(corporate_action) : (context_instrument ? instrument_corporate_actions_path(context_instrument) : corporate_actions_path),
              class: "space-y-6",
              data: {
                controller: "income-form",
                income_form_currency_value: currency,
                income_form_subunit_value: subunit,
                income_form_institutions_value: institution_options.to_json,
                income_form_institution_value: corporate_action.institution_id,
                income_form_no_institution_value: t("forms.No institution"),
                income_form_discard_value: t(".Discard changes"),
                income_form_dirty_value: corporate_action.errors.any?,
                action: "input->income-form#markDirty change->income-form#markDirty turbo:submit-start->income-form#submit turbo:submit-end->income-form#submitted turbo:before-visit@window->income-form#confirmNavigation beforeunload@window->income-form#beforeUnload"
              } do |form| %>
  <%= hidden_field_tag :return_to, return_to if return_to.present? %>

  <% if corporate_action.errors.any? %>
    <div class="ui-form-errors" role="alert">
      <p class="font-semibold"><%= t("forms.Could not save", count: corporate_action.errors.count, model: CorporateAction.model_name.human.downcase) %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% corporate_action.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="text-sm text-muted"><span class="font-semibold text-guava">*</span> <%= t("forms.Required fields") %></p>

  <% if context_instrument %>
    <%= form.hidden_field :instrument_id, value: context_instrument.id, data: { income_form_target: "instrument" } %>
    <div class="rounded-xl border border-coffee/10 bg-oat p-4">
      <p class="text-sm font-semibold text-coffee"><%= t("forms.Required attribute", attribute: CorporateAction.human_attribute_name(:instrument)) %></p>
      <p class="mt-1 font-mono text-lg font-bold"><%= context_instrument.ticker %> · <%= context_instrument.exchange %></p>
      <p class="mt-1 text-sm text-muted"><%= context_instrument.name %></p>
    </div>
  <% else %>
    <div>
      <%= form.label :instrument_id, t("forms.Required attribute", attribute: CorporateAction.human_attribute_name(:instrument)), class: "block text-sm font-semibold text-coffee" %>
      <% instrument_options = instruments.map { |instrument| [ "#{instrument.ticker} · #{instrument.exchange} — #{instrument.name}", instrument.id, { data: { currency: instrument.currency, subunit: Money::Currency.find(instrument.currency).subunit_to_unit } } ] } %>
      <%= form.custom_select(:instrument_id,
                      options_for_select(instrument_options, corporate_action.instrument_id),
                      { include_blank: t("forms.Select an instrument") },
                      required: true,
                      autofocus: true,
                      class: [ "ui-field", { "ui-field-invalid": corporate_action.errors[:instrument].any? } ],
                      data: { income_form_target: "instrument", action: "change->income-form#syncInstrument" },
                      searchable: true) %>
    </div>
  <% end %>

  <%= form.hidden_field :kind, value: "dividend", disabled: currency == "BRL", id: nil,
    data: { income_form_target: "hiddenKind" } %>
  <%= tag.div hidden: currency != "BRL", data: { income_form_target: "kindField" } do %>
    <%= form.label :kind, t("forms.Required attribute", attribute: CorporateAction.human_attribute_name(:kind)), class: "block text-sm font-semibold text-coffee" %>
    <%= form.custom_select(:kind, [ [ t("corporate_actions.kinds.dividend"), "dividend" ], [ t("corporate_actions.kinds.jcp"), "jcp" ] ], {},
      required: true, disabled: currency != "BRL", class: "ui-field sm:max-w-xs", data: { income_form_target: "kind" }) %>
  <% end %>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :paid_on, t("forms.Required attribute", attribute: CorporateAction.human_attribute_name(:paid_on)), class: "block text-sm font-semibold text-coffee" %>
      <%= form.date_field :paid_on, required: true, class: "ui-field" %>
      <p class="mt-1 text-xs text-muted"><%= t(".Payment date help") %></p>
    </div>
    <div>
      <%= form.label :ex_date, class: "block text-sm font-semibold text-coffee" %>
      <%= form.date_field :ex_date, class: "ui-field" %>
      <p class="mt-1 text-xs leading-5 text-muted"><%= t(".Ex-date help") %></p>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-3">
    <div>
      <%= form.label :gross_amount, t("forms.Required attribute", attribute: CorporateAction.human_attribute_name(:gross_amount)), class: "block text-sm font-semibold text-coffee" %>
      <%= form.number_field :gross_amount, value: corporate_action.gross_amount&.to_d, required: true, min: 0, step: money_step, inputmode: "decimal", class: "ui-field font-mono tabular-nums", data: { income_form_target: "gross", action: "input->income-form#updateNet" } %>
    </div>
    <div>
      <%= form.label :withholding_tax, class: "block text-sm font-semibold text-coffee" %>
      <%= form.number_field :withholding_tax, value: corporate_action.withholding_tax&.to_d, min: 0, step: money_step, inputmode: "decimal", class: "ui-field font-mono tabular-nums", data: { income_form_target: "tax", action: "input->income-form#updateNet" } %>
    </div>
    <div class="rounded-xl bg-caramel/10 px-4 py-3">
      <p class="text-xs font-semibold uppercase tracking-[0.08em] text-caramel-deep"><%= CorporateAction.human_attribute_name(:net_amount) %></p>
      <output class="mt-2 block min-h-7 font-mono text-lg font-semibold tabular-nums text-coffee" data-income-form-target="net"><%= display_money(corporate_action.net_amount, fallback: "—") %></output>
      <p class="mt-1 text-xs text-muted"><%= t(".Net amount help") %></p>
    </div>
  </div>

  <%= form.hidden_field :institution_id, value: single_institution&.id,
    disabled: single_institution.nil?, id: nil,
    data: { income_form_target: "hiddenInstitution" } %>
  <%= tag.div hidden: !available_institutions.many?, data: { income_form_target: "institutionField" } do %>
    <%= form.label :institution_id, t(".Institution optional"), for: "corporate_action_institution_choice",
      class: "block text-sm font-semibold text-coffee" %>
    <%= form.custom_select(:institution_id,
      options_from_collection_for_select(available_institutions, :id, :name, corporate_action.institution_id),
      { include_blank: t("forms.No institution") },
      disabled: !available_institutions.many?, id: "corporate_action_institution_choice", class: "ui-field",
      data: { income_form_target: "institution" }, searchable: true) %>
  <% end %>

  <div>
    <%= form.label :notes, class: "block text-sm font-semibold text-coffee" %>
    <%= form.text_area :notes, rows: 4, class: "ui-field" %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.button class: "ui-button ui-button-primary group cursor-pointer", type: :submit do %>
      <span class="hidden size-4 animate-spin rounded-full border-2 border-current border-r-transparent motion-reduce:animate-none group-disabled:inline-block" aria-hidden="true"></span>
      <%= t("corporate_actions.actions.Save income") %>
    <% end %>
    <%= link_to t("actions.Cancel"), return_to || context_instrument || transactions_path, class: "ui-button ui-button-secondary" %>
  </div>
<% end %>
