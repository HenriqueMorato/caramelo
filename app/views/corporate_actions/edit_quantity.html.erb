<% content_for :title, t(".Page title", application: t("caramelo")) %>

<section
  class="mx-auto max-w-6xl space-y-8"
  data-controller="quantity-action-form"
  data-action="input->quantity-action-form#refreshPreview change->quantity-action-form#refreshPreview reset->quantity-action-form#resetPreview"
>
  <%= link_to t("Back"), @return_to, class: "inline-flex min-h-11 items-center text-sm font-semibold text-caramel-deep hover:text-coffee" %>
  <div class="ui-page-header-copy">
    <p class="ui-eyebrow"><%= t("Portfolio activity") %></p>
    <h1 class="ui-page-title"><%= t("corporate_actions.actions.Edit quantity action") %></h1>
    <p class="ui-page-intro"><%= t("corporate_actions.new_quantity.Introduction") %></p>
  </div>
  <div class="action-entry-layout">
    <%= render "quantity_form", corporate_action: @corporate_action, context_instrument: nil,
      instruments: @instruments, institutions_by_instrument: @institutions_by_instrument,
      preview_quantity: @quantity_action_preview_quantity,
      preview_quantities_by_instrument: @quantity_action_preview_quantities,
      return_to: @return_to %>
    <%= render "quantity_preview", corporate_action: @corporate_action, context_instrument: nil,
      preview_quantity: @quantity_action_preview_quantity %>
  </div>
</section>
