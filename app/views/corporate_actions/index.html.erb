<% content_for :title, t(".Page title", application: t("caramelo")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Portfolio activity") %></p>
      <h1 class="ui-page-title"><%= t(".Heading") %></h1>
      <p class="ui-page-intro"><%= t(".Introduction") %></p>
    </div>

    <%= link_to t("corporate_actions.actions.Add income"), new_corporate_action_path, class: "ui-button ui-button-primary w-fit" %>
  </div>

  <% if @has_corporate_actions %>
    <div>
      <nav class="flex rounded-t-xl border border-coffee/10 bg-paper px-4 py-3" aria-label="<%= t(".Income filters") %>">
        <div class="inline-flex rounded-md bg-paper/50 p-1">
          <% [ [ t(".All income"), nil ], [ t(".Dividends only"), "dividend" ], [ t(".JCP only"), "jcp" ] ].each do |label, kind| %>
            <%= link_to label,
                        income_path(kind:),
                        class: "trade-filter-option",
                        aria: { current: ("page" if @kind == kind) } %>
          <% end %>
        </div>
      </nav>

      <div class="overflow-x-auto rounded-b-xl border border-t-0 border-coffee/10 bg-oat-2">
        <table class="ui-data-table min-w-[64rem] table-fixed text-sm">
          <colgroup>
            <col class="w-[28%]">
            <col class="w-[15%]">
            <col class="w-[14%]">
            <col class="w-[14%]">
            <col class="w-[14%]">
            <col class="w-[15%]">
          </colgroup>
          <thead>
            <tr class="text-xs uppercase tracking-[0.08em] text-muted">
              <th scope="col" class="px-4 py-3 font-semibold"><%= t(".Income event") %></th>
              <th scope="col" class="px-4 py-3 font-semibold"><%= CorporateAction.human_attribute_name(:paid_on) %></th>
              <th scope="col" class="px-4 py-3 text-right font-semibold"><%= CorporateAction.human_attribute_name(:gross_amount) %></th>
              <th scope="col" class="px-4 py-3 text-right font-semibold"><%= CorporateAction.human_attribute_name(:withholding_tax) %></th>
              <th scope="col" class="px-4 py-3 text-right font-semibold"><%= CorporateAction.human_attribute_name(:net_amount) %></th>
              <th scope="col" class="px-4 py-3"><span class="sr-only"><%= t(".Actions") %></span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-coffee/10">
            <% if @corporate_actions.any? %>
              <%= render partial: "table_row", collection: @corporate_actions, as: :corporate_action %>
            <% else %>
              <tr>
                <td colspan="6" class="px-4 py-8 text-center text-sm text-muted"><%= t(".No matching income") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="ui-empty-state">
      <p class="font-medium text-coffee"><%= t(".No income yet") %></p>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty state") %></p>
    </div>
  <% end %>
</section>
