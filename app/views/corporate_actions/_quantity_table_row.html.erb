<%# locals: (corporate_action:) %>

<tr id="<%= dom_id(corporate_action) %>" class="align-middle">
  <td class="max-w-64 px-4 py-3">
    <div class="flex min-w-0 items-center gap-3">
      <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-caramel/15 font-mono text-[0.625rem] font-semibold text-caramel-deep" aria-hidden="true"><%= corporate_action.instrument.ticker.first(4) %></span>
      <span class="min-w-0">
        <%= link_to corporate_action.instrument.name, corporate_action.instrument, class: "block truncate font-semibold text-coffee hover:text-caramel-deep" %>
        <span class="block truncate text-xs text-muted"><%= [ corporate_action.instrument.ticker, corporate_action.instrument.exchange, corporate_action.institution&.name ].compact.join(" · ") %></span>
        <% if corporate_action.notes.present? %><span class="block truncate text-xs text-muted"><%= corporate_action.notes %></span><% end %>
      </span>
    </div>
  </td>
  <td class="whitespace-nowrap px-4 py-3 text-muted"><%= l corporate_action.effective_on, format: :long %></td>
  <td class="px-4 py-3 text-center"><span class="ui-badge bg-caramel/15 uppercase tracking-wide text-caramel-deep"><%= t("corporate_actions.kinds.#{corporate_action.kind}") %></span></td>
  <td class="whitespace-nowrap px-4 py-3 text-center font-mono tabular-nums text-coffee"><%= corporate_action.ratio_numerator %>:<%= corporate_action.ratio_denominator %></td>
  <td class="whitespace-nowrap px-4 py-3 text-center font-mono tabular-nums text-muted" aria-label="<%= t("Not applicable") %>">—</td>
  <td class="whitespace-nowrap px-4 py-3 text-center font-mono tabular-nums text-muted"><%= corporate_action.cash_in_lieu_quantity || "—" %></td>
  <td class="whitespace-nowrap px-4 py-3 text-center font-mono font-semibold tabular-nums text-coffee"><%= display_money(corporate_action.cash_in_lieu_amount, fallback: "—") %></td>
  <td class="px-4 py-3">
    <div class="flex items-center justify-end gap-1">
      <%= link_to t("actions.Edit"), edit_quantity_action_path(corporate_action), class: "flex min-h-11 items-center rounded-lg px-2 text-xs font-semibold text-caramel-deep hover:bg-caramel/10 hover:text-coffee sm:min-h-8" %>
      <%= button_to t("actions.Delete"), corporate_action_path(corporate_action), method: :delete, class: "min-h-11 rounded-lg px-2 text-xs font-semibold text-guava hover:bg-danger-surface hover:text-danger-text sm:min-h-8", data: { turbo_confirm: t("confirmations.Delete corporate action") } %>
    </div>
  </td>
</tr>
