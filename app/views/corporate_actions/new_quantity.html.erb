<% content_for :title, t(".Page title", application: t("caramelo")) %>

<section class="mx-auto max-w-4xl space-y-8">
  <%= link_to t("Back"), @context_instrument || transactions_path, class: "inline-flex min-h-11 items-center text-sm font-semibold text-caramel-deep hover:text-coffee" %>
  <div class="ui-page-header-copy">
    <p class="ui-eyebrow"><%= t("Portfolio activity") %></p>
    <h1 class="ui-page-title"><%= t("corporate_actions.actions.Add quantity action") %></h1>
    <p class="ui-page-intro"><%= t(".Introduction") %></p>
  </div>
  <div class="rounded-2xl border border-coffee/10 bg-oat-2 p-6 shadow-sm sm:p-8">
    <%= render "quantity_form", corporate_action: @corporate_action, context_instrument: @context_instrument,
      instruments: @instruments, institutions_by_instrument: @institutions_by_instrument %>
  </div>
</section>
