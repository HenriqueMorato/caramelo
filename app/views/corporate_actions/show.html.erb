<% content_for :title, t(".Page title", instrument: @corporate_action.instrument.ticker, application: t("caramelo")) %>

<section class="mx-auto max-w-3xl space-y-8">
  <%= link_to t("corporate_actions.Income link"), income_path, class: "inline-flex min-h-11 items-center text-sm font-semibold text-caramel-deep hover:text-coffee" %>

  <header class="ui-page-header">
    <div class="ui-page-header-copy min-w-0">
      <p class="ui-eyebrow"><%= t("corporate_actions.kinds.#{@corporate_action.kind}") %></p>
      <h1 class="ui-page-title truncate"><%= @corporate_action.instrument.ticker %> · <%= @corporate_action.instrument.name %></h1>
      <p class="ui-page-intro"><%= t(".Introduction", date: l(@corporate_action.paid_on, format: :long)) %></p>
    </div>
    <%= link_to t("actions.Edit"), edit_corporate_action_path(@corporate_action), class: "ui-button ui-button-secondary w-fit" %>
  </header>

  <div class="ui-card p-6 sm:p-8">
    <div class="grid gap-6 sm:grid-cols-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted"><%= CorporateAction.human_attribute_name(:gross_amount) %></p>
        <p class="mt-2 font-mono text-xl font-semibold tabular-nums text-coffee"><%= display_money(@corporate_action.gross_amount) %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted"><%= CorporateAction.human_attribute_name(:withholding_tax) %></p>
        <p class="mt-2 font-mono text-xl font-semibold tabular-nums text-muted"><%= display_money(@corporate_action.withholding_tax) %></p>
      </div>
      <div class="rounded-xl bg-caramel/10 p-4">
        <p class="text-xs font-semibold uppercase tracking-[0.08em] text-caramel-deep"><%= CorporateAction.human_attribute_name(:net_amount) %></p>
        <p class="mt-2 font-mono text-xl font-semibold tabular-nums text-coffee"><%= display_money(@corporate_action.net_amount) %></p>
      </div>
    </div>

    <dl class="mt-8 divide-y divide-coffee/10 text-sm">
      <% [
        [ CorporateAction.human_attribute_name(:paid_on), l(@corporate_action.paid_on, format: :long) ],
        [ CorporateAction.human_attribute_name(:ex_date), @corporate_action.ex_date && l(@corporate_action.ex_date, format: :long) ],
        [ CorporateAction.human_attribute_name(:institution), @corporate_action.institution&.name ]
      ].each do |label, value| %>
        <div class="flex items-start justify-between gap-6 py-3 first:pt-0 last:pb-0">
          <dt class="text-muted"><%= label %></dt>
          <dd class="max-w-md text-right font-medium text-coffee"><%= value.presence || t("Not available") %></dd>
        </div>
      <% end %>
    </dl>

    <% if @corporate_action.notes.present? %>
      <div class="mt-8 border-t border-coffee/10 pt-6">
        <h2 class="text-sm font-semibold text-coffee"><%= CorporateAction.human_attribute_name(:notes) %></h2>
        <p class="mt-2 break-words text-sm leading-6 text-muted"><%= @corporate_action.notes %></p>
      </div>
    <% end %>
  </div>
</section>
