<% content_for :title, t("asset_types.index.Page title", application: t("caramelo")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Portfolio catalog") %></p>
      <h1 class="ui-page-title"><%= t("asset_types.index.Heading") %></h1>
      <p class="ui-page-intro"><%= t("asset_types.index.Introduction") %></p>
    </div>

    <%= link_to t("actions.Add", model: AssetType.model_name.human.downcase), new_asset_type_path, class: "ui-button ui-button-primary w-fit" %>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <% @asset_types.each do |asset_type| %>
      <% usage_count = asset_type.instruments_count.to_i %>
      <article id="<%= dom_id(asset_type) %>" class="ui-card ui-card-interactive flex h-full flex-col p-6">
        <div class="flex min-w-0 items-start justify-between gap-4">
          <div class="min-w-0">
            <h2 class="truncate text-lg font-semibold text-coffee"><%= asset_type.name %></h2>
            <p class="mt-2 text-sm leading-6 text-muted">
              <%= t("asset_types.index.Instrument count", count: usage_count) %>
            </p>
          </div>

          <span class="ui-badge <%= asset_type.system? ? "ui-badge-active" : "ui-badge-inactive" %>">
            <%= t(asset_type.system? ? "asset_types.index.Built-in" : "asset_types.index.Custom") %>
          </span>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-coffee/10 pt-4">
          <%= link_to t("actions.Edit"), edit_asset_type_path(asset_type), class: "ui-button ui-button-secondary" %>
          <% if asset_type.system? %>
            <span class="text-xs text-muted"><%= t("asset_types.index.Built-in cannot be deleted") %></span>
          <% elsif usage_count.positive? %>
            <span class="text-xs text-muted"><%= t("asset_types.index.Used cannot be deleted") %></span>
          <% else %>
            <%= button_to t("actions.Delete"), asset_type_path(asset_type), method: :delete,
              class: "ui-button ui-button-secondary", form_class: "shrink-0",
              form: { data: { turbo_confirm: t("confirmations.Delete asset type", name: asset_type.name) } } %>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</section>
