<% content_for :title, t(".Page title", application: t("caramelo")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t(".Eyebrow") %></p>
      <h1 class="ui-page-title"><%= t(".Heading") %></h1>
      <p class="ui-page-intro"><%= t(".Introduction") %></p>
    </div>

    <nav aria-label="<%= t(".Period selection") %>" class="inline-flex rounded-md bg-paper/50 p-1">
      <% Performance::PeriodSelection::PERIODS.each_key do |period| %>
        <% selected = @selected_period == period %>
        <%= link_to t(".#{period.humanize}"), performance_path(period:), class: "period-option",
          aria: { current: ("page" if selected) } %>
      <% end %>
    </nav>
  </div>

  <% if @performance.missing? %>
    <% title_key, explanation_key = if @historical_data_backfill_pending
      [ ".Historical data is loading", ".Historical data is loading explanation" ]
    else
      [ ".Historical data unavailable", ".Historical data unavailable explanation" ]
    end %>
    <div class="rounded-2xl border border-warning-border bg-warning-surface p-6 text-warning-text" role="status">
      <h2 class="font-semibold"><%= t(title_key) %></h2>
      <p class="mt-2 text-sm leading-6"><%= t(explanation_key) %></p>
    </div>
  <% elsif @performance.empty? %>
    <div class="rounded-2xl border border-dashed border-coffee/20 bg-oat-2 p-8 text-center">
      <p class="font-medium text-coffee"><%= t(".No performance yet") %></p>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty state") %></p>
      <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_trade_path, class: "ui-button ui-button-primary mt-5" %>
    </div>
  <% else %>
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)]">
      <article class="ui-panel p-6 sm:p-8">
        <p class="ui-eyebrow"><%= t(".Portfolio return") %></p>
        <p class="mt-5 font-mono text-4xl font-semibold tracking-[-0.06em] text-coffee sm:text-6xl">
          <%= @period_presenter.return_label || t("Not available") %>
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold <%= @period_presenter.gain_loss_color_class %>">
          <span aria-hidden="true"><%= @period_presenter.gain_loss_arrow %></span>
          <span><%= display_money(@period_presenter.gain_loss_label) %></span>
          <span class="font-normal text-muted"><%= @series_presenter.date_range_label %></span>
        </div>
      </article>

      <aside class="ui-highlight-panel rounded-[1.25rem] border p-6" aria-labelledby="return-snapshot-heading">
        <h2 id="return-snapshot-heading" class="font-display text-2xl font-semibold tracking-tight"><%= t(".Across the trail") %></h2>
        <dl class="mt-5 grid grid-cols-2 gap-x-5 gap-y-5">
          <div>
            <dt class="ui-highlight-muted text-xs"><%= t(".Portfolio value") %></dt>
            <dd class="mt-1 font-mono text-lg font-semibold tabular-nums"><%= display_money(@performance.closing_valuation.market_value) %></dd>
          </div>
          <div>
            <dt class="ui-highlight-muted text-xs"><%= t(".Net invested") %></dt>
            <dd class="mt-1 font-mono text-lg font-semibold tabular-nums"><%= display_money(@performance.net_cash_flow) %></dd>
          </div>
          <div>
            <dt class="ui-highlight-muted text-xs"><%= t(".Realized gains to date") %></dt>
            <dd class="mt-1 font-mono text-lg font-semibold tabular-nums"><%= display_money(@performance.closing_valuation.realized_gain) %></dd>
          </div>
          <div>
            <dt class="ui-highlight-muted text-xs"><%= t(".Unrealized gains to date") %></dt>
            <dd class="mt-1 font-mono text-lg font-semibold tabular-nums <%= @period_presenter.unrealized_gain_color_class %>"><%= display_money(@performance.closing_valuation.unrealized_gain) %></dd>
          </div>
        </dl>
        <p class="ui-highlight-divider ui-highlight-muted mt-5 border-t pt-4 text-xs leading-5"><%= t(".Return methodology") %></p>
      </aside>
    </div>

    <% if @benchmark_results.present? %>
      <section class="ui-panel px-5 py-4 sm:px-6" aria-labelledby="market-benchmarks-heading">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="market-benchmarks-heading" class="font-display text-xl font-semibold tracking-tight text-coffee"><%= t(".Market benchmarks") %></h2>
          <p class="text-xs text-muted"><%= t(".Market benchmarks explanation") %></p>
        </div>
        <div class="mt-3 grid gap-0 sm:grid-cols-2 sm:divide-x sm:divide-coffee/10 lg:grid-cols-4">
          <% @benchmark_results.each do |benchmark, result| %>
            <article class="border-t border-coffee/10 py-3 text-center first:border-t-0 sm:border-t-0 sm:px-5 sm:first:pl-0 sm:last:pr-0">
              <h3 class="truncate text-xs font-semibold uppercase tracking-[0.08em] text-muted"><%= benchmark.name %></h3>
              <% if result.available? %>
                <p class="mt-2 font-mono text-lg font-semibold tabular-nums text-coffee"><%= "+" if result.return_ratio.positive? %><%= number_to_percentage(result.return_ratio * 100, precision: 2) %></p>
              <% else %>
                <p class="mt-2 text-sm text-muted"><%= t(".Benchmark unavailable") %></p>
              <% end %>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="rounded-2xl border border-coffee/10 bg-oat-2 p-5 shadow-sm" aria-labelledby="performance-series-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <h2 id="performance-series-heading" class="text-lg font-semibold text-coffee"><%= t(".Portfolio history") %></h2>
          <p class="mt-1 text-sm text-muted"><%= t(".Portfolio history explanation") %></p>
        </div>
        <span class="text-xs text-muted"><%= @series_presenter.date_range_label %></span>
      </div>

      <%= render "series_status", series: @series, series_presenter: @series_presenter,
        selected_period: @selected_period %>

      <% if @series.displayable? %>
        <% chart_data = @series_presenter.chart_data(
          benchmarks: @benchmark_chart_data,
          currency: @performance.closing_valuation.market_value.currency.iso_code,
          include_money_values: !money_values_hidden?
        ) %>
        <div
          class="relative mt-5"
          data-controller="performance-chart"
          data-action="popstate@window->performance-chart#restoreMode appearance:change@window->performance-chart#refreshTheme"
          data-performance-chart-default-mode-value="<%= money_values_hidden? ? "performance" : "value" %>"
          data-performance-chart-return-only-value="<%= money_values_hidden? %>"
          data-performance-chart-data-value="<%= json_escape(chart_data.to_json) %>"
        >
          <% unless money_values_hidden? %><div class="mb-4 flex justify-end">
            <div class="inline-flex h-[26px] items-center rounded-md border border-coffee/15 bg-oat" role="tablist" aria-label="<%= t(".Chart view") %>">
              <% [[ "value", t(".Value") ], [ "performance", t("Performance") ]].each do |mode, label| %>
                <button
                  type="button"
                  role="tab"
                  data-performance-chart-target="tab"
                  data-performance-chart-mode-param="<%= mode %>"
                  data-action="performance-chart#selectMode keydown->performance-chart#selectModeWithKeyboard"
                  class="relative h-[24px] rounded px-2.5 text-xs font-semibold leading-none text-muted transition-colors duration-150 before:absolute before:-inset-y-[10px] before:inset-x-0 before:content-[''] hover:text-coffee focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel data-[active=true]:bg-caramel-deep data-[active=true]:text-on-accent"
                ><%= label %></button>
              <% end %>
            </div>
          </div><% end %>
          <div class="relative h-56 sm:h-64">
            <canvas data-performance-chart-target="canvas" role="img" aria-label="<%= t(".Portfolio history chart description") %>"></canvas>
          </div>
        </div>
        <details class="mt-4 text-sm">
          <summary class="cursor-pointer font-semibold text-coffee"><%= t(".View exact values") %></summary>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr>
                  <th class="py-2 pr-4 font-semibold"><%= t(".Date") %></th>
                  <th class="py-2 pr-4 font-semibold"><%= t(".Portfolio value") %></th>
                  <th class="py-2 pr-4 font-semibold"><%= t(".Net invested") %></th>
                  <th class="py-2 font-semibold"><%= t(".Return") %></th>
                </tr>
              </thead>
              <tbody>
                <% @series.observations.each do |observation| %>
                  <tr class="border-t border-coffee/10">
                    <td class="py-2 pr-4"><%= l(observation.date, format: :short) %></td>
                    <td class="py-2 pr-4"><%= display_money(observation.market_value) %></td>
                    <td class="py-2 pr-4"><%= display_money(observation.invested_value) %></td>
                    <td class="py-2"><%= value_or_not_available(observation.return_ratio && number_to_percentage(observation.return_ratio * 100, precision: 2)) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @benchmark_chart_data.present? %>
            <h3 class="mt-6 font-semibold text-coffee"><%= t(".Benchmark exact values") %></h3>
            <div class="mt-3 overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr>
                    <th class="py-2 pr-4 font-semibold"><%= t(".Date") %></th>
                    <% @benchmark_chart_data.each do |benchmark| %>
                      <th class="py-2 pr-4 font-semibold"><%= benchmark.fetch(:label) %></th>
                    <% end %>
                  </tr>
                </thead>
                <tbody>
                  <% @series.observations.each_with_index do |observation, index| %>
                    <tr class="border-t border-coffee/10">
                      <td class="py-2 pr-4"><%= l(observation.date, format: :short) %></td>
                      <% @benchmark_chart_data.each do |benchmark| %>
                        <% value = benchmark.fetch(:values)[index] %>
                        <td class="py-2 pr-4"><%= value_or_not_available(value && number_to_percentage(value, precision: 2)) %></td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </details>
      <% elsif @series.pending? %>
        <div class="mt-5 h-56 rounded-xl bg-coffee/5 motion-safe:animate-pulse sm:h-64" aria-hidden="true"></div>
      <% end %>
    </section>
  <% end %>
</section>
