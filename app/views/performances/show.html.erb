<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Portfolio activity") %></p>
      <h1 class="ui-page-title"><%= t("Performance") %></h1>
      <p class="ui-page-intro"><%= t(".Introduction") %></p>
    </div>

    <nav aria-label="<%= t(".Period selection") %>" class="flex flex-wrap gap-2">
      <% PerformancesController::PERIODS.each_key do |period| %>
        <% selected = @selected_period == period %>
        <%= link_to t(".#{period.humanize}"), performance_path(period:), class: "rounded-lg px-3 py-2 text-sm font-semibold #{selected ? "bg-caramel-deep text-white" : "border border-coffee/20 bg-oat-2 text-coffee/80 hover:bg-oat"}" %>
      <% end %>
    </nav>
  </div>

  <% if @performance.missing? %>
    <% title_key, explanation_key = if @historical_data_backfill_pending
      [ ".Historical data is loading", ".Historical data is loading explanation" ]
    else
      [ ".Historical data unavailable", ".Historical data unavailable explanation" ]
    end %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-950" role="status">
      <h2 class="font-semibold"><%= t(title_key) %></h2>
      <p class="mt-2 text-sm leading-6"><%= t(explanation_key) %></p>
    </div>
  <% elsif @performance.empty? %>
    <div class="rounded-2xl border border-dashed border-coffee/20 bg-oat-2 p-8 text-center">
      <p class="font-medium text-coffee"><%= t(".No performance yet") %></p>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty state") %></p>
      <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_trade_path, class: "ui-button ui-button-primary mt-5" %>
    </div>
  <% else %>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <article class="rounded-2xl border border-coffee/10 bg-oat-2 p-5 shadow-sm">
        <p class="text-sm font-medium text-muted"><%= t(".Portfolio value") %></p>
        <p class="mt-2 font-mono text-2xl font-bold tracking-tight text-coffee"><%= @performance.closing_valuation.market_value.format %></p>
        <% market_price_date = @performance.closing_valuation.market_price_as_of %>
        <% exchange_rate_date = @performance.closing_valuation.exchange_rate_as_of %>
        <% if market_price_date && exchange_rate_date && market_price_date != exchange_rate_date %>
          <p class="mt-2 text-xs text-muted"><%= t(".Market prices and FX rates through", market_price_date: l(market_price_date, format: :long), exchange_rate_date: l(exchange_rate_date, format: :long)) %></p>
        <% elsif market_price_date %>
          <p class="mt-2 text-xs text-muted"><%= t(".Prices through", date: l(market_price_date, format: :long)) %></p>
        <% end %>
      </article>

      <article class="rounded-2xl border border-coffee/10 bg-oat-2 p-5 shadow-sm">
        <p class="text-sm font-medium text-muted"><%= t(".Gain or loss") %></p>
        <p class="mt-2 font-mono text-2xl font-bold tracking-tight <%= @performance.gain_loss_amount.negative? ? "text-red-700" : "text-caramel-deep" %>"><%= @performance.gain_loss.format %></p>
        <p class="mt-2 text-xs text-muted"><%= t(".Excluding trade cash flows") %></p>
      </article>

      <article class="rounded-2xl border border-coffee/10 bg-oat-2 p-5 shadow-sm">
        <p class="text-sm font-medium text-muted"><%= t(".Price return") %></p>
        <p class="mt-2 font-mono text-2xl font-bold tracking-tight text-coffee"><%= @performance.return_available? ? number_to_percentage(@performance.return_ratio * 100, precision: 2) : t("Not available") %></p>
        <p class="mt-2 text-xs text-muted"><%= t(".Cash-flow adjusted") %></p>
      </article>

      <article class="rounded-2xl border border-coffee/10 bg-oat-2 p-5 shadow-sm">
        <p class="text-sm font-medium text-muted"><%= t(".Daily value") %></p>
        <p class="mt-2 font-mono text-2xl font-bold tracking-tight text-coffee"><%= @performance.closing_valuation.market_value.format %></p>
        <p class="mt-2 text-xs text-muted"><%= l(@performance.to, format: :long) %></p>
      </article>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-coffee/10 bg-oat-2 p-5 shadow-sm">
        <p class="text-sm font-medium text-muted"><%= t(".Realized gains to date") %></p>
        <p class="mt-2 font-mono text-xl font-bold text-coffee"><%= @performance.closing_valuation.realized_gain.format %></p>
      </article>
      <article class="rounded-2xl border border-coffee/10 bg-oat-2 p-5 shadow-sm">
        <p class="text-sm font-medium text-muted"><%= t(".Unrealized gains to date") %></p>
        <p class="mt-2 font-mono text-xl font-bold text-coffee"><%= @performance.closing_valuation.unrealized_gain.format %></p>
      </article>
      <article class="rounded-2xl border border-coffee/10 bg-oat-2 p-5 shadow-sm">
        <p class="text-sm font-medium text-muted"><%= t(".Net invested") %></p>
        <p class="mt-2 font-mono text-xl font-bold text-coffee"><%= @performance.net_cash_flow.format %></p>
      </article>
    </div>

    <section class="rounded-2xl border border-coffee/10 bg-oat-2 p-5 shadow-sm" aria-labelledby="performance-series-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <h2 id="performance-series-heading" class="text-lg font-semibold text-coffee"><%= t(".Portfolio history") %></h2>
          <p class="mt-1 text-sm text-muted"><%= t(".Portfolio history explanation") %></p>
        </div>
        <span class="text-xs text-muted"><%= l(@series.from, format: :short) %> – <%= l(@series.to, format: :short) %></span>
      </div>

      <% if @series.available? %>
        <div class="relative mt-5" data-controller="performance-chart" data-performance-chart-data-value="<%= json_escape({ labels: @series.observations.map { |observation| l(observation.date, format: :short) }, values: @series.observations.map { |observation| observation.market_value_amount.to_f }, formatted_values: @series.observations.map { |observation| observation.market_value.format }, formatted_performances: @series.observations.map { |observation| observation.return_ratio && "#{observation.return_ratio.positive? ? "↑" : observation.return_ratio.negative? ? "↓" : "→"} #{observation.return_ratio.positive? ? "+" : ""}#{number_to_percentage(observation.return_ratio.to_f * 100, precision: 2)}" }, currency: @performance.closing_valuation.market_value.currency.iso_code }.to_json) %>">
          <div class="relative h-56 sm:h-64">
            <canvas data-performance-chart-target="canvas" role="img" aria-label="<%= t(".Portfolio history chart description") %>"></canvas>
          </div>
        </div>
        <details class="mt-4 text-sm">
            <summary class="cursor-pointer font-semibold text-coffee"><%= t(".View exact values") %></summary>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full text-left">
              <thead><tr><th class="py-2 pr-4 font-semibold"><%= t(".Date") %></th><th class="py-2 font-semibold"><%= t(".Portfolio value") %></th></tr></thead>
              <tbody><% @series.observations.each do |observation| %><tr class="border-t border-coffee/10"><td class="py-2 pr-4"><%= l(observation.date, format: :short) %></td><td class="py-2"><%= observation.market_value&.format || t("Not available") %></td></tr><% end %></tbody>
            </table>
          </div>
        </details>
      <% else %>
        <p class="mt-5 text-sm text-muted" role="status"><%= t(".Portfolio history unavailable") %></p>
      <% end %>
    </section>
  <% end %>
</section>
