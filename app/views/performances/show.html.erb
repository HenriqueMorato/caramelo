<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700"><%= t("Portfolio activity") %></p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl"><%= t("Performance") %></h1>
      <p class="text-lg leading-8 text-slate-600"><%= t(".Introduction") %></p>
    </div>

    <nav aria-label="<%= t(".Period selection") %>" class="flex flex-wrap gap-2">
      <% PerformancesController::PERIODS.each_key do |period| %>
        <% selected = @selected_period == period %>
        <%= link_to t(".#{period.humanize}"), performance_path(period:), class: "rounded-lg px-3 py-2 text-sm font-semibold #{selected ? "bg-emerald-700 text-white" : "border border-slate-300 bg-white text-slate-700 hover:bg-slate-50"}" %>
      <% end %>
    </nav>
  </div>

  <% if @performance.missing? %>
    <% title_key, explanation_key = if @historical_data_backfill_pending
      [ ".Historical data is loading", ".Historical data is loading explanation" ]
    else
      [ ".Historical data unavailable", ".Historical data unavailable explanation" ]
    end %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-950" role="status">
      <h2 class="font-semibold"><%= t(title_key) %></h2>
      <p class="mt-2 text-sm leading-6"><%= t(explanation_key) %></p>
    </div>
  <% elsif @performance.empty? %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="font-medium text-slate-900"><%= t(".No performance yet") %></p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= t(".Empty state") %></p>
      <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_trade_path, class: "mt-5 inline-flex rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
    </div>
  <% else %>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-600"><%= t(".Portfolio value") %></p>
        <p class="mt-2 font-mono text-2xl font-bold tracking-tight text-slate-950"><%= @performance.closing_valuation.market_value.format %></p>
        <% if @performance.closing_valuation.market_data_as_of %>
          <p class="mt-2 text-xs text-slate-500"><%= t(".Prices through", date: l(@performance.closing_valuation.market_data_as_of, format: :long)) %></p>
        <% end %>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-600"><%= t(".Gain or loss") %></p>
        <p class="mt-2 font-mono text-2xl font-bold tracking-tight <%= @performance.gain_loss_amount.negative? ? "text-red-700" : "text-emerald-700" %>"><%= @performance.gain_loss.format %></p>
        <p class="mt-2 text-xs text-slate-500"><%= t(".Excluding trade cash flows") %></p>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-600"><%= t(".Price return") %></p>
        <p class="mt-2 font-mono text-2xl font-bold tracking-tight text-slate-950"><%= @performance.return_available? ? number_to_percentage(@performance.return_ratio * 100, precision: 2) : t("Not available") %></p>
        <p class="mt-2 text-xs text-slate-500"><%= t(".Cash-flow adjusted") %></p>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-600"><%= t(".Daily value") %></p>
        <p class="mt-2 font-mono text-2xl font-bold tracking-tight text-slate-950"><%= @performance.closing_valuation.market_value.format %></p>
        <p class="mt-2 text-xs text-slate-500"><%= l(@performance.to, format: :long) %></p>
      </article>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-600"><%= t(".Realized gains to date") %></p>
        <p class="mt-2 font-mono text-xl font-bold text-slate-950"><%= @performance.closing_valuation.realized_gain.format %></p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-600"><%= t(".Unrealized gains to date") %></p>
        <p class="mt-2 font-mono text-xl font-bold text-slate-950"><%= @performance.closing_valuation.unrealized_gain.format %></p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-600"><%= t(".Net invested") %></p>
        <p class="mt-2 font-mono text-xl font-bold text-slate-950"><%= @performance.net_cash_flow.format %></p>
      </article>
    </div>
  <% end %>
</section>
