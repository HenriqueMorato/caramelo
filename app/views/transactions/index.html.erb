<% content_for :title, "Transactions · #{t("application.name")}" %>

<section class="max-w-3xl space-y-6">
  <div class="space-y-3">
    <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700">Portfolio activity</p>
    <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Transactions</h1>
    <p class="text-lg leading-8 text-slate-600">
      Buys, sells, dividends, deposits, and withdrawals will be recorded here in a future milestone.
    </p>
  </div>

  <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
    <p class="font-medium text-slate-900">No transaction tracking yet</p>
    <p class="mt-2 text-sm leading-6 text-slate-600">
      This placeholder establishes the navigation and ownership context without introducing financial-domain data.
    </p>
  </div>
</section>
