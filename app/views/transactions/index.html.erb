<% content_for :title, t(".Page title", application: t("caramelo")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Portfolio activity") %></p>
      <h1 class="ui-page-title"><%= t(".Heading") %></h1>
      <p class="ui-page-intro"><%= t(".Introduction") %></p>
    </div>

    <%= render "add_menu", trade_path: new_trade_path, income_path: new_corporate_action_path,
      test_id: "add-transaction-menu" %>
  </div>

  <%= render "history",
    transactions: @transactions,
    activity: @activity,
    has_transactions: @has_transactions,
    all_filter_path: transactions_path,
    trades_filter_path: transactions_path(activity: "trades"),
    income_filter_path: transactions_path(activity: "income"),
    empty_title: t(".No activity yet"),
    empty_body: t(".Empty state") %>
</section>
