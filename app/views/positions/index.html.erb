<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Portfolio holdings") %></p>
      <h1 class="ui-page-title"><%= t(".Heading") %></h1>
      <p class="ui-page-intro"><%= t(".Subheading") %></p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <% if @has_refreshable_market_prices %>
        <%= button_to t("Refresh prices"), current_market_price_refresh_path, class: "ui-button ui-button-primary", form_class: "inline-flex", data: { turbo_submits_with: t("Refreshing") } %>
      <% end %>

      <% if @has_closed_positions %>
        <% if @show_closed %>
          <%= link_to t(".Show open positions"), positions_path, class: "ui-button ui-button-secondary" %>
        <% else %>
          <%= link_to t(".Include closed positions"), positions_path(closed: 1), class: "ui-button ui-button-secondary" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div data-controller="grouping" data-action="keydown.esc->grouping#closeMenus click@window->grouping#closeOnOutside">
    <%= form_with url: positions_path, method: :get, data: { grouping_target: "form", turbo_frame: "positions-list" } do |form| %>
      <%= hidden_field_tag :closed, "1" if @show_closed %>
      <%= hidden_field_tag :group_by, @group_by, data: { grouping_target: "primaryInput" } %>
      <%= hidden_field_tag :subgroup_by, @subgroup_by, data: { grouping_target: "secondaryInput" } %>
      <div class="ui-card flex flex-wrap items-center gap-3 p-4 sm:p-5">
        <span class="ui-eyebrow"><%= t(".Organize") %></span>
        <div class="relative">
          <button type="button" data-grouping-target="primaryButton" data-grouping-menu="primary" data-action="grouping#toggle" aria-expanded="false" class="ui-button ui-button-secondary"><%= t(".Group by") %>: <span class="ml-1" data-grouping-target="primaryLabel"><%= @group_by ? t(".Group by #{@group_by}") : t(".No grouping") %></span></button>
          <div data-grouping-target="primaryMenu" data-grouping-menu="primary" hidden class="absolute left-0 z-20 mt-2 min-w-48 rounded-xl border border-coffee/10 bg-oat-2 p-1 shadow-lg" role="menu">
            <% grouping_options.each do |label, value| %>
              <button type="button" data-grouping-value="<%= value %>" data-action="grouping#choose" class="block w-full rounded-lg px-3 py-2 text-left text-sm text-coffee hover:bg-oat" role="menuitem"><%= label %></button>
            <% end %>
          </div>
        </div>
        <div class="relative">
          <button type="button" data-grouping-target="secondaryButton" data-grouping-menu="secondary" data-action="grouping#toggle" aria-expanded="false" class="ui-button ui-button-secondary"><%= t(".Then by") %>: <span class="ml-1" data-grouping-target="secondaryLabel"><%= @subgroup_by ? t(".Group by #{@subgroup_by}") : t(".No grouping") %></span></button>
          <div data-grouping-target="secondaryMenu" data-grouping-menu="secondary" hidden class="absolute left-0 z-20 mt-2 min-w-48 rounded-xl border border-coffee/10 bg-oat-2 p-1 shadow-lg" role="menu">
            <% grouping_options.each do |label, value| %>
              <button type="button" data-grouping-value="<%= value %>" data-action="grouping#choose" class="block w-full rounded-lg px-3 py-2 text-left text-sm text-coffee hover:bg-oat" role="menuitem"><%= label %></button>
            <% end %>
          </div>
        </div>
        <button type="button" data-action="grouping#clear" class="ui-button ui-button-secondary"><%= t(".Clear") %></button>
      </div>
    <% end %>

    <%= turbo_frame_tag "positions-list", class: "mt-6 block" do %>
      <% if @positions.any? %>
        <% if @group_by %>
          <div class="space-y-6">
            <% @position_groups.each do |group_name, grouped| %>
              <section aria-labelledby="positions-<%= @group_by %>-<%= group_name.parameterize %>" class="space-y-3">
                <h2 id="positions-<%= @group_by %>-<%= group_name.parameterize %>" class="ui-eyebrow px-1"><%= grouping_label(@group_by, group_name) %></h2>
                <% if @subgroup_by %>
                  <div class="space-y-4 pl-3"><% grouped.each do |subgroup_name, positions| %><div><h3 class="mb-2 text-sm font-semibold text-muted"><%= grouping_label(@subgroup_by, subgroup_name) %></h3><%= render "table", positions: %></div><% end %></div>
                <% else %>
                  <%= render "table", positions: grouped %>
                <% end %>
              </section>
            <% end %>
          </div>
        <% else %>
          <%= render "table", positions: @positions %>
        <% end %>
      <% elsif @position_results.any? %>
        <div class="ui-empty-state">
          <p class="font-medium text-coffee"><%= t(".No open positions") %></p>
          <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Closed positions hidden") %></p>
        </div>
      <% else %>
        <div class="ui-empty-state">
          <p class="font-medium text-coffee"><%= t(".No positions yet") %></p>
          <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty state") %></p>
          <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_trade_path, class: "ui-button ui-button-primary mt-5" %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
