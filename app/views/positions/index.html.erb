<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700"><%= t("Portfolio holdings") %></p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl"><%= t("Positions") %></h1>
      <p class="text-lg leading-8 text-slate-600"><%= t(".Introduction") %></p>
    </div>

    <% if @has_closed_positions %>
      <% if @show_closed %>
        <%= link_to t(".Show open positions"), positions_path, class: "inline-flex w-fit items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" %>
      <% else %>
        <%= link_to t(".Include closed positions"), positions_path(closed: 1), class: "inline-flex w-fit items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" %>
      <% end %>
    <% end %>
  </div>

  <% if @visible_entries.any? %>
    <div class="space-y-4">
      <% @visible_entries.each do |entry| %>
        <article class="rounded-2xl border bg-white p-5 shadow-sm transition sm:p-6 <%= entry.invalid? ? "border-red-300" : "border-slate-200 hover:border-slate-300 hover:shadow-md" %>">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-mono text-xl font-bold text-slate-950">
                  <%= link_to entry.instrument.ticker, entry.instrument, class: "hover:text-emerald-700" %>
                </h2>
                <span class="rounded-md bg-slate-100 px-2 py-1 font-mono text-xs font-semibold text-slate-600"><%= entry.instrument.exchange %></span>
                <% if entry.invalid? %>
                  <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-800"><%= t("Needs attention") %></span>
                <% elsif entry.position.closed? %>
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"><%= t("Closed") %></span>
                <% else %>
                  <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800"><%= t("Open") %></span>
                <% end %>
              </div>
              <p class="mt-2 flex flex-wrap items-baseline gap-1.5 text-sm text-slate-600">
                <span><%= entry.instrument.name %></span>
                <span aria-hidden="true" class="text-slate-300">·</span>
                <span class="font-mono text-xs font-semibold text-slate-400"><%= entry.instrument.currency %></span>
              </p>
            </div>

            <% if entry.invalid? %>
              <div class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">
                <p class="font-semibold"><%= t(".Position could not be calculated") %></p>
                <p class="mt-1"><%= t(".Sales exceed purchases", date: l(entry.error.trade.traded_on, format: :long)) %></p>
              </div>
            <% else %>
              <dl class="grid grid-cols-3 divide-x divide-slate-200 rounded-xl bg-slate-50 py-3 text-center ring-1 ring-inset ring-slate-100 lg:min-w-[36rem]">
                <div class="px-2 sm:px-4">
                  <dt class="flex min-h-8 items-center justify-center text-[0.65rem] font-semibold uppercase leading-4 tracking-[0.08em] text-slate-500 sm:text-xs"><%= t("Quantity") %></dt>
                  <dd class="mt-1.5 font-mono text-base font-semibold text-slate-950"><%= format_quantity entry.position.quantity %></dd>
                </div>
                <div class="px-2 sm:px-4">
                  <dt class="flex min-h-8 items-center justify-center text-[0.65rem] font-semibold uppercase leading-4 tracking-[0.08em] text-slate-500 sm:text-xs"><%= t("Average cost") %></dt>
                  <dd class="mt-1.5 font-mono text-base font-semibold text-slate-950"><%= format_currency_amount entry.position.average_unit_cost, entry.instrument.currency %></dd>
                </div>
                <div class="px-2 sm:px-4">
                  <dt class="flex min-h-8 items-center justify-center text-[0.65rem] font-semibold uppercase leading-4 tracking-[0.08em] text-slate-500 sm:text-xs"><%= t("Cost basis") %></dt>
                  <dd class="mt-1.5 font-mono text-base font-semibold text-slate-950"><%= entry.position.cost_basis.format %></dd>
                </div>
              </dl>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% elsif @position_entries.any? %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="font-medium text-slate-900"><%= t(".No open positions") %></p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= t(".Closed positions hidden") %></p>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="font-medium text-slate-900"><%= t(".No positions yet") %></p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= t(".Empty state") %></p>
      <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_trade_path, class: "mt-5 inline-flex rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
    </div>
  <% end %>
</section>
