<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Portfolio holdings") %></p>
      <h1 class="ui-page-title"><%= t(".Heading") %></h1>
      <p class="ui-page-intro"><%= t(".Subheading") %></p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <% if @has_refreshable_market_prices %>
        <%= button_to t("Refresh prices"), current_market_price_refresh_path, class: "ui-button ui-button-primary", form_class: "inline-flex", data: { turbo_submits_with: t("Refreshing") } %>
      <% end %>

      <% if @has_closed_positions %>
        <% if @show_closed %>
          <%= link_to t(".Show open positions"), positions_path, class: "ui-button ui-button-secondary" %>
        <% else %>
          <%= link_to t(".Include closed positions"), positions_path(closed: 1), class: "ui-button ui-button-secondary" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @positions.any? %>
    <div class="ui-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[50rem] text-left">
          <thead class="border-b border-coffee/10 bg-oat text-[0.65rem] font-semibold uppercase tracking-[0.08em] text-muted sm:text-xs">
            <tr>
              <th scope="col" class="px-5 py-3 font-semibold sm:px-6"><%= t(".Position") %></th>
              <th scope="col" class="px-4 py-3 text-right font-semibold"><%= t("Quantity") %></th>
              <th scope="col" class="px-4 py-3 text-right font-semibold"><%= t("Average cost") %></th>
              <th scope="col" class="px-4 py-3 text-right font-semibold"><%= t("Cost basis") %></th>
              <th scope="col" class="px-4 py-3 text-right font-semibold"><%= t("Market value") %></th>
              <th scope="col" class="px-5 py-3 text-right font-semibold sm:px-6"><%= t("Current price") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-coffee/10">
            <% @positions.each do |presenter| %>
              <tr class="<%= presenter.invalid? ? "bg-red-50/50" : "hover:bg-oat/60" %>">
                <th scope="row" class="min-w-56 px-5 py-4 font-normal sm:px-6">
                  <div class="flex flex-wrap items-center gap-2">
                    <h2 class="font-mono text-base font-bold text-coffee"><%= link_to presenter.instrument.ticker, presenter.instrument, class: "hover:text-caramel-deep" %></h2>
                    <span class="font-mono text-xs font-semibold text-muted"><%= presenter.instrument.exchange %></span>
                    <% if presenter.invalid? %>
                      <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-800"><%= t("Needs attention") %></span>
                    <% elsif presenter.position.closed? %>
                      <span class="rounded-full bg-coffee/5 px-2 py-0.5 text-xs font-semibold text-coffee/80"><%= t("Closed") %></span>
                    <% else %>
                      <span class="rounded-full bg-caramel/15 px-2 py-0.5 text-xs font-semibold text-coffee"><%= t("Open") %></span>
                    <% end %>
                  </div>
                  <p class="mt-1 flex items-baseline gap-1 text-sm text-muted">
                    <span><%= presenter.instrument.name %></span>
                    <span aria-hidden="true" class="text-coffee/20">·</span>
                    <span class="font-mono text-xs font-semibold text-muted/70"><%= presenter.instrument.currency %></span>
                  </p>
                </th>
                <% if presenter.invalid? %>
                  <td colspan="5" class="px-4 py-4 text-sm text-red-900">
                    <div role="alert">
                      <p class="font-semibold"><%= t(".Position could not be calculated") %></p>
                      <p class="mt-1"><%= t(".Sales exceed purchases", date: l(presenter.error.trade.traded_on, format: :long)) %></p>
                    </div>
                  </td>
                <% else %>
                  <td class="whitespace-nowrap px-4 py-4 text-right font-mono text-sm font-semibold tabular-nums text-coffee"><%= format_quantity presenter.position.quantity %></td>
                  <td class="whitespace-nowrap px-4 py-4 text-right font-mono text-sm font-semibold tabular-nums text-coffee"><%= format_currency_amount presenter.position.average_unit_cost, presenter.instrument.currency %></td>
                  <td class="whitespace-nowrap px-4 py-4 text-right font-mono text-sm font-semibold tabular-nums text-coffee"><%= presenter.position.cost_basis.format %></td>
                  <td class="whitespace-nowrap px-4 py-4 text-right font-mono text-sm font-semibold tabular-nums text-coffee"><%= presenter.valuation.available? ? presenter.valuation.market_value.format : t("Value unavailable") %></td>
                  <td class="px-5 py-4 text-right sm:px-6"><%= render "current_market_prices/current_market_price", market_price: presenter.market_price, refreshing: false %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% elsif @position_results.any? %>
    <div class="ui-empty-state">
      <p class="font-medium text-coffee"><%= t(".No open positions") %></p>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Closed positions hidden") %></p>
    </div>
  <% else %>
    <div class="ui-empty-state">
      <p class="font-medium text-coffee"><%= t(".No positions yet") %></p>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t(".Empty state") %></p>
      <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_trade_path, class: "mt-5 inline-flex rounded-xl bg-caramel-deep px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-coffee" %>
    </div>
  <% end %>
</section>
