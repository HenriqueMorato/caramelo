<% content_for :title, t(".Page title", application: t("LocalFolio")) %>

<section class="space-y-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700"><%= t("Portfolio holdings") %></p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl"><%= t("Positions") %></h1>
      <p class="text-lg leading-8 text-slate-600"><%= t(".Introduction") %></p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <% if @has_refreshable_market_prices %>
        <%= button_to t("Refresh prices"), current_market_price_refresh_path, class: "inline-flex w-fit items-center rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800", form_class: "inline-flex", data: { turbo_submits_with: t("Refreshing") } %>
      <% end %>

      <% if @has_closed_positions %>
        <% if @show_closed %>
          <%= link_to t(".Show open positions"), positions_path, class: "inline-flex w-fit items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" %>
        <% else %>
          <%= link_to t(".Include closed positions"), positions_path(closed: 1), class: "inline-flex w-fit items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @positions.any? %>
    <div class="space-y-4">
      <% @positions.each do |presenter| %>
        <article class="rounded-2xl border bg-white p-5 shadow-sm transition sm:p-6 <%= presenter.invalid? ? "border-red-300" : "border-slate-200 hover:border-slate-300 hover:shadow-md" %>">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-mono text-xl font-bold text-slate-950">
                  <%= link_to presenter.instrument.ticker, presenter.instrument, class: "hover:text-emerald-700" %>
                </h2>
                <span class="rounded-md bg-slate-100 px-2 py-1 font-mono text-xs font-semibold text-slate-600"><%= presenter.instrument.exchange %></span>
                <% if presenter.invalid? %>
                  <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-800"><%= t("Needs attention") %></span>
                <% elsif presenter.position.closed? %>
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"><%= t("Closed") %></span>
                <% else %>
                  <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800"><%= t("Open") %></span>
                <% end %>
              </div>
              <p class="mt-2 flex flex-wrap items-baseline gap-1.5 text-sm text-slate-600">
                <span><%= presenter.instrument.name %></span>
                <span aria-hidden="true" class="text-slate-300">·</span>
                <span class="font-mono text-xs font-semibold text-slate-400"><%= presenter.instrument.currency %></span>
              </p>
            </div>

            <div class="flex flex-col gap-3 xl:flex-row xl:items-center">
              <% if presenter.invalid? %>
                <div class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">
                  <p class="font-semibold"><%= t(".Position could not be calculated") %></p>
                  <p class="mt-1"><%= t(".Sales exceed purchases", date: l(presenter.error.trade.traded_on, format: :long)) %></p>
                </div>
              <% else %>
                <%= render "positions/metrics", position: presenter.position, instrument: presenter.instrument %>
              <% end %>

              <%= render "current_market_prices/current_market_price", market_price: presenter.market_price, refreshing: false %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% elsif @position_results.any? %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="font-medium text-slate-900"><%= t(".No open positions") %></p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= t(".Closed positions hidden") %></p>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="font-medium text-slate-900"><%= t(".No positions yet") %></p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= t(".Empty state") %></p>
      <%= link_to t("actions.Add", model: Trade.model_name.human.downcase), new_trade_path, class: "mt-5 inline-flex rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" %>
    </div>
  <% end %>
</section>
