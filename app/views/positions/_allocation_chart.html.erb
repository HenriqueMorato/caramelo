<%# locals: (allocation:, entries:, id:, title:, description:) %>

<% chart_data = {
  labels: entries.map(&:label),
  values: entries.map { |entry| entry.ratio.to_s("F") },
  color_keys: entries.map(&:color_key)
} %>

<article class="ui-card p-5 sm:p-6" aria-labelledby="<%= id %>-heading">
  <div>
    <h3 id="<%= id %>-heading" class="font-display text-xl font-semibold tracking-tight text-coffee"><%= title %></h3>
    <p class="mt-1 text-sm leading-5 text-muted"><%= description %></p>
  </div>

  <div class="mt-5 flex justify-center">
    <div
      class="relative h-64 w-64 sm:h-72 sm:w-72"
      data-controller="allocation-chart"
      data-action="appearance:change@window->allocation-chart#refreshTheme"
      data-allocation-chart-data-value="<%= json_escape(chart_data.to_json) %>"
    >
      <canvas data-allocation-chart-target="canvas" role="img" aria-label="<%= title %>"></canvas>
    </div>
  </div>

  <details class="mt-4 border-t border-coffee/10 pt-3 text-xs text-muted">
    <summary class="w-fit cursor-pointer rounded font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel focus-visible:ring-offset-2"><%= t("positions.index.View exact allocation values") %></summary>
    <div class="mt-3 max-h-52 overflow-y-auto pr-1">
      <table class="w-full text-left">
        <thead>
          <tr>
            <th scope="col" class="py-2 pr-3 font-semibold"><%= t("positions.index.Allocation") %></th>
            <th scope="col" class="py-2 pr-3 text-right font-semibold"><%= t("positions.index.Share") %></th>
            <th scope="col" class="py-2 text-right font-semibold"><%= t("Market value") %></th>
          </tr>
        </thead>
        <tbody>
          <% entries.each do |entry| %>
            <tr class="border-t border-coffee/10">
              <th scope="row" class="py-2 pr-3 font-medium text-coffee"><%= entry.label %></th>
              <td class="py-2 pr-3 text-right font-mono tabular-nums"><%= number_to_percentage(entry.ratio * 100, precision: 2) %></td>
              <td class="py-2 text-right font-mono tabular-nums"><%= display_money(Money.from_amount(entry.amount, allocation.currency)) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </details>
</article>
