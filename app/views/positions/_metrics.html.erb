<%# locals: (position:, instrument:) %>

<dl class="grid grid-cols-3 divide-x divide-slate-200 rounded-xl bg-slate-50 py-3 text-center ring-1 ring-inset ring-slate-100 lg:min-w-[36rem]">
  <div class="px-2 sm:px-4">
    <dt class="flex min-h-8 items-center justify-center text-[0.65rem] font-semibold uppercase leading-4 tracking-[0.08em] text-slate-500 sm:text-xs"><%= t("Quantity") %></dt>
    <dd class="mt-1.5 font-mono text-base font-semibold text-slate-950"><%= format_quantity position.quantity %></dd>
  </div>
  <div class="px-2 sm:px-4">
    <dt class="flex min-h-8 items-center justify-center text-[0.65rem] font-semibold uppercase leading-4 tracking-[0.08em] text-slate-500 sm:text-xs"><%= t("Average cost") %></dt>
    <dd class="mt-1.5 font-mono text-base font-semibold text-slate-950"><%= format_currency_amount position.average_unit_cost, instrument.currency %></dd>
  </div>
  <div class="px-2 sm:px-4">
    <dt class="flex min-h-8 items-center justify-center text-[0.65rem] font-semibold uppercase leading-4 tracking-[0.08em] text-slate-500 sm:text-xs"><%= t("Cost basis") %></dt>
    <dd class="mt-1.5 font-mono text-base font-semibold text-slate-950"><%= position.cost_basis.format %></dd>
  </div>
</dl>
