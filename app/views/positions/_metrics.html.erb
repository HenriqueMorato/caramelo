<%# locals: (position:, instrument:, valuation:, market_price:) %>

<dl class="mt-5 grid gap-4 text-center sm:grid-cols-2 lg:grid-cols-5">
  <div class="min-w-0">
    <dt class="ui-eyebrow"><%= t("Quantity") %></dt>
    <dd class="mt-1 font-mono text-base font-semibold tabular-nums text-coffee"><%= format_quantity position.quantity %></dd>
  </div>
  <div class="min-w-0">
    <dt class="ui-eyebrow"><%= t("Average cost") %></dt>
    <dd class="mt-1 font-mono text-base font-semibold tabular-nums text-coffee"><%= format_currency_amount position.average_unit_cost, instrument.currency %></dd>
  </div>
  <div class="min-w-0">
    <dt class="ui-eyebrow"><%= t("Current price") %></dt>
    <dd class="mt-1 flex min-h-6 items-center justify-center font-mono text-base font-semibold tabular-nums text-coffee">
      <%= render "current_market_prices/current_market_price", market_price:, refreshing: false, compact: true %>
    </dd>
  </div>
  <div class="min-w-0">
    <dt class="ui-eyebrow"><%= t("Cost basis") %></dt>
    <dd class="mt-1 font-mono text-base font-semibold tabular-nums text-coffee"><%= display_money(position.cost_basis) %></dd>
  </div>
  <div class="min-w-0">
    <dt class="ui-eyebrow flex items-center justify-center gap-1">
      <%= t("Market value") %>
      <% if valuation.stale? %>
        <span class="ui-badge ui-badge-stale px-1.5 py-0.5 text-[0.6rem] normal-case tracking-normal"><%= t("Stale") %></span>
      <% end %>
    </dt>
    <dd class="mt-1 font-mono text-base font-semibold tabular-nums text-coffee"><%= valuation.available? ? display_money(valuation.market_value) : t("Value unavailable") %></dd>
  </div>
</dl>
