<div class="mx-auto w-full max-w-lg">
  <% if alert = flash[:alert] %>
    <p class="ui-form-errors mb-5" id="alert"><%= alert %></p>
  <% end %>

  <h1 class="ui-page-title"><%= t(".Forgot your password?") %></h1>

  <%= form_with url: passwords_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", spellcheck: false, placeholder: t(".Email placeholder"), value: params[:email_address], class: "ui-field" %>
    </div>

    <div class="inline">
      <%= form.submit t(".Email reset instructions"), class: "ui-button ui-button-primary min-h-11 w-full cursor-pointer sm:w-auto" %>
    </div>
  <% end %>
</div>
