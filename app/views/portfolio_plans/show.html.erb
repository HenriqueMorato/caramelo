<% content_for :title, t("portfolio_plans.show.Page title", application: t("caramelo")) %>

<section class="space-y-8">
  <div class="ui-page-header">
    <div class="ui-page-header-copy">
      <p class="ui-eyebrow"><%= t("Portfolio planning") %></p>
      <h1 class="ui-page-title"><%= t("portfolio_plans.show.Heading") %></h1>
      <p class="ui-page-intro"><%= t("portfolio_plans.show.Introduction") %></p>
    </div>
    <%= link_to t("portfolio_plans.show.Back to goals"), investment_goals_path, class: "ui-button ui-button-secondary w-fit" %>
  </div>

  <% if @plan.errors.any? %>
    <div class="ui-form-errors" role="alert">
      <p class="font-semibold"><%= t("portfolio_plans.show.Could not save") %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @plan.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @calculation_error %>
    <div class="ui-form-errors" role="alert"><%= @calculation_error %></div>
  <% end %>

  <section class="ui-card p-6 sm:p-8" aria-labelledby="portfolio-plan-targets-heading">
    <div class="max-w-2xl">
      <p class="ui-eyebrow"><%= t("portfolio_plans.show.Target mix") %></p>
      <h2 id="portfolio-plan-targets-heading" class="mt-2 font-display text-2xl font-semibold tracking-tight text-coffee"><%= t("portfolio_plans.show.Target heading") %></h2>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t("portfolio_plans.show.Target explanation") %></p>
    </div>

    <% if @groups.any? %>
      <%= form_with scope: :portfolio_allocation, url: portfolio_plan_path, method: :patch, class: "mt-8 space-y-6", data: { controller: "portfolio-allocation-form" } do |form| %>
        <div class="space-y-4">
          <% @groups.each do |asset_type_key, position_results| %>
            <% asset_target = @asset_targets[asset_type_key] %>
            <article class="rounded-2xl border border-coffee/10 bg-paper/40 p-4 sm:p-5">
              <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                  <h3 class="font-semibold text-coffee"><%= AssetType.label_for(asset_type_key) %></h3>
                  <p class="mt-1 text-sm text-muted"><%= t("portfolio_plans.show.Instrument count", selected: position_results.count { |result| @instrument_targets.key?(result.instrument.id) }, total: position_results.length) %></p>
                </div>
                <div class="w-32">
                  <%= label_tag "portfolio_allocation_asset_targets_#{asset_type_key}", t("portfolio_plans.show.Asset target"), class: "block text-xs font-semibold uppercase tracking-wide text-muted" %>
                  <%= number_field_tag "portfolio_allocation[asset_targets][#{asset_type_key}]", @submitted_asset_targets&.fetch(asset_type_key, nil) || asset_target&.target_percentage&.to_s, id: "portfolio_allocation_asset_targets_#{asset_type_key}", min: 0, max: 100, step: 0.01, inputmode: "decimal", data: { portfolio_allocation_form_target: "assetField", action: "input->portfolio-allocation-form#balance" }, class: "ui-field mt-2 text-right font-mono tabular-nums", placeholder: "0" %>
                </div>
              </div>
              <div class="mt-4 space-y-3 border-t border-coffee/10 pt-4">
                <% position_results.each do |position_result| %>
                  <% instrument = position_result.instrument %>
                  <% target = @instrument_targets[instrument.id] %>
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="min-w-0">
                      <p class="truncate font-medium text-coffee"><%= instrument.ticker %></p>
                      <p class="truncate text-xs text-muted"><%= instrument.name %> · <%= instrument.exchange %></p>
                    </div>
                    <div class="w-32">
                      <%= label_tag "portfolio_allocation_instrument_targets_#{instrument.id}", t("portfolio_plans.show.Instrument target"), class: "sr-only" %>
                      <%= number_field_tag "portfolio_allocation[instrument_targets][#{instrument.id}]", @submitted_instrument_targets&.fetch(instrument.id.to_s, nil) || target&.target_percentage&.to_s, id: "portfolio_allocation_instrument_targets_#{instrument.id}", min: 0, max: 100, step: 0.01, inputmode: "decimal", class: "ui-field text-right font-mono tabular-nums" %>
                    </div>
                  </div>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <%= form.submit t("portfolio_plans.show.Save targets"), class: "ui-button ui-button-primary cursor-pointer", data: { turbo_submits_with: t("portfolio_plans.show.Saving") } %>
          <span class="text-sm text-muted"><%= t("portfolio_plans.show.Total reminder") %></span>
        </div>
      <% end %>
    <% else %>
      <div class="ui-empty-state mt-8">
        <p class="font-medium text-coffee"><%= t("portfolio_plans.show.No holdings") %></p>
        <p class="mt-2 text-sm leading-6 text-muted"><%= t("portfolio_plans.show.No holdings explanation") %></p>
        <%= link_to t("portfolio_plans.show.Add a trade"), new_trade_path, class: "ui-button ui-button-primary mt-5" %>
      </div>
    <% end %>
  </section>

  <%= turbo_frame_tag "portfolio-plan-calculation", class: "ui-card block p-6 sm:p-8", aria: { labelledby: "portfolio-plan-calculation-heading" } do %>
    <div class="max-w-2xl">
      <p class="ui-eyebrow"><%= t("portfolio_plans.show.Next move") %></p>
      <h2 id="portfolio-plan-calculation-heading" class="mt-2 font-display text-2xl font-semibold tracking-tight text-coffee"><%= t("portfolio_plans.show.Calculation heading") %></h2>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t("portfolio_plans.show.Calculation explanation") %></p>
    </div>

    <%= form_with url: portfolio_plan_path, method: :get, class: "mt-6 grid gap-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] sm:items-end", data: { turbo_frame: "portfolio-plan-calculation", turbo_action: "advance" } do |form| %>
      <div>
        <%= form.label :contribution, t("portfolio_plans.show.New money", currency: current_account.reporting_currency), class: "block text-sm font-semibold text-coffee" %>
        <%= form.number_field :contribution, value: @contribution, min: 0, step: 0.01, inputmode: "decimal", class: "ui-field mt-2 font-mono tabular-nums", placeholder: "0" %>
      </div>
      <div>
        <%= form.label :mode, t("portfolio_plans.show.Mode"), class: "block text-sm font-semibold text-coffee" %>
        <%= form.custom_select :mode, [[t("portfolio_plans.show.Buy only"), "buy_only"], [t("portfolio_plans.show.Full rebalance"), "full_rebalance"]], { selected: @mode }, class: "mt-2 block w-full rounded-xl border border-coffee/20 bg-oat-2 px-4 py-3 text-coffee shadow-sm focus:border-caramel focus:outline-none focus:ring-2 focus:ring-caramel/20" %>
      </div>
      <%= button_tag t("portfolio_plans.show.Calculate"), type: "submit", name: nil, class: "ui-button ui-button-primary cursor-pointer" %>
    <% end %>

    <% if @calculation&.available? %>
      <dl class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="<%= t("portfolio_plans.show.Summary") %>">
        <% [[t("portfolio_plans.show.Current value"), @calculation.current_amount], [t("portfolio_plans.show.Investable money"), @calculation.investable_amount], [t("portfolio_plans.show.Cash reserve"), @calculation.reserve_amount], [t("portfolio_plans.show.Projected value"), @calculation.projected_amount]].each do |label, amount| %>
          <div class="ui-summary-item">
            <dt><%= label %></dt>
            <dd class="font-mono tabular-nums"><%= display_money(Money.from_amount(amount, @calculation.currency)) %></dd>
          </div>
        <% end %>
      </dl>

      <div class="mt-8 overflow-x-auto rounded-2xl border border-coffee/10">
        <table class="w-full min-w-[720px] text-sm">
          <caption class="sr-only"><%= t("portfolio_plans.show.Comparison table") %></caption>
          <thead class="bg-paper/60 text-left text-xs uppercase tracking-wide text-muted">
            <tr>
              <th class="px-4 py-3 font-semibold"><%= t("portfolio_plans.show.Instrument") %></th>
              <th class="px-4 py-3 text-right font-semibold"><%= t("portfolio_plans.show.Current percentage") %></th>
              <th class="px-4 py-3 text-right font-semibold"><%= t("portfolio_plans.show.Target percentage") %></th>
              <th class="px-4 py-3 text-right font-semibold"><%= t("portfolio_plans.show.Difference") %></th>
              <th class="px-4 py-3 text-right font-semibold"><%= t("portfolio_plans.show.Suggested") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-coffee/10">
            <% @calculation.comparisons.each do |comparison| %>
              <tr>
                <th class="px-4 py-3 text-left font-medium text-coffee"><%= comparison.instrument.ticker %></th>
                <td class="px-4 py-3 text-right font-mono tabular-nums"><%= number_to_percentage(comparison.current_percentage, precision: 2) %></td>
                <td class="px-4 py-3 text-right font-mono tabular-nums"><%= number_to_percentage(comparison.target_percentage, precision: 2) %></td>
                <td class="px-4 py-3 text-right font-mono tabular-nums"><%= display_money(Money.from_amount(comparison.difference_amount, @calculation.currency)) %></td>
                <td class="px-4 py-3 text-right font-medium <%= comparison.buy? ? "text-positive" : comparison.sell? ? "text-negative" : "text-muted" %>">
                  <% suggested_move = if comparison.below_minimum?
                    t("portfolio_plans.show.Below minimum")
                  elsif comparison.sell?
                    t("portfolio_plans.show.Action", action: comparison.action.to_s.humanize, quantity: number_with_precision(comparison.quantity, precision: 8, strip_insignificant_zeros: true), amount: display_money(Money.from_amount(comparison.estimated_amount, @calculation.currency)))
                  elsif comparison.overweight?
                    t("portfolio_plans.show.Over target")
                  elsif comparison.none?
                    t("portfolio_plans.show.On target")
                  else
                    t("portfolio_plans.show.Action", action: comparison.action.to_s.humanize, quantity: number_with_precision(comparison.quantity, precision: 8, strip_insignificant_zeros: true), amount: display_money(Money.from_amount(comparison.estimated_amount, @calculation.currency)))
                  end %>
                  <%= suggested_move %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm leading-6 text-muted"><%= t("portfolio_plans.show.Estimate disclaimer") %></p>
      <% if @calculation.unallocated_amount.positive? %>
        <p class="mt-2 text-sm font-medium text-coffee"><%= t("portfolio_plans.show.Unallocated", amount: display_money(Money.from_amount(@calculation.unallocated_amount, @calculation.currency))) %></p>
      <% end %>
    <% elsif @calculation&.unconfigured? %>
      <div class="ui-empty-state mt-8" role="status"><p class="font-medium text-coffee"><%= t("portfolio_plans.show.Not configured") %></p><p class="mt-2 text-sm leading-6 text-muted"><%= t("portfolio_plans.show.Not configured explanation") %></p></div>
    <% elsif @calculation&.incomplete? %>
      <div class="mt-8 rounded-2xl border border-warning-border bg-warning-surface p-5 text-warning-text" role="status">
        <h3 class="font-semibold"><%= t("portfolio_plans.show.Data unavailable") %></h3>
        <p class="mt-1 text-sm leading-6"><%= t("portfolio_plans.show.Data unavailable explanation") %></p>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
          <% @calculation.issues.each do |issue| %>
            <li><%= t("portfolio_plans.show.Data issue", instrument: issue.instrument.ticker, reason: t("portfolio_plans.show.Data reasons.#{issue.kind}")) %></li>
          <% end %>
        </ul>
        <%= link_to t("portfolio_plans.show.Open data health"), market_data_health_path, class: "ui-button ui-button-secondary mt-4" %>
      </div>
    <% elsif @calculation&.empty? %>
      <div class="ui-empty-state mt-8" role="status"><p class="font-medium text-coffee"><%= t("portfolio_plans.show.No holdings") %></p><p class="mt-2 text-sm leading-6 text-muted"><%= t("portfolio_plans.show.No holdings explanation") %></p></div>
    <% end %>
  <% end %>
</section>
