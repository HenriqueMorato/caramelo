<%# locals: (group:, group_key:, asset_type_key:, position_results:, submitted: nil) %>

<% persisted = group.present? %>
<% submitted_attributes = submitted.to_h %>
<% submitted_members = submitted_attributes["members"] || submitted_attributes[:members] || {} %>
<% group_name = submitted_attributes["name"] || submitted_attributes[:name] || group&.name %>
<% group_target = submitted_attributes["target_percentage"] || submitted_attributes[:target_percentage] || group&.target_percentage&.to_s %>
<% group_target_label = group_target.present? ? "#{number_with_precision(group_target, precision: 2, strip_insignificant_zeros: true)}%" : t("portfolio_plans.show.No group target") %>
<% group_members = group&.members&.index_by(&:instrument_id) || {} %>
<% removed = persisted && ActiveModel::Type::Boolean.new.cast(submitted_attributes["remove"] || submitted_attributes[:remove]) %>
<% open_details = !persisted || (submitted.present? && !removed) %>
<% details_attributes = {
  id: "portfolio-allocation-group-#{group_key}",
  class: "group rounded-2xl border border-caramel/20 bg-caramel/5",
  data: {
    controller: "allocation-group",
    allocation_group_persisted_value: persisted,
    allocation_group_empty_name_value: t("portfolio_plans.show.New instrument group"),
    allocation_group_empty_target_value: t("portfolio_plans.show.No group target"),
    allocation_group_focus_on_connect_value: !persisted,
    allocation_group_remove_message_value: t("portfolio_plans.show.Delete group confirmation")
  },
  open: (true if open_details),
  hidden: removed
} %>

<%= tag.details(**details_attributes) do %>
  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 rounded-2xl px-4 py-3 transition-colors hover:bg-caramel/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel [&::-webkit-details-marker]:hidden" data-allocation-group-target="summary">
    <span class="min-w-0">
      <span class="block truncate font-semibold text-coffee" data-allocation-group-target="nameSummary"><%= group_name.presence || t("portfolio_plans.show.New instrument group") %></span>
      <span class="mt-1 block text-xs text-muted"><span data-allocation-group-target="targetSummary"><%= group_target_label %></span> <span aria-hidden="true">·</span> <%= AssetType.label_for(asset_type_key) %></span>
    </span>
    <span class="flex shrink-0 items-center gap-2 text-sm font-semibold text-caramel-deep">
      <span><%= t("portfolio_plans.show.Edit group") %></span>
      <span class="text-lg leading-none transition-transform group-open:rotate-180" aria-hidden="true">⌄</span>
    </span>
  </summary>

  <div class="border-t border-caramel/20 p-4" data-allocation-group-target="editor">
    <%= hidden_field_tag "portfolio_allocation[groups][#{group_key}][asset_type_key]", asset_type_key %>
    <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_10rem]">
      <div>
        <%= label_tag "portfolio_allocation_groups_#{group_key}_name", t("portfolio_plans.show.Group name"), class: "block text-sm font-semibold text-coffee" %>
        <%= text_field_tag "portfolio_allocation[groups][#{group_key}][name]", group_name, id: "portfolio_allocation_groups_#{group_key}_name", class: "ui-field mt-2", placeholder: t("portfolio_plans.show.Group name placeholder"), maxlength: 80, data: { allocation_group_target: "nameField", action: "input->allocation-group#updateSummary" } %>
      </div>
      <div>
        <%= label_tag "portfolio_allocation_groups_#{group_key}_target_percentage", t("portfolio_plans.show.Group target"), class: "block text-sm font-semibold text-coffee" %>
        <%= number_field_tag "portfolio_allocation[groups][#{group_key}][target_percentage]", group_target, id: "portfolio_allocation_groups_#{group_key}_target_percentage", min: 0, max: 100, step: 0.01, inputmode: "decimal", class: "ui-field mt-2 font-mono tabular-nums", placeholder: "100", data: { allocation_group_target: "targetField", action: "input->allocation-group#updateSummary" } %>
      </div>
    </div>
    <p class="mt-2 text-xs leading-5 text-muted"><%= t("portfolio_plans.show.Group target explanation", asset_type: AssetType.label_for(asset_type_key)) %></p>

    <div class="mt-4 space-y-2 border-t border-coffee/10 pt-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-muted"><%= t("portfolio_plans.show.Group members") %></p>
      <% position_results.each do |position_result| %>
        <% instrument = position_result.instrument %>
        <% submitted_member = submitted_members[instrument.id.to_s] || submitted_members[instrument.id] %>
        <% persisted_member = group_members[instrument.id] %>
        <% selected = if submitted.present?
          ActiveModel::Type::Boolean.new.cast(submitted_member&.fetch("selected", submitted_member&.fetch(:selected, false)))
        else
          persisted_member.present?
        end %>
        <% policy = submitted_member&.fetch("purchase_policy", submitted_member&.fetch(:purchase_policy, nil)) || persisted_member&.purchase_policy || "buy" %>
        <div class="flex flex-wrap items-center gap-3 rounded-xl border border-coffee/10 bg-paper/60 p-3">
          <%= hidden_field_tag "portfolio_allocation[groups][#{group_key}][members][#{instrument.id}][selected]", "0" %>
          <%= check_box_tag "portfolio_allocation[groups][#{group_key}][members][#{instrument.id}][selected]", "1", selected, id: "portfolio_allocation_groups_#{group_key}_members_#{instrument.id}_selected", class: "size-5 rounded border-coffee/30 text-caramel accent-caramel focus:ring-caramel" %>
          <%= label_tag "portfolio_allocation_groups_#{group_key}_members_#{instrument.id}_selected", class: "min-w-0 flex-1 cursor-pointer" do %>
            <span class="block truncate font-medium text-coffee"><%= instrument.ticker %></span>
            <span class="block truncate text-xs text-muted"><%= instrument.name %> · <%= instrument.exchange %></span>
          <% end %>
          <%= select_tag "portfolio_allocation[groups][#{group_key}][members][#{instrument.id}][purchase_policy]", options_for_select([[t("portfolio_plans.show.Buy in group"), "buy"], [t("portfolio_plans.show.Hold in group"), "hold"]], policy), id: "portfolio_allocation_groups_#{group_key}_members_#{instrument.id}_purchase_policy", class: "ui-field w-full sm:w-auto", aria: { label: t("portfolio_plans.show.Group policy", instrument: instrument.ticker) } %>
        </div>
      <% end %>
    </div>

    <% if persisted %>
      <%= hidden_field_tag "portfolio_allocation[groups][#{group_key}][remove]", (removed ? "1" : "0"), data: { allocation_group_target: "removeField" } %>
    <% end %>
    <div class="mt-5 flex justify-end border-t border-coffee/10 pt-4">
      <%= button_tag t("portfolio_plans.show.Delete group"), type: "submit", name: "portfolio_allocation[groups][#{group_key}][remove]", value: "1", class: "ui-button ui-button-secondary min-h-11 text-negative hover:bg-danger-surface hover:text-danger-text", data: { action: "click->allocation-group#remove" } %>
    </div>
  </div>
<% end %>
