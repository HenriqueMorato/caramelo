<%# locals: (status:, broadcast: false) %>

<%# i18n-tasks-use t("Market data updating") %>

<% unless broadcast %>
  <%= turbo_stream_from RefreshStatus::Broadcaster::STREAM_NAME %>
<% end %>

<div id="<%= RefreshStatus::Broadcaster::TARGET %>" class="<%= status.updating? || status.failed? ? "contents" : "hidden" %>" aria-live="polite">
  <% if status.updating? %>
    <p class="pointer-events-auto inline-flex w-full items-center gap-3 rounded-2xl border border-caramel/25 bg-oat-2/95 px-4 py-3 text-left text-xs font-semibold text-coffee shadow-[0_12px_30px_-14px_rgb(46_33_28_/_0.45)] backdrop-blur-sm motion-safe:animate-[toast-in_180ms_cubic-bezier(0.23,1,0.32,1)]" role="status">
      <span class="size-4 shrink-0 animate-spin rounded-full border-2 border-caramel/25 border-t-caramel" aria-hidden="true"></span>
      <%= t("Market data updating") %>
      <% if status.progress_label %><span class="text-muted">(<%= status.progress_label %>)</span><% end %>
    </p>
  <% elsif status.failed? %>
    <p class="pointer-events-auto inline-flex w-full items-center gap-3 rounded-2xl border border-guava/25 bg-oat-2/95 px-4 py-3 text-left text-xs font-semibold text-coffee shadow-[0_12px_30px_-14px_rgb(46_33_28_/_0.45)] backdrop-blur-sm motion-safe:animate-[toast-in_180ms_cubic-bezier(0.23,1,0.32,1)]" role="status">
      <span class="size-2 rounded-full bg-guava" aria-hidden="true"></span>
      <%= t("Market data needs attention") %>
    </p>
  <% elsif status.last_successful_refresh_at %>
    <p class="text-xs text-muted"><%= t("Market data updated at", time: l(status.last_successful_refresh_at, format: :short)) %></p>
  <% end %>
</div>
