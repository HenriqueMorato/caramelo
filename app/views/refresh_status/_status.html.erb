<%# locals: (status:, owner: nil, broadcast: false) %>

<%# i18n-tasks-use t("Market data updating") %>

<% unless broadcast %>
  <%= turbo_stream_from RefreshStatus::Broadcaster.stream_name(owner:) if owner %>
<% end %>

<div id="<%= RefreshStatus::Broadcaster::TARGET %>" aria-live="polite">
  <%= render "refresh_status/status_content", status:, broadcast: %>
</div>
