<%# locals: (market_price:, refreshing:, broadcast: false, compact: false) %>

<% current_market_price = market_price.current_market_price %>
<% if market_price.refreshable? && !broadcast %>
  <%= turbo_stream_from MarketPrice::Broadcaster::STREAM_NAME, market_price.instrument %>
<% end %>

<section id="<%= dom_id(market_price.instrument, :current_market_price) %>" class="inline-flex max-w-full min-w-0 items-center gap-2" aria-live="polite">
  <div class="min-w-0">
    <p class="truncate font-mono <%= compact ? "text-base" : "text-sm" %> font-semibold text-coffee">
      <% unless compact %><span class="sr-only"><%= t("Current price") %></span><% end %>
      <% if current_market_price %>
        <%= format_currency_amount current_market_price.unit_price, current_market_price.currency %>
      <% else %>
        <%= t("Price unavailable") %>
      <% end %>
    </p>
  </div>

  <% if refreshing %>
    <span class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-coffee" role="status">
      <span class="size-2 animate-pulse rounded-full bg-caramel" aria-hidden="true"></span>
      <%= t("Refreshing") %>
    </span>
  <% elsif market_price.stale? %>
    <span class="ui-badge ui-badge-stale shrink-0 px-2 py-0.5"><%= t("Stale") %></span>
  <% elsif market_price.fresh? %>
    <span class="shrink-0 text-xs font-semibold text-leaf"><%= t("Current") %></span>
  <% end %>

</section>
