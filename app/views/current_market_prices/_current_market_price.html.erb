<% current_market_price = market_price.current_market_price %>
<% if market_price.refreshable? && !local_assigns[:broadcast] %>
  <%= turbo_stream_from MarketPrice::Broadcaster::STREAM_NAME, market_price.instrument %>
<% end %>

<section id="<%= dom_id(market_price.instrument, :current_market_price) %>" class="min-w-48 rounded-xl bg-emerald-50 px-4 py-3 ring-1 ring-inset ring-emerald-100" aria-live="polite">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-[0.65rem] font-semibold uppercase tracking-[0.08em] text-emerald-800 sm:text-xs"><%= t("Current price") %></p>
      <% if current_market_price %>
        <p class="mt-1.5 font-mono text-base font-semibold text-slate-950"><%= format_currency_amount current_market_price.unit_price, current_market_price.currency %></p>
      <% else %>
        <p class="mt-1.5 text-sm font-semibold text-slate-700"><%= t("Price unavailable") %></p>
      <% end %>
    </div>

    <% if refreshing %>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-2 py-1 text-xs font-semibold text-emerald-800 shadow-sm" role="status">
        <span class="size-2 animate-pulse rounded-full bg-emerald-600" aria-hidden="true"></span>
        <%= t("Refreshing") %>
      </span>
    <% elsif market_price.stale? %>
      <span class="rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-800"><%= t("Stale") %></span>
    <% elsif market_price.fresh? %>
      <span class="rounded-full bg-white px-2 py-1 text-xs font-semibold text-emerald-800 shadow-sm"><%= t("Current") %></span>
    <% end %>
  </div>

  <div class="mt-2 flex items-end justify-between gap-3">
    <% if current_market_price %>
      <p class="text-xs text-slate-500"><%= t("Quoted at %{time}", time: l(current_market_price.quoted_at, format: :short)) %></p>
    <% else %>
      <span></span>
    <% end %>

    <% if market_price.refreshable? %>
      <%= button_to t("Refresh"), instrument_current_market_price_refresh_path(market_price.instrument), class: "text-xs font-semibold text-emerald-800 hover:text-emerald-950 disabled:text-slate-400", disabled: refreshing, form_class: "inline-flex", data: { turbo_submits_with: t("Refreshing") } %>
    <% end %>
  </div>
</section>
