<% content_for :title, t("account_setup.Page title") %>

<div class="mx-auto w-full max-w-lg">
  <p class="ui-eyebrow"><%= t("account_setup.Eyebrow") %></p>
  <h1 class="ui-page-title mt-3"><%= t("account_setup.Title") %></h1>
  <p class="ui-page-intro mt-3"><%= t("account_setup.Introduction", email: @owner.email_address) %></p>

  <%= form_with model: @owner, url: account_setup_path, method: :post, class: "mt-8 space-y-5" do |form| %>
    <% if @owner.errors.any? %>
      <div class="ui-form-errors" role="alert">
        <%= @owner.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :password, t("account_setup.Password label"), class: "block text-sm font-semibold text-coffee" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
        class: "ui-field mt-2", autofocus: true %>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t("account_setup.Password help") %></p>
    </div>

    <div>
      <%= form.label :password_confirmation, t("account_setup.Confirmation label"), class: "block text-sm font-semibold text-coffee" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
        class: "ui-field mt-2" %>
    </div>

    <%= form.submit t("account_setup.Save"), class: "ui-button ui-button-primary min-h-11 w-full cursor-pointer" %>
  <% end %>
</div>
