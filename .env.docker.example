# Everything in this file is optional. Copy it to .env.docker only when you
# want to override the defaults used by compose.yaml.

# Choose the single owner before the first container run.
CARAMELO_OWNER_EMAIL=admin@caramelo.local

# Use `single` for the configured owner only, or `multi` to allow each account
# to sign in and see only its own trades, income, positions, and performance.
# CARAMELO_ACCOUNT_MODE=single

# Use `public` for a local single-wallet app without a login, or `password` to
# require the first-run password and a login. Multi-account mode always requires
# password authentication.
# CARAMELO_AUTHENTICATION_MODE=public

# caramelo generates and stores a private application secret on first start.
# Set SECRET_KEY_BASE only when you need to supply your own stable value.
# SECRET_KEY_BASE=
